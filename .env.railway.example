# =============================================================================
# livdar-esim (livdar.com) — Railway Environment Variables
# Copy this to Railway → Variables and fill in real values.
# Never commit real secrets to git.
# =============================================================================

# --- Site identity -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://livdar.com
NEXT_PUBLIC_GTM_ID=...
NEXT_PUBLIC_CLARITY_ID=...
NEXT_PUBLIC_ALLOW_INDEXING=true  # Set to false on staging!

# --- eSIM provider -----------------------------------------------------------
LIVDAR_PROVIDER=...

# --- Atlas ISR (on-demand ISR for geographic content) ------------------------
ATLAS_ONDEMAND=1
ATLAS_ONDEMAND_SEED=25

# --- SEO: IndexNow -----------------------------------------------------------
INDEXNOW_KEY=...

# --- SEO: DataForSEO (Atlas content research) --------------------------------
DATAFORSEO_LOGIN=...
DATAFORSEO_PASSWORD=...  # NEVER log this
DATAFORSEO_COST_CAP_USD=...

# --- Notes -------------------------------------------------------------------
# livdar-esim has NO Vercel-specific SDK dependencies.
# No code changes required for Railway deployment.
#
# Atlas data (134 MB) is committed to the repository and rebuilt at build time
# via scripts/atlas/shard-manifests.mjs. The build command includes all
# Atlas prebuild steps (shard-manifests, fetch-media, quality-gate, etc.).
# fetch-media.mjs is non-fatal — if image CDN is unreachable, build continues.
#
# NEXT_PUBLIC_ALLOW_INDEXING must be false on staging (use Railway preview URL)
# and true only on production (livdar.com after DNS cutover).

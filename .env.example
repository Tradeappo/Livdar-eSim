# Canonical origin. Defaults to https://livdar.com when unset.
NEXT_PUBLIC_SITE_URL=https://livdar.com

# Optional evaluation-only automation. It cannot publish pages.
SEO_AUTOMATION_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Google APIs (Search Console, GA4 Data) authenticate through Workload Identity
# Federation only: GOOGLE_APPLICATION_CREDENTIALS points at an external_account
# file, written in CI by google-github-actions/auth. Service account keys are
# refused. Locally: gcloud iam workload-identity-pools create-cred-config ...
GOOGLE_APPLICATION_CREDENTIALS=
GSC_PROPERTY=
INDEXNOW_KEY=

# Google Tag Manager container. GA4 is loaded through GTM only.
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity project id.
NEXT_PUBLIC_CLARITY_ID=

# Set to false on preview deployments so they are not indexed.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Supplier id. stub returns no plans and refuses orders.
LIVDAR_PROVIDER=stub

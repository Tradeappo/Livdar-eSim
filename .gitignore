node_modules/
.next/
out/
build/
.vercel/
.env
.env.local
.env*.local
*.log
reports/gsc-*.json
npm-debug.log*
.DS_Store

# Images are fetched at build time from lib/media.js, which records where each
# one came from and under what licence. The binaries themselves are not history.
public/img/destinations/
public/img/regions/
public/img/CREDITS.json
public/img/incoming/*
!public/img/incoming/.gitkeep
public/img/shared/

# Written by google-github-actions/auth (Workload Identity Federation). Holds no
# key, but it must never be committed by the import pull request.
gha-creds-*.json

# Preflight output of scripts/gsc-check.mjs. A log, never an input, never committed.
gsc-check.json

# Captured page bodies from a production crawl. The crawl INDEX is committed, because it
# carries every status, timing and header the findings rest on; the HTML itself is a few
# megabytes per crawl, is reproducible by re-running the crawler, and is not evidence anyone
# reads by hand. Leaving it merely untracked, as the 2026-10-10 crawl did, makes every
# later `git status` noisy forever, so it is ignored by name instead.
data/atlas/measurements/*crawl*/pages/
data/atlas/measurements/*crawl*/sitemaps/
data/atlas/measurements/*crawl*/*.html.gz
data/atlas/measurements/*crawl*/*.hdr
data/atlas/measurements/*crawl*/*.meta.json

# Python bytecode.
__pycache__/

# Bulk generated data from the offline inventory work. None of it is an input: every one of
# these paths is rebuilt by a script in scripts/atlas/, and together they are about 1.5 GB,
# which is why the summary beside each one is committed and the bulk is not. The convention
# already in the repository is that the committed artefact is the underscore-prefixed index
# or provenance file, or a split .parts/ directory, so these rules name the bulk and leave
# those alone.
#
# They were simply left untracked before, which made `git status` list hundreds of paths on
# every run, and a repository that always looks dirty is a repository where nobody notices
# when something real is uncommitted.
data/atlas/candidates/*=*/
data/atlas/sources/climate/power/power-*.jsonl
data/atlas/sources/transport/gtfs/
data/atlas/sources/transport/gtfs-national/

# The unsplit originals of the two 1M manifests. The committed form is
# LIVDAR-1M-*-CANDIDATES.parts/ and LIVDAR-1M-CANDIDATE-MANIFEST.parts/, split because the
# whole files are too large for a single blob.
reports/livdar-expiry-freeze-2026-09-30/LIVDAR-1M-CANDIDATE-MANIFEST.csv.gz
reports/livdar-expiry-freeze-2026-09-30/LIVDAR-1M-CANDIDATE-MANIFEST.parquet
reports/livdar-expiry-freeze-2026-09-30/LIVDAR-1M-REJECTED-CANDIDATES.csv.gz

# Row-level dumps behind two universe reports. The reports themselves are committed.
reports/livdar-master-seo-universe-2026-09-30/_rows.json
reports/scale-universe-2026-09-29/_rows.jsonl.gz
reports/scale-universe-2026-09-29/_raw-count.json

# Per-group Atlas page shards, derived from data/atlas/cohorts/cohort-*-pages.json
# by scripts/atlas/shard-manifests.mjs (run in prebuild and pretest). Generated,
# not source: regenerated on every build, so not committed.
data/atlas/cohorts/by-group/

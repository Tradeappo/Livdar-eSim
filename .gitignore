node_modules/
.next/
out/
build/
.vercel/
.env
.env.local
.env*.local
*.log
reports/gsc-*.json
npm-debug.log*
.DS_Store

# Images are fetched at build time from lib/media.js, which records where each
# one came from and under what licence. The binaries themselves are not history.
public/img/destinations/
public/img/regions/
public/img/CREDITS.json
public/img/incoming/*
!public/img/incoming/.gitkeep
public/img/shared/

# Written by google-github-actions/auth (Workload Identity Federation). Holds no
# key, but it must never be committed by the import pull request.
gha-creds-*.json

# Preflight output of scripts/gsc-check.mjs. A log, never an input, never committed.
gsc-check.json

# Captured page bodies from a production crawl. The crawl INDEX is committed, because it
# carries every status, timing and header the findings rest on; the HTML itself is a few
# megabytes per crawl, is reproducible by re-running the crawler, and is not evidence anyone
# reads by hand. Leaving it merely untracked, as the 2026-10-10 crawl did, makes every
# later `git status` noisy forever, so it is ignored by name instead.
data/atlas/measurements/*crawl*/pages/
data/atlas/measurements/*crawl*/sitemaps/
data/atlas/measurements/*crawl*/*.html.gz
data/atlas/measurements/*crawl*/*.hdr
data/atlas/measurements/*crawl*/*.meta.json

# Python bytecode.
__pycache__/

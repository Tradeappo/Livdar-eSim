/* Buy in three steps - compact polished mini cards like reference */
#how{padding:18px 14px 8px!important}
#how .steps-modern-head{margin-bottom:10px!important;align-items:flex-end!important}
#how .steps-modern-head h2{font-size:26px!important;line-height:1!important;letter-spacing:-.045em!important;font-weight:900!important}
#how .steps-modern-head p{font-size:12px!important;margin-top:5px!important;color:#929aa7!important}

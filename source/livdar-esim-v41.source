  #how .step-modern-num{left:8px!important;top:8px!important;width:26px!important;height:26px!important;font-size:11px!important}
  #how .step-modern-visual{right:4px!important;top:4px!important;width:48px!important;height:48px!important;filter:drop-shadow(0 4px 8px rgba(36,52,74,.08))!important}
  #how .step-modern h4{left:8px!important;right:5px!important;bottom:31px!important;font-size:10.6px!important;line-height:1.02!important;max-width:82px!important}
  #how .step-modern p{left:8px!important;right:5px!important;bottom:8px!important;font-size:7.1px!important;line-height:1.18!important;max-width:90px!important}
}
</style>

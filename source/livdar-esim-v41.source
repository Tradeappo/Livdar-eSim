#travelToolsShowcase .travel-tool-tab .tab-icon{
  width:84px!important;height:72px!important;border-radius:0!important;background:transparent!important;border:0!important;box-shadow:none!important;
  display:grid!important;place-items:center!important;margin:0!important;padding:0!important;overflow:visible!important;
}
#travelToolsShowcase .travel-tool-tab .tab-icon::before{display:none!important;content:none!important}
#travelToolsShowcase .travel-tool-tab .tab-icon svg{width:66px!important;height:66px!important;stroke-width:2.7!important;filter:drop-shadow(0 7px 9px rgba(55,78,118,.10))!important}
#travelToolsShowcase .travel-tool-tab .tab-icon.cost svg{stroke:#4f7dff!important;color:#4f7dff!important}
#travelToolsShowcase .travel-tool-tab .tab-icon.advisor svg{stroke:#9650ff!important;color:#9650ff!important}
#travelToolsShowcase .travel-tool-tab .tab-icon.advice svg{stroke:#25c994!important;color:#25c994!important}
#travelToolsShowcase .travel-tool-tab .tab-icon.card svg{stroke:#ff735f!important;color:#ff735f!important}
#travelToolsShowcase .travel-tool-tab>span:last-child{font-size:12px!important;line-height:1.08!important;font-weight:820!important;max-width:110px!important;color:#181e27!important}

/* Main tool card stays clean under selector */
#travelToolsShowcase .inline-tool-panel{border-radius:22px!important;padding:16px!important;box-shadow:0 8px 22px rgba(25,39,59,.04)!important}
#travelToolsShowcase .inline-tool-title .inline-tool-icon{width:44px!important;height:44px!important;border-radius:13px!important}
#travelToolsShowcase .inline-tool-title .inline-tool-icon svg{width:24px!important;height:24px!important}

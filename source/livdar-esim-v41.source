<style id="v18-steps-polish">
/* V18 - rebuild Buy in three steps to match the compact reference */
#how.steps-modern{max-width:1060px!important;margin:0 auto!important;padding:20px 8px 8px!important}
#how .steps-modern-head{display:flex!important;align-items:flex-end!important;justify-content:space-between!important;gap:12px!important;margin:0 0 10px!important}
#how .steps-modern-head h2{margin:0!important;font-size:30px!important;line-height:.98!important;font-weight:950!important;letter-spacing:-.055em!important;color:#11161d!important}
#how .steps-modern-head p{margin:5px 0 0!important;font-size:14px!important;line-height:1.1!important;color:#919aa7!important}
#how .steps-modern-head a{font-size:13px!important;font-weight:850!important;color:#5e99ec!important;text-decoration:none!important;white-space:nowrap!important}
#how .steps-modern-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:10px!important;overflow:visible!important;padding:0!important}
#how .step-modern{position:relative!important;height:172px!important;min-height:172px!important;padding:14px!important;border-radius:20px!important;overflow:hidden!important;border:1px solid #dfe6ee!important;box-shadow:0 7px 18px rgba(26,39,58,.035)!important}
#how .step-modern.one{background:linear-gradient(145deg,#fff5f8 0%,#fffdfd 72%)!important}
#how .step-modern.two{background:linear-gradient(145deg,#f4f9ff 0%,#ffffff 72%)!important}
#how .step-modern.three{background:linear-gradient(145deg,#f4fff7 0%,#ffffff 72%)!important}
#how .step-modern::after{content:""!important;position:absolute!important;width:92px!important;height:92px!important;border-radius:50%!important;right:-26px!important;top:-30px!important;opacity:.48!important;filter:blur(1px)!important}
#how .step-modern.one::after{background:radial-gradient(circle,#ffdce4 0%,rgba(255,220,228,0) 72%)!important}
#how .step-modern.two::after{background:radial-gradient(circle,#d9e9ff 0%,rgba(217,233,255,0) 72%)!important}
#how .step-modern.three::after{background:radial-gradient(circle,#d9f7e1 0%,rgba(217,247,225,0) 72%)!important}
#how .step-modern-num{position:absolute!important;left:14px!important;top:14px!important;width:34px!important;height:34px!important;margin:0!important;border-radius:999px!important;display:grid!important;place-items:center!important;font-size:16px!important;font-weight:900!important;z-index:3!important}
#how .step-modern.one .step-modern-num{background:#ffd5df!important;color:#e14b72!important}
#how .step-modern.two .step-modern-num{background:#d9e8ff!important;color:#3370e7!important}
#how .step-modern.three .step-modern-num{background:#d5f6de!important;color:#16984e!important}
#how .step-modern-visual{position:absolute!important;right:12px!important;top:10px!important;width:76px!important;height:76px!important;z-index:2!important;opacity:1!important;filter:drop-shadow(0 8px 14px rgba(36,52,74,.10))!important}
#how .step-modern-visual svg{width:100%!important;height:100%!important;display:block!important}
#how .step-modern h4{position:absolute!important;left:14px!important;right:12px!important;bottom:43px!important;margin:0!important;font-size:18px!important;line-height:1.02!important;font-weight:900!important;letter-spacing:-.04em!important;color:#141922!important;max-width:160px!important}
#how .step-modern p{position:absolute!important;left:14px!important;right:12px!important;bottom:13px!important;margin:0!important;font-size:12px!important;line-height:1.25!important;color:#818b98!important;max-width:190px!important}

@media(max-width:768px){
  #how.steps-modern{padding:14px 6px 6px!important}
  #how .steps-modern-head{margin-bottom:7px!important;align-items:flex-end!important}
  #how .steps-modern-head h2{font-size:19px!important;letter-spacing:-.045em!important}
  #how .steps-modern-head p{font-size:9px!important;margin-top:3px!important}
  #how .steps-modern-head a{font-size:9px!important}
  #how .steps-modern-grid{gap:6px!important}

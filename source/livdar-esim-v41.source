  #how .step-modern-num{left:9px!important;top:9px!important;width:29px!important;height:29px!important;font-size:12px!important}
  #how .step-modern-visual{right:6px!important;top:7px!important;width:50px!important;height:50px!important;filter:drop-shadow(0 5px 9px rgba(34,50,73,.08))!important}

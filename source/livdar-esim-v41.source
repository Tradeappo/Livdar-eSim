<section class="wrap v22-steps" id="how">
<div class="v22-steps-head">
<div class="v22-steps-titlewrap">
<h2 data-i18n="buyThree">Buy in three steps</h2>
<p data-final-i18n="getOnlineMinutes">Get online abroad in minutes.</p>
</div>
<a class="v22-how-link" href="#how"><span data-i18n="navHow">How it works</span><span aria-hidden="true">›</span></a>
</div>
<div class="v22-step-grid">
<article class="v22-step v22-step-1">
<span class="v22-step-no">1</span>
<div aria-hidden="true" class="v22-step-art">
<svg role="img" viewbox="0 0 120 100">
<defs>
<lineargradient id="v22pinkPin" x1="0" x2="1" y1="0" y2="1">
<stop offset="0" stop-color="#ff889b"></stop><stop offset="1" stop-color="#ff5f79"></stop>
</lineargradient>
<lineargradient id="v22pinkMap" x1="0" x2="1" y1="0" y2="1">
<stop offset="0" stop-color="#ffe5ea"></stop><stop offset="1" stop-color="#ffc3ce"></stop>
</lineargradient>
<filter height="160%" id="v22shadow1" width="160%" x="-30%" y="-30%"><fedropshadow dx="0" dy="7" flood-color="#ff7187" flood-opacity=".20" stddeviation="6"></fedropshadow></filter>
</defs>

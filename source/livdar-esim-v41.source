#filterFab.filter-fab{width:38px !important;min-width:38px !important;height:38px !important;border-radius:14px !important}
#filterFab .filter-icon{width:18px !important;height:18px !important}

/* search box + scan control */
.search-zone .searchbox.app-searchbox,
.search-zone .searchbox{
  min-height:52px !important;
  height:52px !important;
  border-radius:22px !important;
  padding:0 7px 0 12px !important;
  gap:8px !important;
}
.search-zone .searchbox input,
.search-zone .app-searchbox input{
  height:50px !important;
  font-size:14px !important;
}
#searchBtn.app-search-btn,
#searchBtn.search-btn,
#searchBtn{
  width:34px !important;
  min-width:34px !important;
  height:34px !important;
  min-height:34px !important;
  border-radius:12px !important;
  background:#fff !important;
  border:1px solid #dfe5ec !important;
  box-shadow:none !important;
}
#searchBtn svg{width:18px !important;height:18px !important}

/* stronger travel tools background across mobile width */
#travelToolsShowcase .travel-showcase-shell{
  overflow:hidden !important;
  position:relative !important;
}
#travelToolsShowcase .travel-showcase-shell::before{
  content:"" !important;
  position:absolute !important;
  inset:0 0 auto 0 !important;
  height:176px !important;
  width:100% !important;
  border-radius:26px 26px 0 0 !important;
  background-image:linear-gradient(90deg, rgba(247,249,252,.96) 0%, rgba(247,249,252,.78) 34%, rgba(247,249,252,.18) 68%, rgba(247,249,252,.08) 100%), url("/mnt/data/livdar_travel_tools_banner.jpg") !important;
  background-repeat:no-repeat !important;
  background-size:cover !important;
  background-position:center center !important;
  opacity:1 !important;
}
#travelToolsShowcase .travel-showcase-shell::after{display:none !important}
#travelToolsShowcase .travel-showcase-hero{position:relative !important;z-index:2 !important;min-height:98px !important}

/* how it works bottom sheet */
.hiw-backdrop{position:fixed;inset:0;background:rgba(17,23,34,.34);backdrop-filter:blur(7px);display:none;z-index:240}
.hiw-sheet{position:fixed;left:50%;bottom:0;transform:translateX(-50%);width:min(680px,100%);background:linear-gradient(180deg,#fff,#f7f9fc);border:1px solid #e3e7ee;border-radius:28px 28px 0 0;padding:18px 16px 22px;box-shadow:0 -24px 70px rgba(15,23,42,.16);display:none;z-index:250}
.hiw-backdrop.open,.hiw-sheet.open{display:block}
.hiw-grab{width:46px;height:5px;border-radius:999px;background:#d2d8e2;margin:0 auto 14px}
.hiw-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:10px}
.hiw-head h3{margin:0;font-size:21px;line-height:1.05;letter-spacing:-.04em;color:#111722}
.hiw-head p{margin:5px 0 0;font-size:12px;color:#808a98}
.hiw-close{width:38px;height:38px;border-radius:14px;border:1px solid #e1e6ed;background:#fff;color:#1b2330;font-size:24px;line-height:1;display:grid;place-items:center}
.hiw-list{display:grid;gap:10px;margin-top:12px}
.hiw-item{display:grid;grid-template-columns:36px 1fr;gap:12px;padding:13px;border:1px solid #e6eaf1;border-radius:18px;background:rgba(255,255,255,.94)}
.hiw-no{width:36px;height:36px;border-radius:12px;display:grid;place-items:center;font-weight:900;font-size:15px}
.hiw-item:nth-child(1) .hiw-no{background:#ffe7ec;color:#ef5977}
.hiw-item:nth-child(2) .hiw-no{background:#e8f1ff;color:#4b82f6}
.hiw-item:nth-child(3) .hiw-no{background:#e8fbf1;color:#1ca66a}
.hiw-item h4{margin:0 0 3px;font-size:15px;color:#131a22}
.hiw-item p{margin:0;font-size:12px;color:#6f7887;line-height:1.4}
.hiw-actions{display:flex;gap:10px;margin-top:14px}
.hiw-actions button{flex:1;height:44px;border-radius:15px;border:0;font-weight:850;font-size:13px}
.hiw-primary{background:#111722;color:#fff}.hiw-secondary{background:#eef2f7;color:#263142}
@media (max-width:768px){
  #viewAll.products-viewall{height:32px !important;min-width:72px !important;padding:0 11px !important;font-size:11px !important}
  .sort-pill{min-width:142px !important;max-width:154px !important;height:32px !important;padding:0 10px !important;border-radius:12px !important}
  .sort-pill select{font-size:10.5px !important}
  #filterFab.filter-fab{width:32px !important;min-width:32px !important;height:32px !important;border-radius:12px !important}
  #filterFab .filter-icon{width:16px !important;height:16px !important}
  .search-zone .searchbox.app-searchbox,.search-zone .searchbox{min-height:48px !important;height:48px !important;border-radius:20px !important;padding:0 6px 0 11px !important}
  .search-zone .searchbox input,.search-zone .app-searchbox input{height:46px !important;font-size:13px !important}
  #searchBtn.app-search-btn,#searchBtn.search-btn,#searchBtn{width:30px !important;min-width:30px !important;height:30px !important;min-height:30px !important;border-radius:10px !important}
  #searchBtn svg{width:16px !important;height:16px !important}
  #travelToolsShowcase .travel-showcase-shell::before{height:168px !important;background-position:64% center !important;background-size:cover !important}
  #travelToolsShowcase .travel-showcase-hero{min-height:84px !important}
  .hiw-sheet{padding:16px 12px 18px;border-radius:24px 24px 0 0;max-height:86vh;overflow:auto}
  .hiw-head h3{font-size:19px}.hiw-head p,.hiw-item p{font-size:11px}.hiw-item h4{font-size:14px}.hiw-actions button{height:42px;font-size:12px}
}
</style>
<script id="v36-scan-viewall-howitworks-runtime">
(function(){
  function setTopViewAllBehavior(){
    var top=document.getElementById('viewAll');
    var bottom=document.getElementById('viewAllBottom');
    if(!top) return;
    top.onclick=function(e){
      e.preventDefault();
      if(bottom && typeof bottom.click==='function') bottom.click();
      else if(typeof window.render==='function'){ window.showAllPlans=true; window.render(); }
    };
  }
  function setScanIcon(){
    var btn=document.getElementById('searchBtn');
    if(!btn) return;
    btn.setAttribute('aria-label','Scan QR or barcode');
    btn.title='Scan QR or barcode';
    btn.innerHTML=''
      +'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.95" aria-hidden="true">'
      +'<path d="M8 3H6a3 3 0 0 0-3 3v2"/>'
      +'<path d="M16 3h2a3 3 0 0 1 3 3v2"/>'
      +'<path d="M8 21H6a3 3 0 0 1-3-3v-2"/>'
      +'<path d="M16 21h2a3 3 0 0 0 3-3v-2"/>'
      +'<rect x="9" y="9" width="6" height="6" rx="1.35"/>'
      +'</svg>';
  }
  function ensureFilterIcon(){
    var f=document.getElementById('filterFab');
    if(!f) return;
    var count=(document.getElementById('filterCount')||{}).textContent||'0';
    f.innerHTML=''
      +'<svg class="filter-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'
      +'<path d="M4 6h10"/><circle cx="17" cy="6" r="2"/>'
      +'<path d="M4 12h6"/><circle cx="13" cy="12" r="2"/>'
      +'<path d="M4 18h12"/><circle cx="19" cy="18" r="2"/>'
      +'</svg><b class="filter-count" id="filterCount">'+count+'</b>';
  }
  function buildHowSheet(){
    if(document.getElementById('hiwSheet')) return;
    var backdrop=document.createElement('div');
    backdrop.className='hiw-backdrop';
    backdrop.id='hiwBackdrop';
    var sheet=document.createElement('div');
    sheet.className='hiw-sheet';
    sheet.id='hiwSheet';
    sheet.innerHTML=''
      +'<div class="hiw-grab"></div>'
      +'<div class="hiw-head"><div><h3>How it works</h3><p>Buy your eSIM in three simple steps.</p></div><button class="hiw-close" id="hiwClose" type="button" aria-label="Close">×</button></div>'
      +'<div class="hiw-list">'
      +'<div class="hiw-item"><div class="hiw-no">1</div><div><h4>Choose a destination</h4><p>Search your country or region, or browse the cards until you find the destination you want.</p></div></div>'
      +'<div class="hiw-item"><div class="hiw-no">2</div><div><h4>Compare plans</h4><p>Check data, validity, network type and price. Use filters, sorting and travel tools to pick the best option.</p></div></div>'
      +'<div class="hiw-item"><div class="hiw-no">3</div><div><h4>Continue to checkout</h4><p>Tap View, review the package and continue to secure checkout. Your eSIM is delivered digitally in minutes.</p></div></div>'
      +'</div>'
      +'<div class="hiw-actions"><button class="hiw-secondary" id="hiwBrowse" type="button">Keep browsing</button><button class="hiw-primary" id="hiwGoPlans" type="button">View eSIM plans</button></div>';
    document.body.appendChild(backdrop);
    document.body.appendChild(sheet);
    function closeSheet(){backdrop.classList.remove('open');sheet.classList.remove('open');document.body.style.overflow='';}
    function openSheet(){backdrop.classList.add('open');sheet.classList.add('open');document.body.style.overflow='hidden';}
    backdrop.addEventListener('click',closeSheet);
    sheet.querySelector('#hiwClose').addEventListener('click',closeSheet);
    sheet.querySelector('#hiwBrowse').addEventListener('click',closeSheet);
    sheet.querySelector('#hiwGoPlans').addEventListener('click',function(){closeSheet(); document.getElementById('grid')?.scrollIntoView({behavior:'smooth', block:'start'});});
    document.querySelectorAll('.v22-how-link').forEach(function(link){
      link.addEventListener('click',function(e){e.preventDefault(); openSheet();});
    });
  }
  function init(){setTopViewAllBehavior();setScanIcon();ensureFilterIcon();buildHowSheet();}
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init); else init();
  setTimeout(init,120);
})();
</script>


<style id="v37-toolbar-travelbg-fix">
/* V37 - restore embedded Travel tools photo and align toolbar controls */
#travelToolsShowcase .travel-showcase-shell{
  position:relative !important;
  overflow:hidden !important;
  background:#f8faff !important;
}
#travelToolsShowcase .travel-showcase-shell::before{
  content:"" !important;
  display:block !important;
  position:absolute !important;
  left:0 !important;
  right:0 !important;
  top:0 !important;
  width:100% !important;
  height:190px !important;
  opacity:1 !important;
  background-image:
    linear-gradient(90deg,rgba(248,250,255,.98) 0%,rgba(248,250,255,.82) 30%,rgba(248,250,255,.34) 56%,rgba(248,250,255,.08) 100%),
    url("data:image/jpeg;base64,") !important;
  background-repeat:no-repeat !important;
  background-size:cover !important;
  background-position:center 44% !important;
  border-radius:26px 26px 0 0 !important;
  z-index:0 !important;
}
#travelToolsShowcase .travel-showcase-hero,
#travelToolsShowcase .travel-tool-tabs,
#travelToolsShowcase .inline-tool-panel{position:relative !important;z-index:2 !important}
#travelToolsShowcase .travel-showcase-hero{min-height:105px !important}

.products-toolbar{
  display:flex !important;
  align-items:center !important;
  justify-content:space-between !important;
  gap:10px !important;
  flex-wrap:nowrap !important;
}
.products-meta{flex:0 0 auto !important;min-width:0 !important}
.products-meta p{white-space:nowrap !important}
.products-actions{
  display:flex !important;
  align-items:center !important;
  justify-content:flex-end !important;
  gap:7px !important;
  flex-wrap:nowrap !important;
  width:auto !important;
  margin-left:auto !important;
}
#viewAll.products-viewall{
  display:inline-flex !important;
  height:34px !important;
  min-width:72px !important;
  padding:0 12px !important;
  border-radius:12px !important;
  font-size:11px !important;
  color:#202936 !important;
  border:1px solid #dce2ea !important;
  background:#fff !important;
  box-shadow:none !important;
}
.sort-pill{
  height:34px !important;
  min-width:148px !important;
  max-width:158px !important;
  padding:0 10px !important;
  border-radius:12px !important;
  gap:6px !important;
  box-shadow:none !important;
}
.sort-pill select{font-size:10.5px !important}
.sort-pill .sort-ico{width:15px !important;height:15px !important;flex:0 0 15px !important}
.sort-pill .field-chevron{width:12px !important;height:12px !important;flex:0 0 12px !important}
#filterFab.filter-fab{
  width:34px !important;
  min-width:34px !important;
  height:34px !important;
  border-radius:12px !important;
  padding:0 !important;
  box-shadow:none !important;
}
#filterFab .filter-icon{width:17px !important;height:17px !important}
#viewAllBottom.view-all-bottom{display:none !important}
.products-footer{display:none !important}

@media(max-width:768px){
  .products-toolbar{gap:6px !important;padding-left:0 !important;padding-right:0 !important}
  .products-meta p{font-size:12px !important}
  .products-actions{gap:5px !important}
  #viewAll.products-viewall{height:30px !important;min-width:58px !important;padding:0 9px !important;border-radius:10px !important;font-size:9.5px !important}
  .sort-pill{height:30px !important;min-width:124px !important;max-width:132px !important;padding:0 8px !important;border-radius:10px !important;gap:4px !important}
  .sort-pill select{font-size:9px !important}
  .sort-pill .sort-ico{width:13px !important;height:13px !important;flex-basis:13px !important}
  .sort-pill .field-chevron{width:10px !important;height:10px !important;flex-basis:10px !important}
  #filterFab.filter-fab{width:30px !important;min-width:30px !important;height:30px !important;border-radius:10px !important}
  #filterFab .filter-icon{width:15px !important;height:15px !important}
  #travelToolsShowcase .travel-showcase-shell::before{
    height:170px !important;
    background-size:cover !important;
    background-position:58% 42% !important;
  }
  #travelToolsShowcase .travel-showcase-hero{min-height:90px !important}
}
@media(max-width:420px){
  .products-meta p{font-size:10.5px !important}
  #viewAll.products-viewall{min-width:54px !important;padding:0 8px !important;font-size:9px !important}
  .sort-pill{min-width:116px !important;max-width:122px !important;padding:0 7px !important}
  .sort-pill select{font-size:8.6px !important}
  #filterFab.filter-fab{width:28px !important;min-width:28px !important;height:28px !important}
}
</style>


<style id="v41-real-frontend-fix">
/* FINAL OVERRIDES - placed last on purpose */

/* Desktop eSIM cards must be visibly smaller than before */
@media (min-width:901px){
  .products-section .grid{
    grid-template-columns:repeat(4,minmax(0,1fr))!important;
    gap:3px!important;
  }
  .products-section .card{
    aspect-ratio:.80!important;
    min-height:0!important;
    border-radius:0!important;
  }
}
@media (min-width:1450px){
  .products-section .grid{grid-template-columns:repeat(5,minmax(0,1fr))!important;}
}
@media (max-width:900px) and (min-width:701px){
  .products-section .grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:3px!important;}
}
@media (max-width:700px){
  .products-section .grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:2px!important;}
}

/* Bottom View all - required between eSIM cards and Travel tools */
.products-section .products-footer{
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  margin:18px 0 24px!important;
  min-height:42px!important;
}
#viewAllBottom.view-all-bottom{
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  min-width:116px!important;
  height:40px!important;
  padding:0 20px!important;
  border:1px solid #dce2ea!important;
  border-radius:999px!important;
  background:#fff!important;
  color:#1d2530!important;
  font-size:12px!important;
  font-weight:850!important;
  box-shadow:0 5px 16px rgba(24,38,58,.045)!important;
  cursor:pointer!important;
}
#viewAllBottom.view-all-bottom:hover{background:#f7f9fc!important;}
#viewAllBottom.view-all-bottom:active{transform:scale(.97)!important;background:#111722!important;color:#fff!important;}

/* Travel tools banner - show the whole useful composition, not a cropped sliver */
#travelToolsShowcase .travel-showcase-shell{
  position:relative!important;
  overflow:hidden!important;
  background:#f8faff!important;
  border-radius:24px!important;
}
#travelToolsShowcase .travel-showcase-shell::before{
  content:""!important;
  display:block!important;
  position:absolute!important;
  inset:0 0 auto 0!important;
  width:100%!important;
  height:210px!important;
  background-image:
    linear-gradient(90deg,rgba(248,250,255,.97) 0%,rgba(248,250,255,.83) 27%,rgba(248,250,255,.36) 54%,rgba(248,250,255,.05) 100%),
    url("data:image/jpeg;base64,")!important;
  background-repeat:no-repeat!important;
  background-size:100% 100%, 100% auto!important;
  background-position:center top, center top!important;
  opacity:1!important;
  z-index:0!important;
  pointer-events:none!important;
}
#travelToolsShowcase .travel-showcase-shell::after{
  content:""!important;
  display:block!important;
  position:absolute!important;
  left:0!important;
  right:0!important;
  top:150px!important;
  height:82px!important;
  background:linear-gradient(180deg,rgba(248,250,255,0),#f8faff 86%)!important;
  z-index:0!important;
  pointer-events:none!important;
}
#travelToolsShowcase .travel-showcase-hero,
#travelToolsShowcase .travel-tool-tabs,
#travelToolsShowcase .inline-tool-panel{position:relative!important;z-index:2!important;}
#travelToolsShowcase .travel-showcase-hero{min-height:118px!important;}
#travelToolsShowcase .travel-tool-tabs{margin-top:0!important;}

@media(max-width:700px){
  .products-section .products-footer{margin:14px 0 18px!important;min-height:38px!important;}
  #viewAllBottom.view-all-bottom{min-width:96px!important;height:34px!important;padding:0 16px!important;font-size:10.5px!important;}
  #travelToolsShowcase .travel-showcase-shell::before{
    height:172px!important;
    background-size:100% 100%, 100% auto!important;
    background-position:center top, center top!important;
  }
  #travelToolsShowcase .travel-showcase-shell::after{top:120px!important;height:66px!important;}
  #travelToolsShowcase .travel-showcase-hero{min-height:96px!important;}
}
</style>
<script id="v41-real-frontend-runtime">
(function(){
  function wireBottomViewAll(){
    var btn=document.getElementById('viewAllBottom');
    if(!btn) return;
    btn.style.display='inline-flex';
    btn.onclick=function(e){
      e.preventDefault();
      window.showAllPlans=true;
      if(typeof window.render==='function') window.render();
      setTimeout(function(){
        var grid=document.getElementById('grid');
        if(grid) grid.scrollIntoView({behavior:'smooth',block:'start'});
      },30);
    };
  }
  function keepBottomViewAllVisible(){
    var footer=document.querySelector('.products-section .products-footer');
    var btn=document.getElementById('viewAllBottom');
    if(footer) footer.style.display='flex';
    if(btn) btn.style.display='inline-flex';
  }
  function init(){wireBottomViewAll();keepBottomViewAllVisible();}
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init); else init();
  window.addEventListener('load',init);
  setInterval(keepBottomViewAllVisible,1200);
})();
</script>

</html>

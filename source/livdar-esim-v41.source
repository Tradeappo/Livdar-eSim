ציב","dataLabel":"נתוני eSIM"},"hr":{"toolsTitle":"Alati za putovanje","toolsSub":"Planiraj budžet, podatke i podijeli putovanje.","costTitle":"Kalkulator troškova putovanja","costDesc":"Procijeni budžet putovanja u nekoliko sekundi.","advisorTitle":"eSIM savjetnik","advisorDesc":"Pronađi odgovarajuću količinu podataka.","adviceTitle":"Savjeti za putovanje","adviceDesc":"Korisne provjere prije dolaska.","cardTitle":"Generator kartice putovanja","cardDesc":"Izradi karticu putovanja za dijeljenje.","destinationLabel":"Odredište","daysLabel":"Dani","accommodationLabel":"Smještaj / dan","foodLabel":"Hrana / dan","transportLabel":"Prijevoz / dan","esimLabel":"eSIM","calculate":"Izračunaj","estimatedBudget":"Procijenjeni budžet","usageLabel":"Korištenje","lightUsage":"Lagano","mediumUsage":"Srednje","heavyUsage":"Intenzivno","hotspotLabel":"Koristim hotspot","fiveGLabel":"Preferiraj 5G","recommend":"Preporuči","recommendationTitle":"Preporučeni plan","showAdvice":"Prikaži savjete","internetTip":"Internet","roamingTip":"Roaming","transportTip":"Prijevoz","moneyTip":"Novac","powerTip":"Struja","safetyTip":"Sigurnost","appsTip":"Korisne aplikacije","generateCard":"Izradi karticu","downloadCard":"Preuzmi PNG","budgetLabel":"Budžet","dataLabel":"eSIM podaci"},"bg":{"toolsTitle":"Инструменти за пътуване","toolsSub":"Планирайте бюджет, данни и споделете пътуването.","costTitle":"Калкулатор за разходи","costDesc":"Оценете бюджета за пътуване за секунди.","advisorTitle":"eSIM съветник","advisorDesc":"Намерете правилния обем данни.","adviceTitle":"Съвети за пътуване","adviceDesc":"Полезни проверки преди пристигане.","cardTitle":"Генератор на карта за пътуване","cardDesc":"Създайте карта за пътуване за споделяне.","destinationLabel":"Дестинация","daysLabel":"Дни","accommodationLabel":"Настаняване / ден","foodLabel":"Храна / ден","transportLabel":"Транспорт / ден","esimLabel":"eSIM","calculate":"Изчисли","estimatedBudget":"Прогнозен бюджет","usageLabel":"Използване","lightUsage":"Леко","mediumUsage":"Средно","heavyUsage":"Интензивно","hotspotLabel":"Използвам hotspot","fiveGLabel":"Предпочитай 5G","recommend":"Препоръчай","recommendationTitle":"Препоръчан план","showAdvice":"Покажи съветите","internetTip":"Интернет","roamingTip":"Роуминг","transportTip":"Транспорт","moneyTip":"Пари","powerTip":"Ток","safetyTip":"Безопасност","appsTip":"Полезни приложения","generateCard":"Създай карта","downloadCard":"Изтегли PNG","budgetLabel":"Бюджет","dataLabel":"eSIM данни"}};
Object.entries(I18N).forEach(([code,obj])=>Object.assign(obj,TOOL_I18N[code]||TOOL_I18N.en));
let currentLang=(function(){try{return localStorage.getItem("livdarLang")||"en"}catch(e){return "en"}})();
if(!I18N[currentLang]) currentLang="en";
function t(key){return (I18N[currentLang]&&I18N[currentLang][key])||I18N.en[key]||key}
const VIEW_LABELS={
  en:"View",de:"Ansehen",ro:"Vezi",fr:"Voir",es:"Ver",it:"Vedi",pt:"Ver",
  nl:"Bekijk",pl:"Zobacz",ja:"見る",zh:"查看",tr:"Gör",ko:"보기",ar:"عرض",th:"ดู",
  cs:"Zobrazit",hu:"Megnéz",sv:"Visa",da:"Se",fi:"Näytä",no:"Vis",uk:"Переглянути",ru:"Смотреть",
  hi:"देखें",id:"Lihat",ms:"Lihat",vi:"Xem",he:"הצג",hr:"Pogledaj",bg:"Виж"
};
function viewLabel(){return VIEW_LABELS[currentLang]||VIEW_LABELS.en}
function localizeDataLabel(value){return value==="Unlimited"?t("unlimited"):value}
function localizeValidity(value){
  const m=String(value||"").match(/^(\d+)\s+days?$/i);
  if(!m)return value;
  const n=Number(m[1]);
  return `${n} ${n===1?t("dayOne"):t("dayMany")}`;
}
function buildLanguageMenu(){
  langMenu.innerHTML="";
  Object.entries(I18N).forEach(([code,lang])=>{
    const b=document.createElement("button");
    b.className="lang-option"+(code===currentLang?" active":"");
    b.type="button";
    b.dataset.lang=code;
    b.innerHTML=`<span class="lang-left"><span class="lang-flag">${lang.flag}</span><span class="lang-meta"><span class="lang-name">${lang.name}</span><span class="lang-native">${lang.native}</span></span></span><span class="lang-code">${code.toUpperCase()}</span>`;
    b.onclick=()=>setLanguage(code);
    langMenu.appendChild(b);
  });
}
function setLanguage(code){
  if(!I18N[code])return;
  const from=currentLang;
  currentLang=code;
  try{localStorage.setItem("livdarLang",code)}catch(e){}
  document.documentElement.lang=code==="zh"?"zh-Hant":code;
  document.documentElement.dir=I18N[code].dir||"ltr";
  langButton.textContent=I18N[code].flag+" ▾";
  document.querySelectorAll("[data-i18n]").forEach(el=>{el.textContent=t(el.dataset.i18n)});
  document.querySelectorAll("[data-i18n-placeholder]").forEach(el=>{el.placeholder=t(el.dataset.i18nPlaceholder)});
  document.querySelectorAll(".lang-option").forEach(el=>el.classList.toggle("active",el.dataset.lang===code));
  langMenu.classList.remove("open");langButton.setAttribute("aria-expanded","false");
  updateDynamicTranslations();
  renderDestinations();
  render();
  if(selected&&overlay.classList.contains("open")){
    dData.textContent=localizeDataLabel(selected.data);
    dDays.textContent=localizeValidity(selected.days);
  }
  if(from!==code)track("language_change",{from_language:from,to_language:code});
}
function updateDynamicTranslations(){
  const modalTitle=document.querySelector(".modalbox h3");
  const modalText=document.querySelector(".modalbox p");
  if(modalTitle)modalTitle.textContent=t("notAvailable");
  if(modalText)modalText.textContent=t("notifyText");
  const notifyBtn=document.querySelector(".mail button");
  if(notifyBtn)notifyBtn.textContent=t("notifyMe");
  const modalClose=document.querySelector(".modalbox > button");
  if(modalClose)modalClose.textContent=t("close");
  const browseBtn=document.querySelector(".buybar .secondary");
  if(browseBtn)browseBtn.textContent=t("keepBrowsing");
  const buyBtn=document.querySelector(".buybar .buy");
  if(buyBtn)buyBtn.textContent=t("buyEsim");
}
langButton.onclick=()=>{const open=langMenu.classList.toggle("open");langButton.setAttribute("aria-expanded",String(open))};
document.addEventListener("click",e=>{if(!e.target.closest(".lang-wrap")){langMenu.classList.remove("open");langButton.setAttribute("aria-expanded","false")}});
buildLanguageMenu();

window.dataLayer=window.dataLayer||[];
let selected=null,providerFilter="holafly",catFilter="all",query="";
function track(event,params={}){window.dataLayer.push({event,language:currentLang,content_cluster:"shop_prototype",...params})}
function pnum(p){return parseFloat(p.price.replace("€",""))}
function catOK(p){
 if(catFilter==="under10")return pnum(p)<10;
 if(catFilter==="10gb")return /10|15|20|Unlimited/.test(p.data);
 if(catFilter==="30days")return p.days==="30 days";
 if(catFilter==="unlimited")return p.data==="Unlimited";
 if(catFilter==="5g")return p.network.includes("5G");
 if(catFilter==="europe")return regionMap.europe.includes(p.name);
 if(catFilter==="asia")return regionMap.asia.includes(p.name);
 if(catFilter==="americas")return regionMap.americas.includes(p.name);
 return true;
}
function badge(i){return [t("bestValue"),t("popular"),t("largeData"),t("travellerPick"),t("premium"),t("topPick")][i%6]}
function render(){
 let arr=plans.filter(p=>(!query||p.name.toLowerCase().includes(query.toLowerCase()))&&(providerFilter==="all"||p.providerKey===providerFilter)&&catOK(p));
 grid.innerHTML="";
 arr.forEach((p,i)=>{
   const el=document.createElement("article");el.className="card";
   el.innerHTML=`<img src="${p.img}" alt="${p.name}">
   <div class="top"><span class="badge">${badge(i)}</span><span class="flag">${p.flag}</span></div>
   <div class="bottom">
    <div class="provline"><span class="pdot" style="background:linear-gradient(145deg,${p.c1},${p.c2});--glow:${p.c1}66">${p.provider[0]}</span>${p.provider}</div>
    <div class="row">
      <h3>${p.name} eSIM</h3>
      <div class="price-stack">
        <div class="price">${p.price}</div>
        <button class="card-view" type="button">${viewLabel()}</button>
      </div>
    </div>
    <div class="meta"><span>${localizeDataLabel(p.data)}</span><span>${localizeValidity(p.days)}</span><span>${p.network}</span></div>
   </div>`;
   el.onclick=()=>openPlan(p);
   const viewBtn=el.querySelector(".card-view");
   if(viewBtn) viewBtn.onclick=(e)=>{e.stopPropagation();openPlan(p)};
   grid.appendChild(el);
 });
 empty.style.display=arr.length?"none":"block";
 gridTitle.textContent=query?`${t("resultsFor")} "${query}"`:t("popularEsims");
 gridSub.textContent=`${arr.length} ${t("plansShown")}`;
}
function openPlan(p){selected=p;dImg.src=p.img;dTitle.textContent=p.flag+" "+p.name+" eSIM";dProvider.textContent=p.provider;dData.textContent=localizeDataLabel(p.data);dDays.textContent=localizeValidity(p.days);dNet.textContent=p.network;dPrice.textContent=p.price;overlay.classList.add("open");document.body.style.overflow="hidden";track("view_plan",{destination:p.name.toLowerCase().replace(/\s+/g,"-"),provider:p.provider,plan_data:p.data,plan_validity:p.days,plan_price:p.price})}
function closePlan(){overlay.classList.remove("open");document.body.style.overflow=""}
function buyNow(){if(!selected)return;const x={destination:selected.name.toLowerCase().replace(/\s+/g,"-"),provider:selected.provider,plan_data:selected.data,plan_validity:selected.days,plan_price:selected.price};track("select_plan",x);track("begin_checkout",x);track("checkout_intent",x);overlay.classList.remove("open");modal.classList.add("open")}
function closeModal(){modal.classList.remove("open");document.body.style.overflow=""}
function notifyMe(){const e=email.value.trim();track("notify_signup",{destination:selected?selected.name.toLowerCase().replace(/\s+/g,"-"):"",has_email:!!e});alert(e?"Thanks. You're on the list.":"Enter an email address first.")}
function resetShopFiltersForDestinationSearch(){
  providerFilter="all";
  catFilter="all";
  document.querySelectorAll(".story").forEach(x=>x.classList.toggle("active",x.dataset.provider==="all"));
  document.querySelectorAll(".cat").forEach(x=>x.classList.toggle("active",x.dataset.cat==="all"));
}
searchBtn.onclick=()=>{
  query=searchInput.value.trim();
  resetShopFiltersForDestinationSearch();
  track("search",{search_term:query});
  render();
  grid.scrollIntoView({behavior:"smooth",block:"start"});
};
searchInput.addEventListener("keydown",e=>{if(e.key==="Enter")searchBtn.click()});
document.querySelectorAll(".story").forEach(s=>s.onclick=()=>{document.querySelectorAll(".story").forEach(x=>x.classList.remove("active"));s.classList.add("active");providerFilter=s.dataset.provider;render()});
document.querySelectorAll(".cat").forEach(c=>c.onclick=()=>{document.querySelectorAll(".cat").forEach(x=>x.classList.remove("active"));c.classList.add("active");catFilter=c.dataset.cat;render()});
document.querySelectorAll("#mainNav a").forEach(a=>a.onclick=()=>{document.querySelectorAll("#mainNav a").forEach(x=>x.classList.remove("active"));a.classList.add("active")});
viewAll.onclick=e=>{e.preventDefault();query="";providerFilter="all";catFilter="all";searchInput.value="";document.querySelectorAll(".story").forEach(x=>x.classList.toggle("active",x.dataset.provider==="all"));document.querySelectorAll(".cat").forEach(x=>x.classList.toggle("active",x.dataset.cat==="all"));render()};
function renderDestinations(){
  if(!destGrid)return;
  destGrid.innerHTML="";
  plans.forEach(p=>{
    const a=document.createElement("a");
    a.className="collection";
    a.href="#shop";
    a.innerHTML=`<span class="flag-chip">${p.flag}</span><span class="dest-copy"><span class="dest-name">${p.name}</span><span class="dest-sub" data-i18n="viewEsims">${t("viewEsims")}</span></span>`;
    a.onclick=()=>{
      searchInput.value=p.name;
      query=p.name;
      resetShopFiltersForDestinationSearch();
      render();
    };
    destGrid.appendChild(a);
  });
}
overlay.onclick=e=>{if(e.target===overlay)closePlan()};modal.onclick=e=>{if(e.target===modal)closeModal()};
setLanguage(currentLang);
render();
const storiesEl=document.getElementById("stories");
if(storiesEl){storiesEl.scrollLeft=0;requestAnimationFrame(()=>storiesEl.scrollLeft=0);}

// Travel tools
function openTravelTool(name){
  document.querySelectorAll('.tool-card').forEach(x=>x.classList.toggle('active',x.dataset.tool===name));
  document.querySelectorAll('.tool-panel').forEach(x=>x.classList.toggle('active',x.id==='tool-'+name));
  const backdrop=document.getElementById('toolBackdrop');
  if(backdrop) backdrop.classList.add('open');
  document.body.style.overflow='hidden';
  if(name==='card') drawTravelCard();
  if(name==='advice' && !document.getElementById('adviceGrid').children.length) renderTravelAdvice();
}
function closeTravelTool(){
  document.querySelectorAll('.tool-card').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('.tool-panel').forEach(x=>x.classList.remove('active'));
  const backdrop=document.getElementById('toolBackdrop');
  if(backdrop) backdrop.classList.remove('open');
  document.body.style.overflow='';
}
document.querySelectorAll('.tool-card').forEach(btn=>btn.addEventListener('click',()=>openTravelTool(btn.dataset.tool)));
function num(id){const n=parseFloat(document.getElementById(id).value);return Number.isFinite(n)?n:0}
function calculateTravelCost(){
  const days=Math.max(1,num('costDays'));
  const total=days*(num('costStay')+num('costFood')+num('costTransport'))+num('costEsim');
  const d=document.getElementById('costDestination').value.trim();
  const currencyEl=document.getElementById('costCurrency');
  const currency=currencyEl?currencyEl.value:'EUR';
  const symbol={EUR:'€',USD:'$',GBP:'£'}[currency]||'€';
  const el=document.getElementById('costResult');
  el.innerHTML=`${t('estimatedBudget')}${d?' - '+escapeHtml(d):''}<strong>${symbol}${total.toLocaleString(undefined,{maximumFractionDigits:0})}</strong>`;
  el.classList.add('show');
}
function recommendEsim(){
  const days=Math.max(1,num('advisorDays'));
  const usage=document.getElementById('advisorUsage').value;
  let perDay={light:.3,medium:.8,heavy:1.8}[usage]||.8;
  if(document.getElementById('advisorHotspot').checked) perDay*=1.45;
  let need=perDay*days;
  const tiers=[1,3,5,10,20,50];
  let data=tiers.find(x=>x>=need);
  const label=data?`${data} GB`:'Unlimited';
  const five=document.getElementById('advisor5g').checked?'5G':'4G/5G';
  const el=document.getElementById('advisorResult');
  el.innerHTML=`${t('recommendationTitle')}<strong>${label} · ${days} ${t(days===1?'dayOne':'dayMany')} · ${five}</strong>`;
  el.classList.add('show');
}
function renderTravelAdvice(){
  const dest=(document.getElementById('adviceDestination').value||'your destination').trim();
  const items=[
    ['internetTip',`${dest}: compare local 4G/5G coverage and activate the eSIM before you need data.`],
    ['roamingTip',`Check your home operator's roaming rates before departure and disable roaming on the primary SIM if needed.`],
    ['transportTip',`Save offline maps and check the main local transit or ride-hailing app before arrival.`],
    ['moneyTip',`Keep a backup payment method and some local cash for places that do not accept cards.`],
    ['powerTip',`Check the plug type and voltage used in ${dest} before packing an adapter.`],
    ['safetyTip',`Review current official travel advisories and keep copies of key documents.`],
    ['appsTip',`Maps, Translate, your airline app and a local transport app are a useful baseline.`]
  ];
  const g=document.getElementById('adviceGrid');
  g.innerHTML=items.map(([k,v])=>`<div class="advice-item"><b>${t(k)}</b><span>${escapeHtml(v)}</span></div>`).join('');
}
function drawTravelCard(){
  const c=document.getElementById('travelCardCanvas'); if(!c)return; const ctx=c.getContext('2d');
  const dest=(document.getElementById('cardDestination').value||'Japan').trim();
  const days=Math.max(1,num('cardDays')); const budget=num('cardBudget'); const data=(document.getElementById('cardData').value||'10 GB').trim();
  const grad=ctx.createLinearGradient(0,0,c.width,c.height);grad.addColorStop(0,'#10131a');grad.addColorStop(.55,'#29394a');grad.addColorStop(1,'#586c78');ctx.fillStyle=grad;ctx.fillRect(0,0,c.width,c.height);
  ctx.fillStyle='rgba(255,255,255,.09)';ctx.beginPath();ctx.arc(1050,120,280,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#fff';ctx.font='700 48px Arial';ctx.fillText('Livdar',70,90);ctx.font='700 84px Arial';wrapCanvasText(ctx,dest,70,250,1060,94);
  ctx.font='500 34px Arial';ctx.fillStyle='rgba(255,255,255,.78)';ctx.fillText(`${days} ${t(days===1?'dayOne':'dayMany')}  ·  €${budget.toLocaleString()}  ·  ${data} eSIM`,70,640);
  ctx.font='500 27px Arial';ctx.fillStyle='rgba(255,255,255,.58)';ctx.fillText('livdar.com',70,720);
}
function wrapCanvasText(ctx,text,x,y,maxWidth,lineHeight){const words=text.split(' ');let line='';for(let n=0;n<words.length;n++){const test=line+words[n]+' ';if(ctx.measureText(test).width>maxWidth&&n>0){ctx.fillText(line,x,y);line=words[n]+' ';y+=lineHeight}else line=test}ctx.fillText(line,x,y)}
function downloadTravelCard(){drawTravelCard();const c=document.getElementById('travelCardCanvas');const a=document.createElement('a');a.download='livdar-trip-card.png';a.href=c.toDataURL('image/png');a.click()}
function escapeHtml(s){return String(s).replace(/[&<>'"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[ch]))}
function refreshTravelTools(){
  if(document.getElementById('costResult')?.classList.contains('show')) calculateTravelCost();
  if(document.getElementById('advisorResult')?.classList.contains('show')) recommendEsim();
  if(document.getElementById('adviceGrid')?.children.length) renderTravelAdvice();
  drawTravelCard();
}
['cardDestination','cardDays','cardBudget','cardData'].forEach(id=>document.getElementById(id)?.addEventListener('input',drawTravelCard));
setTimeout(()=>{drawTravelCard();renderTravelAdvice()},0);

</script>
<div class="filter-backdrop" id="filterBackdrop"></div>
<div aria-hidden="true" class="filter-sheet" id="filterSheet">
<button class="sheet-close" id="filterClose" type="button">×</button>
<div class="sheet-handle"></div>
<h3 data-final-i18n="filters">Filters</h3>
<p class="sheet-sub" data-final-i18n="filtersSub">Narrow plans by provider, region, data, duration and network.</p>
<div class="provider-multi-block">
<span class="filter-label" data-final-i18n="provider">Provider</span>
<select hidden="" id="filterProvider"><option value="all">All</option></select>
<div class="provider-multi" id="filterProviders">
<label><input type="checkbox" value="holafly"/><span>Holafly</span></label>
<label><input type="checkbox" value="maya"/><span>Maya</span></label>
<label><input type="checkbox" value="airalo"/><span>Airalo</span></label>
<label><input type="checkbox" value="saily"/><span>Saily</span></label>
<label><input type="checkbox" value="nomad"/><span>Nomad</span></label>
</div>
</div>
<div class="sheet-grid">
<label class="sheet-field"><span data-final-i18n="region">Region</span><select id="filterRegion"><option data-final-i18n="allRegions" value="all">All regions</option><option value="europe">Europe</option><option value="asia">Asia</option><option value="americas">Americas</option></select></label>
<label class="sheet-field"><span data-final-i18n="price">Price</span><select id="filterPrice"><option data-final-i18n="anyPrice" value="all">Any price</option><option value="10">Under €10</option><option value="20">Under €20</option><option value="30">Under €30</option></select></label>
<label class="sheet-field"><span data-final-i18n="minimumData">Minimum data</span><select id="filterData"><option data-final-i18n="anyData" value="all">Any data</option><option value="5">5+ GB</option><option value="10">10+ GB</option><option value="20">20+ GB</option><option data-i18n="unlimited" value="999">Unlimited</option></select></label>
<label class="sheet-field"><span data-final-i18n="validity">Validity</span><select id="filterDays"><option data-final-i18n="anyDuration" value="all">Any duration</option><option value="7">7+ days</option><option value="15">15+ days</option><option value="30">30+ days</option></select></label>
<label class="sheet-field"><span data-final-i18n="network">Network</span><select id="filterNetwork"><option data-final-i18n="anyNetwork" value="all">Any network</option><option value="4G">4G</option><option value="5G">5G</option></select></label>
</div>
<div class="filter-toggle-grid">
<label class="filter-toggle"><span><strong data-final-i18n="unlimitedOnly">Unlimited only</strong><small data-final-i18n="unlimitedOnlySub">Show plans with unlimited data.</small></span><span class="switch"><input id="filterUnlimited" type="checkbox"/><i></i></span></label>
<label class="filter-toggle"><span><strong data-final-i18n="fiveGOnly">5G only</strong><small data-final-i18n="fiveGOnlySub">Show plans that include 5G.</small></span><span class="switch"><input id="filter5G" type="checkbox"/><i></i></span></label>
</div>
<div class="sheet-actions"><button class="inline-secondary-btn" data-final-i18n="reset" id="filterReset" type="button">Reset</button><button class="inline-primary-btn" data-final-i18n="applyFilters" id="filterApply" type="button">Apply filters</button></div>
</div>
<div class="scanner-backdrop" id="scannerBackdrop"></div>
<div aria-hidden="true" class="scanner-sheet" id="scannerSheet">
<button class="sheet-close" id="scannerClose" type="button">×</button>
<div class="sheet-handle"></div>
<h3 data-final-i18n="scanCode">Scan a code</h3>
<p data-final-i18n="scanDesc">Scan a QR code or barcode, upload an image, or paste a code.</p>
<div class="scanner-stage">
<video autoplay="" id="scannerVideo" muted="" playsinline=""></video>
<canvas hidden="" id="scannerCanvas"></canvas>
<div class="scanner-frame"><i></i><i></i><i></i><i></i><span></span></div>
</div>
<div class="scanner-status" data-final-i18n="scannerIdle" id="scannerStatus">Ready to scan.</div>
<div class="scanner-manual"><input data-final-placeholder="pasteCode" id="scannerManual" placeholder="Paste code, URL or destination"/><button data-final-i18n="search" id="scannerManualGo" type="button">Search</button></div>
<div class="sheet-actions">
<button class="inline-secondary-btn" data-final-i18n="startCamera" id="scannerStart" type="button">Start camera</button>
<label class="inline-primary-btn upload-cta"><span data-final-i18n="uploadImage">Upload image</span><input accept="image/*" capture="environment" hidden="" id="scannerFile" type="file"/></label>
</div>
</div>

<div class="mail"><input id="email" placeholder="you@example.com"/><button data-i18n="notifyMe" onclick="notifyMe()">Notify me</button></div>
<button class="secondary" data-i18n="close" onclick="closeModal()" style="width:100%;height:42px;margin-top:9px">Close</button>
</div>
</div>

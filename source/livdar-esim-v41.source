  #travelToolsShowcase #inlineCostBtn{height:44px!important;border-radius:13px!important;font-size:11px!important;margin-top:9px!important}
  #how.steps-modern{padding:18px 10px 8px!important}
  #how .steps-modern-head{margin-bottom:9px!important}
  #how .steps-modern-head h2{font-size:21px!important}
  #how .steps-modern-head p{font-size:9px!important}
  #how .steps-modern-head a{font-size:9px!important}
  #how .steps-modern-grid{gap:7px!important}
  #how .step-modern{min-height:132px!important;padding:10px!important;border-radius:18px!important}
  #how .step-modern-num{width:27px!important;height:27px!important;font-size:11px!important}
  #how .step-modern-visual{width:40px!important;height:40px!important;right:7px!important;top:8px!important}
  #how .step-modern h4{margin-top:45px!important;font-size:12px!important;max-width:92px!important}
  #how .step-modern p{font-size:8px!important;max-width:100px!important}
  #viewAllBottom{height:34px!important;min-width:92px!important;padding:0 16px!important;font-size:10px!important}
}


/* ===== V15 FINAL VISUAL REWORK - requested reference match ===== */
#travelToolsShowcase{padding-top:14px!important}
#travelToolsShowcase .travel-showcase-shell{

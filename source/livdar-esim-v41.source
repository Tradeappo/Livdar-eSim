<section class="wrap section tools-section" id="travel-tools">
<div aria-label="Travel tools" class="tool-dock">
<button class="tool-chip" data-tool="cost" type="button"><span class="tool-chip-icon">€</span><span data-i18n="costTitle">Travel cost calculator</span></button>
<button class="tool-chip" data-tool="advisor" type="button"><span class="tool-chip-icon">◈</span><span class="tool-label-short">eSIM advisor</span></button>
<button class="tool-chip" data-tool="advice" type="button"><span class="tool-chip-icon">✦</span><span class="tool-label-short">Travel advice</span></button>
<button class="tool-chip" data-tool="card" type="button"><span class="tool-chip-icon">↗</span><span data-i18n="cardTitle">Travel card generator</span></button>
</div>
<div class="tool-backdrop" id="toolBackdrop" onclick="closeTravelTool()"></div>
<div class="tool-panel" id="tool-cost">
<button aria-label="Close" class="tool-close" onclick="closeTravelTool()" type="button">×</button>
<div class="tool-title-row">
<div class="tool-title-icon">€</div>
<div>
<h3 data-i18n="costTitle">Travel cost calculator</h3>
<p class="tool-note" data-i18n="costDesc">Estimate your trip budget in seconds.</p>
</div>
</div>
<div aria-label="Travel calculator views" class="tool-tabs">
<button class="tool-tab active" type="button">Trip details</button>
<button class="tool-tab" onclick="calculateTravelCost();activateToolTab(this)" type="button">Results</button>
<button class="tool-tab" onclick="activateToolTab(this)" type="button">Compare</button>
</div>
<div class="tool-form calc-form">
<div class="tool-field" data-icon="📍"><label data-i18n="destinationLabel">Destination</label><div class="field-inline"><input id="costDestination" value="Japan"/><span class="field-chevron">⌄</span></div></div>
<div class="tool-field" data-icon="📅"><label>Number of days</label><div class="field-inline"><input id="costDays" min="1" type="number" value="7"/><div class="field-stepper"><button data-step="-1" data-stepper-target="costDays" type="button">−</button><button data-step="1" data-stepper-target="costDays" type="button">＋</button></div></div></div>
<div class="tool-field" data-icon="🛏"><label data-i18n="accommodationLabel">Accommodation / day</label><div class="field-inline"><input id="costStay" min="0" type="number" value="85"/><div class="field-stepper"><button data-step="-5" data-stepper-target="costStay" type="button">−</button><button data-step="5" data-stepper-target="costStay" type="button">＋</button></div></div></div>
<div class="tool-field" data-icon="🍴"><label data-i18n="foodLabel">Food / day</label><div class="field-inline"><input id="costFood" min="0" type="number" value="35"/><div class="field-stepper"><button data-step="-5" data-stepper-target="costFood" type="button">−</button><button data-step="5" data-stepper-target="costFood" type="button">＋</button></div></div></div>
<div class="tool-field" data-icon="🚌"><label data-i18n="transportLabel">Transport / day</label><div class="field-inline"><input id="costTransport" min="0" type="number" value="15"/><div class="field-stepper"><button data-step="-5" data-stepper-target="costTransport" type="button">−</button><button data-step="5" data-stepper-target="costTransport" type="button">＋</button></div></div></div>
<div class="tool-field" data-icon="📶"><label>eSIM (total)</label><div class="field-inline"><input id="costEsim" min="0" type="number" value="12"/><div class="field-stepper"><button data-step="-1" data-stepper-target="costEsim" type="button">−</button><button data-step="1" data-stepper-target="costEsim" type="button">＋</button></div></div></div>
<div class="tool-field" data-icon="€"><label>Currency</label><div class="field-inline"><select id="costCurrency"><option value="EUR">EUR (€)</option><option value="USD">USD ($)</option><option value="GBP">GBP (£)</option></select><span class="field-chevron">⌄</span></div></div>
<label class="tool-switch-field"><span class="switch-copy"><span class="switch-label">Include activities</span><small>Tours, attractions, etc.</small></span><span class="switch"><input id="costActivitiesToggle" type="checkbox"/><i></i></span></label>
</div>
<div class="tool-actions"><button class="tool-primary" onclick="calculateTravelCost()" type="button">✦  <span data-i18n="calculate">Calculate</span> my trip  ›</button></div>
<div class="tool-result" id="costResult"></div>
</div>
<div class="tool-panel" id="tool-advisor">
<button aria-label="Close" class="tool-close" onclick="closeTravelTool()" type="button">×</button>
<div class="tool-title-row"><div class="tool-title-icon">◈</div><div><h3 data-i18n="advisorTitle">eSIM advisor</h3><p class="tool-note" data-i18n="advisorDesc">Find the right data size for your trip.</p></div></div>
<div class="tool-form">
<div class="tool-field" data-icon="📍"><label data-i18n="destinationLabel">Destination</label><div class="field-inline"><input id="advisorCountry" value="Japan"/><span class="field-chevron">⌄</span></div></div>
<div class="tool-field" data-icon="📅"><label data-i18n="daysLabel">Days</label><div class="field-inline"><input id="advisorDays" min="1" type="number" value="7"/><div class="field-stepper"><button data-step="-1" data-stepper-target="advisorDays" type="button">−</button><button data-step="1" data-stepper-target="advisorDays" type="button">＋</button></div></div></div>
<div class="tool-field" data-icon="📊"><label data-i18n="usageLabel">Estimated usage</label><div class="field-inline"><select id="advisorUsage"><option data-i18n="lightUsage" value="light">Light</option><option data-i18n="mediumUsage" selected="" value="medium">Medium</option><option data-i18n="heavyUsage" value="heavy">Heavy</option></select><span class="field-chevron">⌄</span></div></div>
<label class="tool-switch-field"><span class="switch-copy"><span class="switch-label" data-i18n="hotspotLabel">I use hotspot</span><small>Share internet with laptop or friends.</small></span><span class="switch"><input id="advisorHotspot" type="checkbox"/><i></i></span></label>
<label class="tool-switch-field"><span class="switch-copy"><span class="switch-label" data-i18n="fiveGLabel">Prefer 5G</span><small>Choose faster plans when possible.</small></span><span class="switch"><input checked="" id="advisor5g" type="checkbox"/><i></i></span></label>
</div>
<div class="tool-actions"><button class="tool-primary" data-i18n="recommend" onclick="recommendEsim()" type="button">Recommend</button></div>
<div class="tool-result" id="advisorResult"></div>
</div>
<div class="tool-panel" id="tool-advice">
<button aria-label="Close" class="tool-close" onclick="closeTravelTool()" type="button">×</button>
<div class="tool-title-row"><div class="tool-title-icon">✦</div><div><h3 data-i18n="adviceTitle">Travel advice</h3><p class="tool-note" data-i18n="adviceDesc">Useful checks before you arrive.</p></div></div>
<div class="tool-form"><div class="tool-field wide" data-icon="📍"><label data-i18n="destinationLabel">Destination</label><div class="field-inline"><input id="adviceDestination" value="Japan"/><span class="field-chevron">⌄</span></div></div></div>
<div class="tool-actions"><button class="tool-primary" data-i18n="showAdvice" onclick="renderTravelAdvice()" type="button">Show advice</button></div>
<div class="advice-grid" id="adviceGrid"></div>
</div>
<div class="tool-panel" id="tool-card">
<button aria-label="Close" class="tool-close" onclick="closeTravelTool()" type="button">×</button>
<div class="tool-title-row"><div class="tool-title-icon">↗</div><div><h3 data-i18n="cardTitle">Travel card generator</h3><p class="tool-note" data-i18n="cardDesc">Create a shareable trip card.</p></div></div>
<div class="share-card-wrap">
<div>
<div class="tool-form">
<div class="tool-field wide" data-icon="📍"><label data-i18n="destinationLabel">Destination</label><div class="field-inline"><input id="cardDestination" value="Japan"/><span class="field-chevron">⌄</span></div></div>
<div class="tool-field" data-icon="📅"><label data-i18n="daysLabel">Days</label><div class="field-inline"><input id="cardDays" min="1" type="number" value="7"/><div class="field-stepper"><button data-step="-1" data-stepper-target="cardDays" type="button">−</button><button data-step="1" data-stepper-target="cardDays" type="button">＋</button></div></div></div>
<div class="tool-field" data-icon="€"><label data-i18n="budgetLabel">Budget</label><div class="field-inline"><input id="cardBudget" min="0" type="number" value="1240"/></div></div>
<div class="tool-field" data-icon="📶"><label data-i18n="dataLabel">eSIM data</label><div class="field-inline"><input id="cardData" value="10 GB"/></div></div>
</div>
<div class="tool-actions"><button class="tool-primary" data-i18n="generateCard" onclick="drawTravelCard()" type="button">Generate card</button><button class="tool-secondary" data-i18n="downloadCard" onclick="downloadTravelCard()" type="button">Download PNG</button></div>
</div>
<div class="share-preview"><canvas height="800" id="travelCardCanvas" width="1240"></canvas></div>
</div>
</div>

</div>
</section>
<section class="wrap section legacy-how" id="howLegacy">
<div class="section-head"><div><h2 data-i18n="buyThree">Buy in three steps</h2><p data-i18n="simpleProductFirst">Simple, compact and product-first.</p></div></div>
<div class="steps">
<article class="step">
<div class="step-top"><div class="step-num">1</div><div class="step-icon">↗</div></div>
<b data-i18n="step1Title">Choose a destination</b>
<span data-i18n="step1Text">Search or browse plans instantly.</span>
<div class="step-foot"><span data-i18n="discover">Discover</span><i></i></div>
</article>
<article class="step">
<div class="step-top"><div class="step-num">2</div><div class="step-icon">⇄</div></div>
<b data-i18n="step2Title">Compare plans</b>
<span data-i18n="step2Text">See data, validity, network and price at a glance.</span>
<div class="step-foot"><span data-i18n="compare">Compare</span><i></i></div>
</article>
<article class="step">
<div class="step-top"><div class="step-num">3</div><div class="step-icon">✓</div></div>
<b data-i18n="step3Title">Continue to checkout</b>
<span data-i18n="step3Text">Purchase intent is measured only after plan selection.</span>
<div class="step-foot"><span data-i18n="continueLabel">Continue</span><i></i></div>
</article>
</div>
</section>

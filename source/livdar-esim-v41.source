<body>
<header>
<div class="wrap topnav">
<div class="brand">Livdar <small>eSIM</small></div>
<nav class="mainnav" id="mainNav">
<a class="active" data-i18n="navShop" href="#shop">Shop</a>
<a data-i18n="navDestinations" href="#destinations">Destinations</a>
<a data-i18n="navRegions" href="#regions">Regions</a>
<a data-i18n="navHow" href="#how">How it works</a>
<a data-i18n="navGuides" href="#guides">Guides</a>
</nav>
<div class="lang-wrap">
<button aria-expanded="false" aria-label="Language" class="lang-mini" id="langButton" type="button">🇬🇧 ▾</button>
<div class="lang-menu" id="langMenu" role="menu"></div>
</div>
</div>
</header>
<main>
<section class="wrap search-zone" id="shop">
<div class="searchbox app-searchbox">
<span aria-hidden="true" class="search-leading">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.05" viewbox="0 0 24 24">
<circle cx="11" cy="11" r="6.8"></circle><path d="M16 16l4.2 4.2"></path>
</svg>
</span>
<input data-i18n-placeholder="searchPlaceholder" id="searchInput" placeholder="Search destination, country or region..."/>
<button aria-label="Search" class="search-btn app-search-btn" id="searchBtn">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" viewbox="0 0 24 24">
<path d="M9 3H6a3 3 0 0 0-3 3v3"></path>
<path d="M15 3h3a3 3 0 0 1 3 3v3"></path>
<path d="M9 21H6a3 3 0 0 1-3-3v-3"></path>
<path d="M15 21h3a3 3 0 0 0 3-3v-3"></path>
</svg>
</button>
</div>
<div class="stories provider-carousel" id="stories">
<div class="story all active" data-provider="all"><div class="story-ring"><div class="story-core">ALL</div></div><span>All</span></div>

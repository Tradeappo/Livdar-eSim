<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width,initial-scale=1" name="viewport"/>
<title>Livdar eSIM Marketplace V5</title>
<style>
:root{--bg:#fff;--text:#111;--muted:#73777f;--line:#ececef;--soft:#f7f7f8;--accent:#ff7048}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fff;color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
button,input{font:inherit}a{color:inherit;text-decoration:none}.wrap{max-width:1180px;margin:auto;padding:0 14px}

header{position:sticky;top:0;z-index:70;background:rgba(255,255,255,.97);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
.topnav{height:58px;display:flex;align-items:center;gap:20px}
.brand{font-weight:900;font-size:22px;letter-spacing:-.045em;white-space:nowrap}
.brand small{font-size:13px;color:#8a8d93;letter-spacing:.07em}
.mainnav{display:flex;gap:22px;overflow:auto;scrollbar-width:none;white-space:nowrap;flex:1}
.mainnav::-webkit-scrollbar{display:none}
.mainnav a{padding:20px 0 17px;color:#777b81;font-size:14px;position:relative}
.mainnav a.active{color:#111;font-weight:850}
.mainnav a.active:after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;background:#111}
.lang-wrap{position:relative;margin-left:auto}
.lang-mini{border:0;background:transparent;padding:7px 2px 7px 8px;color:#222;font-weight:850;white-space:nowrap;border-radius:0;box-shadow:none;cursor:pointer;font-size:22px;line-height:1}
.lang-menu{position:absolute;right:0;top:40px;width:248px;max-height:430px;overflow:auto;background:rgba(255,255,255,.98);backdrop-filter:blur(18px);border:1px solid #e1e3e7;border-radius:18px;box-shadow:0 18px 45px rgba(17,18,20,.16);padding:7px;display:none;z-index:120}
.lang-menu.open{display:block}
.lang-option{width:100%;border:0;background:transparent;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 12px;border-radius:12px;cursor:pointer;text-align:left;color:#24272d}
.lang-option:hover{background:#f3f4f6}
.lang-option.active{background:#111;color:#fff}
.lang-option .lang-left{display:flex;align-items:center;gap:10px;min-width:0}
.lang-option .lang-meta{display:flex;flex-direction:column;gap:2px;min-width:0;line-height:1.06}
.lang-option .lang-flag{font-size:18px;flex:0 0 auto}
.lang-option .lang-name{display:block;font-weight:800;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lang-option .lang-native{display:block;font-size:11px;opacity:.65;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lang-option .lang-code{font-size:10px;font-weight:900;letter-spacing:.08em;opacity:.65;flex:0 0 auto}

.search-zone{padding:12px 0 0}
.search-zone .label,.label[data-i18n="browseProvider"]{display:none !important}
.search-zone .stories{margin-top:2px;padding:0 0 8px}
.searchbox{display:flex;align-items:center;gap:8px;border:1px solid #ececef;background:#f7f7f8;border-radius:14px;padding:6px 7px 6px 14px}
.searchbox input{border:0;outline:0;background:transparent;flex:1;height:42px;font-size:16px}
.search-btn{width:42px;height:42px;border:0;border-radius:50%;background:#111;color:#fff;display:grid;place-items:center;cursor:pointer}
.search-btn svg{width:20px;height:20px}


.label{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#777b81;font-weight:900;margin:14px 0 10px}
.stories{display:flex;gap:18px;overflow:auto;scrollbar-width:none;padding:0 4px 8px}
.stories::-webkit-scrollbar{display:none}
.story{width:92px;flex:0 0 auto;text-align:center;cursor:pointer;position:relative;padding:2px 0 10px}
.story-ring{width:82px;height:82px;border-radius:50%;margin:auto;position:relative;display:grid;place-items:center;transition:transform .22s cubic-bezier(.2,.8,.2,1),filter .22s ease}
.story-ring:before{content:"";position:absolute;inset:-10px;border-radius:50%;background:var(--halo);filter:blur(16px);opacity:.58;transform:scale(.92);transition:.22s ease;z-index:0}
.story-ring:after{content:"";position:absolute;inset:7px;border-radius:50%;background:var(--orb);filter:blur(0);z-index:1;box-shadow:0 10px 22px rgba(20,20,25,.10)}
.story-core{width:68px;height:68px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:900;font-size:13px;letter-spacing:-.03em;position:relative;z-index:2;background:transparent;text-shadow:0 1px 8px rgba(0,0,0,.18)}
.story-core:before{content:"";position:absolute;inset:0;border-radius:50%;background:
  radial-gradient(circle at 26% 24%,rgba(255,255,255,.42) 0 6%,rgba(255,255,255,.13) 18%,transparent 37%),
  radial-gradient(circle at 76% 68%,var(--bubble2) 0 17%,transparent 34%),
  radial-gradient(circle at 35% 78%,var(--bubble3) 0 13%,transparent 29%);
  mix-blend-mode:screen;opacity:.9;pointer-events:none}
.story-core:after{content:"";position:absolute;inset:-1px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(255,255,255,.14);pointer-events:none}
.story span{display:none}
.story:hover .story-ring{transform:translateY(-3px) scale(1.02)}
.story.active .story-ring{transform:translateY(-4px) scale(1.08)}
.story.active .story-ring:before{opacity:.95;transform:scale(1.12);filter:blur(18px)}
.story.active .story-ring:after{box-shadow:0 14px 28px rgba(18,18,22,.16),0 0 0 2px rgba(255,255,255,.92)}
.story.active:after{display:none}
.story.all{--orb:conic-gradient(from 220deg,#27d6e8,#19b7cf 24%,#2b8ed8 48%,#55e2e8 68%,#2580c7 84%,#27d6e8);--halo:radial-gradient(circle,rgba(39,214,232,.62) 0%,rgba(39,214,232,.16) 58%,transparent 74%);--bubble2:rgba(220,252,255,.40);--bubble3:rgba(255,255,255,.18)}
.story.all .story-core{color:#ffffff;text-shadow:0 2px 8px rgba(17,22,31,.28);font-weight:950}
.story.all .story-ring:after{box-shadow:0 12px 24px rgba(47,63,73,.18)}
.story[data-provider="airalo"]{--orb:conic-gradient(from 220deg,#ff5a71,#ff8d7a 30%,#ff4d64 60%,#ff9a72 82%,#ff5a71);--halo:radial-gradient(circle,rgba(255,92,111,.78) 0%,rgba(255,92,111,.18) 58%,transparent 74%);--bubble2:rgba(255,213,133,.55);--bubble3:rgba(255,255,255,.18)}
.story[data-provider="saily"]{--orb:conic-gradient(from 210deg,#ffe84d,#ffc93d 28%,#ffdc5e 54%,#ffb91f 78%,#ffe84d);--halo:radial-gradient(circle,rgba(255,211,57,.78) 0%,rgba(255,211,57,.18) 58%,transparent 74%);--bubble2:rgba(255,250,188,.48);--bubble3:rgba(255,255,255,.18)}
.story[data-provider="nomad"]{--orb:conic-gradient(from 215deg,#0b0b0f,#2d3037 28%,#111319 56%,#454a54 80%,#0b0b0f);--halo:radial-gradient(circle,rgba(31,34,41,.68) 0%,rgba(31,34,41,.14) 58%,transparent 74%);--bubble2:rgba(165,171,183,.24);--bubble3:rgba(255,255,255,.12)}
.story[data-provider="holafly"]{--orb:conic-gradient(from 215deg,#10a96d,#3edc9a 28%,#0fbd79 56%,#7ae3b7 78%,#10a96d);--halo:radial-gradient(circle,rgba(20,184,119,.75) 0%,rgba(20,184,119,.17) 58%,transparent 74%);--bubble2:rgba(190,255,221,.40);--bubble3:rgba(255,255,255,.16)}
.story[data-provider="maya"]{--orb:conic-gradient(from 215deg,#6f45e8,#a06cf5 30%,#7048df 58%,#c18cff 80%,#6f45e8);--halo:radial-gradient(circle,rgba(123,78,234,.78) 0%,rgba(123,78,234,.18) 58%,transparent 74%);--bubble2:rgba(255,180,252,.35);--bubble3:rgba(255,255,255,.16)}

.category-shell{position:sticky;top:58px;z-index:55;background:rgba(255,255,255,.96);backdrop-filter:blur(15px);border-bottom:1px solid var(--line)}
.categories{display:flex;gap:9px;overflow:auto;scrollbar-width:none;padding:8px 0 9px}
.categories::-webkit-scrollbar{display:none}
.cat{--m1:#fff;--m2:#eef0f4;--m3:#d9dde4;--ink:#4a4e55;position:relative;overflow:hidden;flex:0 0 auto;border:1px solid #dfe2e7;background:linear-gradient(180deg,var(--m1) 0%,var(--m2) 55%,var(--m3) 100%);border-radius:999px;padding:10px 16px;font-size:13px;font-weight:760;color:var(--ink);box-shadow:inset 0 1px 0 rgba(255,255,255,.98),0 6px 16px rgba(20,24,32,.06);cursor:pointer;transition:transform .16s ease,box-shadow .16s ease}
.cat:before{content:"";position:absolute;left:8%;right:8%;top:3px;height:46%;border-radius:999px;background:linear-gradient(180deg,rgba(255,255,255,.86),rgba(255,255,255,.06));pointer-events:none}
.cat:hover{transform:translateY(-1px)}
.cat.active{transform:translateY(-1px);box-shadow:inset 0 1px 0 rgba(255,255,255,.78),0 9px 20px rgba(18,20,25,.13);border-color:rgba(25,27,31,.12)}
.cat[data-cat="all"].active{--m1:#53565d;--m2:#26282d;--m3:#0d0e10;--ink:#fff}
.cat[data-cat="under10"].active{--m1:#ffffff;--m2:#e8ebf0;--m3:#bfc5cf;--ink:#1f2329}
.cat[data-cat="10gb"].active{--m1:#fff8d0;--m2:#efd55c;--m3:#cfa61d;--ink:#332700}
.cat[data-cat="30days"].active{--m1:#fff1e7;--m2:#dfa06d;--m3:#b86d39;--ink:#381b09}
.cat[data-cat="unlimited"].active{--m1:#f8fbff;--m2:#bdc9dc;--m3:#7b8aa5;--ink:#152033}
.cat[data-cat="5g"].active{--m1:#effff5;--m2:#9fd4b2;--m3:#5b9972;--ink:#10271a}
.cat[data-cat="europe"].active{--m1:#ffffff;--m2:#e1e4ea;--m3:#aeb5c2;--ink:#1a1d22}
.cat[data-cat="asia"].active{--m1:#fff8d7;--m2:#dcbf55;--m3:#a7821e;--ink:#2e2100}
.cat[data-cat="americas"].active{--m1:#eef6ff;--m2:#85b7e9;--m3:#4f7fb1;--ink:#0f2237}

.section{padding:16px 0}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-bottom:9px}
.section-head h2{margin:0;font-size:23px;letter-spacing:-.035em}
.section-head p{margin:4px 0 0;color:var(--muted);font-size:12px}
.section-head a{color:#33373d;font-size:11px;font-weight:850;border:1px solid #d6dae0;background:#fff;border-radius:999px;padding:7px 12px;line-height:1;box-shadow:none;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap}
.products-section{padding-top:14px}
.products-section .section-head{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;column-gap:12px;row-gap:6px;margin-top:10px;margin-bottom:14px;padding-right:2px}
.products-section #viewAll{padding:0 12px;font-size:10px;line-height:1;height:28px;min-height:28px;margin-top:8px;position:static;align-self:end;justify-self:end;flex:0 0 auto;border:1px solid #d7dbe2;border-radius:999px;background:rgba(255,255,255,.98);box-shadow:none}
.products-section .section-head > div{display:flex;flex-direction:column;justify-content:flex-end;gap:2px;min-width:0;padding-top:6px}
#gridSub{font-size:11px!important;color:var(--muted);line-height:1.1;transform:translateY(2px)}

.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:3px}
.card{position:relative;aspect-ratio:.72;overflow:hidden;background:#ddd;cursor:pointer}
.card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.card:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 18%,rgba(0,0,0,.08) 48%,rgba(0,0,0,.88) 100%)}
.top{position:absolute;z-index:2;left:9px;right:9px;top:9px;display:flex;justify-content:space-between;align-items:center}
.badge{background:rgba(255,255,255,.92);padding:5px 7px;border-radius:999px;font-size:8px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
.flag{font-size:20px}
.bottom{position:absolute;z-index:2;left:9px;right:9px;bottom:9px;color:#fff;min-height:86px}
.provline{display:flex;align-items:center;gap:6px;font-size:9px;color:rgba(255,255,255,.8);margin-bottom:4px}
.pdot{width:18px;height:18px;border-radius:50%;display:grid;place-items:center;font-size:8px;font-weight:900;color:#fff;box-shadow:0 0 12px var(--glow)}
.row{display:block;padding-right:74px}
.row h3{margin:0;font-size:14px;line-height:1.08}
.price-stack{
  position:absolute;
  right:0;
  bottom:0;
  display:flex;
  flex-direction:column;
  align-items:flex-end;
  gap:5px
}
.price{font-weight:900;font-size:15px;white-space:nowrap}
.card-view{
  min-width:48px;
  height:23px;
  padding:0 9px;
  border-radius:999px;
  border:.7px solid rgba(255,255,255,.78);
  background:transparent;
  color:#fff;
  font-size:10px;
  font-weight:800;
  letter-spacing:.01em;
  box-shadow:none;
  backdrop-filter:none;
  cursor:pointer
}
.card-view:active{transform:scale(.96)}
.meta{display:flex;gap:4px;flex-wrap:wrap;margin-top:6px;font-size:9px;padding-right:74px}
.meta span{padding:4px 6px;border:1px solid rgba(255,255,255,.18);background:rgba(10,10,10,.34);border-radius:999px}

.empty{display:none;text-align:center;color:#777;padding:28px;border:1px dashed #ddd}
.collection-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;max-height:390px;overflow-y:auto;padding-right:4px;scrollbar-width:thin;scrollbar-color:#cfd2d8 transparent}
.collection-grid::-webkit-scrollbar{width:5px}.collection-grid::-webkit-scrollbar-thumb{background:#cfd2d8;border-radius:999px}
.collection{position:relative;min-height:76px;display:flex;align-items:center;gap:12px;padding:12px 14px;background:linear-gradient(180deg,#fff,#f7f8fa);border:1px solid #e4e6ea;box-shadow:0 6px 14px rgba(17,18,20,.045);overflow:hidden;cursor:pointer;transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}
.collection:hover{transform:translateY(-1px);border-color:#d8dbe1;box-shadow:0 9px 18px rgba(17,18,20,.07)}
.collection .flag-chip{font-size:30px;line-height:1;flex:0 0 auto;filter:saturate(.98)}
.collection .dest-copy{min-width:0;display:flex;flex-direction:column;gap:3px}
.collection .dest-name{font-weight:850;font-size:14px;line-height:1.15;color:#17181a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.collection .dest-sub{font-size:10px;color:#8a8d93;text-transform:uppercase;letter-spacing:.08em;font-weight:800}


.regional-track{display:flex;gap:8px;overflow:auto;scrollbar-width:none;padding:2px 0 4px;scroll-snap-type:x mandatory}
.regional-track::-webkit-scrollbar{display:none}
.region-card{flex:0 0 42%;min-width:240px;position:relative;overflow:hidden;aspect-ratio:1.12;background:#eee;scroll-snap-align:start;box-shadow:0 10px 24px rgba(17,18,20,.08);border:1px solid #e1e3e7}
.region-card img{width:100%;height:100%;object-fit:cover;display:block}
.region-card:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 25%,rgba(0,0,0,.76) 100%)}
.region-copy{position:absolute;z-index:2;left:14px;right:14px;bottom:13px;color:#fff}
.region-copy strong{display:block;font-size:26px;letter-spacing:-.045em;line-height:.95}.region-copy small{display:block;margin-top:8px;font-size:12px;color:rgba(255,255,255,.84);line-height:1.35;max-width:92%}


.steps{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:10px
}
.step{
  position:relative;
  min-height:166px;
  padding:16px 16px 15px;
  border:1px solid #e7e8eb;
  border-radius:20px;
  background:
    radial-gradient(circle at 92% 8%,rgba(255,255,255,.98) 0 18%,transparent 19%),
    linear-gradient(145deg,#ffffff 0%,#f7f8fa 72%,#f0f2f5 100%);
  box-shadow:
    0 10px 24px rgba(17,18,20,.055),
    inset 0 1px 0 rgba(255,255,255,.98);
  overflow:hidden;
  isolation:isolate
}
.step:before{
  content:"";
  position:absolute;
  inset:auto -26px -46px auto;
  width:120px;
  height:120px;
  border-radius:50%;
  background:radial-gradient(circle,var(--softGlow) 0%,transparent 70%);
  opacity:.95;
  pointer-events:none;
  z-index:-1
}
.step:after{
  content:"";
  position:absolute;
  left:16px;
  right:16px;
  top:0;
  height:3px;
  border-radius:0 0 999px 999px;
  background:linear-gradient(90deg,var(--stepA),var(--stepB),transparent)
}
.step:nth-child(1){
  --stepA:#17191d;--stepB:#6c7380;
  --softGlow:rgba(40,44,52,.08);
  --iconBg:#111317;--iconFg:#fff
}
.step:nth-child(2){
  --stepA:#d5ae3f;--stepB:#8e6d18;
  --softGlow:rgba(213,174,63,.16);
  --iconBg:linear-gradient(145deg,#f5dd82,#c79c2d);
  --iconFg:#2b2106
}
.step:nth-child(3){
  --stepA:#ff7a52;--stepB:#c94c2b;
  --softGlow:rgba(255,122,82,.16);
  --iconBg:linear-gradient(145deg,#ff9b7d,#ff7048);
  --iconFg:#351006
}
.step-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px
}
.step-num{
  display:inline-flex;
  align-items:center;
  gap:8px;
  width:auto;
  height:auto;
  border:0;
  border-radius:0;
  background:transparent!important;
  color:#737780!important;
  font-size:10px;
  font-weight:900;
  letter-spacing:.14em;
  text-transform:uppercase;
  box-shadow:none!important
}
.step-num:before{
  content:"Step";
}
.step-icon{
  width:42px;
  height:42px;
  border-radius:14px;
  display:grid;
  place-items:center;
  font-size:20px;
  background:var(--iconBg);
  color:var(--iconFg);
  border:1px solid rgba(17,18,20,.06);
  box-shadow:
    0 8px 18px rgba(17,18,20,.08),
    inset 0 1px 0 rgba(255,255,255,.22)
}
.step b{
  display:block;
  margin:22px 0 7px;
  max-width:90%;
  font-size:21px;
  line-height:1.02;
  letter-spacing:-.045em
}
.step span{
  display:block;
  max-width:92%;
  color:#72767e;
  font-size:12px;
  line-height:1.48
}
.step-foot{
  position:absolute;
  right:15px;
  bottom:14px;
  left:auto;
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:8px;
  border:0;
  padding:0;
  color:#a0a3aa;
  font-size:9px;
  font-weight:900;
  letter-spacing:.1em;
  text-transform:uppercase
}
.step-foot i{
  width:20px;
  height:1px;
  background:linear-gradient(90deg,var(--stepA),transparent);
  display:block
}


.footer-card{background:linear-gradient(180deg,#fff,#f4f5f7);color:#111;margin-top:24px;padding:26px 0 32px;border-top:1px solid #e3e5e9}
.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:24px;align-items:start}
.footer-card .brand small{color:#9a9da3}.footer-card h4{margin:0 0 9px;font-size:12px;letter-spacing:.04em}.footer-card a{display:block;color:#72767d;font-size:11px;padding:5px 0}.footer-card a:hover{color:#111}

.overlay{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.45);display:none;align-items:flex-end;justify-content:center}.overlay.open{display:flex}
.drawer{width:min(700px,100%);background:#fff;max-height:93vh;overflow:auto}
.drawer-hero{height:300px;position:relative;overflow:hidden}.drawer-hero img{width:100%;height:100%;object-fit:cover}.close{position:absolute;right:12px;top:12px;width:40px;height:40px;border:0;border-radius:50%;background:rgba(255,255,255,.92);font-size:20px}
.drawer-body{padding:16px}.drawer-body h2{margin:0 0 4px;font-size:27px}.drawer-body p{margin:0 0 12px;color:var(--muted)}
.details{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.detail{background:#f7f7f8;border:1px solid var(--line);padding:11px}.detail span{display:block;color:var(--muted);font-size:9px}.detail b{font-size:14px}
.buybar{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:13px}.buybar button{height:48px;font-weight:900}.secondary{background:#fff;border:1px solid var(--line)}.buy{background:var(--accent);border:0}
.modal{position:fixed;inset:0;z-index:120;background:rgba(0,0,0,.5);display:none;place-items:center;padding:18px}.modal.open{display:grid}.modalbox{width:min(430px,100%);background:#fff;padding:22px}.modalbox h3{margin:0 0 8px;font-size:22px}.modalbox p{color:var(--muted);font-size:13px;line-height:1.5}.mail{display:grid;grid-template-columns:1fr auto;gap:7px}.mail input{border:1px solid var(--line);padding:11px}.mail button{border:0;background:var(--accent);font-weight:900;padding:0 13px}

@media(max-width:900px){.grid{grid-template-columns:repeat(3,1fr)}.collection-grid{grid-template-columns:repeat(2,1fr);max-height:420px}}
@media(max-width:700px){
  .wrap{padding:0 8px}.topnav{height:56px;gap:14px}.brand{font-size:21px}.mainnav{gap:18px}.mainnav a{font-size:13px;padding:19px 0 15px}.lang-mini{font-size:12px}
  .category-shell{top:56px}
  .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:2px}
  .card{aspect-ratio:.70}.row h3{font-size:13px}.price{font-size:14px}.card-view{height:23px;min-width:48px;padding:0 8px;font-size:9px;border:.7px solid rgba(255,255,255,.72);background:transparent;color:#fff}
  .collection-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;max-height:430px}.collection{min-height:70px;padding:10px 11px}.collection .flag-chip{font-size:28px}.collection .dest-name{font-size:13px}.collection .dest-sub{font-size:9px}
  .steps{display:flex;overflow:auto;gap:9px;scroll-snap-type:x mandatory;scrollbar-width:none;padding:2px 0 6px}.steps::-webkit-scrollbar{display:none}.step{flex:0 0 78vw;min-width:270px;min-height:158px;scroll-snap-align:start}.step b{font-size:20px;margin-top:19px}.step span{font-size:11.5px;max-width:88%}.step-icon{width:40px;height:40px;border-radius:13px}.step-foot{font-size:8px}
  .footer-grid{grid-template-columns:1fr 1fr}
  .details{grid-template-columns:repeat(2,1fr)}
}

/* Livdar travel tools - premium device-native utility UI */
.tools-section{
  margin-top:18px;
  padding:0;
  border:0;
  background:transparent;
  box-shadow:none
}
.tools-intro{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin:0 0 10px}
.tools-intro h2{margin:0;font-size:20px;letter-spacing:-.045em;font-weight:900;color:#101216}
.tools-intro p{margin:3px 0 0;color:#8e95a0;font-size:10px;line-height:1.3}
.tool-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:8px;
  padding:0;
  background:transparent
}
.tool-card{
  min-width:0;
  min-height:72px;
  border:1px solid rgba(214,220,229,.88);
  background:linear-gradient(180deg,rgba(255,255,255,.98),rgba(247,249,252,.94));
  padding:8px 5px;
  cursor:pointer;
  text-align:center;
  border-radius:20px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:6px;
  box-shadow:0 8px 22px rgba(24,33,48,.055),inset 0 1px 0 rgba(255,255,255,.98);
  transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease
}
.tool-card:active{transform:scale(.965)}
.tool-card.active{border-color:#a7b8ff;box-shadow:0 10px 24px rgba(52,82,170,.10),0 0 0 2px rgba(92,124,255,.06)}
.tool-icon{
  width:35px;height:35px;border-radius:13px;display:grid;place-items:center;
  font-size:15px;margin:0;color:#fff;font-weight:900;
  background:linear-gradient(145deg,#4778ff,#7f8dff);
  box-shadow:0 7px 16px rgba(72,107,255,.20),inset 0 1px 0 rgba(255,255,255,.26)
}
.tool-card:nth-child(2) .tool-icon{background:linear-gradient(145deg,#7047ff,#a86cff);box-shadow:0 7px 16px rgba(126,78,255,.20)}
.tool-card:nth-child(3) .tool-icon{background:linear-gradient(145deg,#10b97d,#51dda9);box-shadow:0 7px 16px rgba(20,184,126,.18)}
.tool-card:nth-child(4) .tool-icon{background:linear-gradient(145deg,#ff626d,#ff9272);box-shadow:0 7px 16px rgba(255,101,106,.18)}
.tool-card b{display:block;font-size:9.5px;line-height:1.08;letter-spacing:-.02em;color:#1b1f25;font-weight:850}
.tool-card span{display:none}

.tool-backdrop{position:fixed;inset:0;background:rgba(13,18,28,.30);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);z-index:220;display:none}
.tool-backdrop.open{display:block}
.tool-panel{
  display:none;
  position:fixed;
  left:50%;bottom:0;
  width:min(720px,100%);
  max-height:min(88vh,820px);
  overflow:auto;
  z-index:230;
  transform:translateX(-50%);
  margin:0;
  border:1px solid rgba(220,225,233,.94);
  border-bottom:0;
  border-radius:30px 30px 0 0;
  background:linear-gradient(180deg,rgba(255,255,255,.995),rgba(248,250,253,.99));
  padding:14px 18px 24px;
  box-shadow:0 -24px 70px rgba(17,28,46,.20),inset 0 1px 0 rgba(255,255,255,.98)
}
.tool-panel.active{display:block;animation:toolSheetIn .24s cubic-bezier(.2,.8,.2,1)}
@keyframes toolSheetIn{from{transform:translate(-50%,24px);opacity:.45}to{transform:translate(-50%,0);opacity:1}}
.tool-panel:before{content:"";display:block;width:40px;height:5px;border-radius:999px;background:#c9ced8;margin:0 auto 13px}
.tool-close{position:absolute;right:18px;top:28px;width:34px;height:34px;border:0;border-radius:50%;background:#eef1f6;color:#12161d;font-size:21px;line-height:1;display:grid;place-items:center;cursor:pointer;z-index:2;box-shadow:inset 0 1px 0 rgba(255,255,255,.9)}
.tool-title-row{display:flex;align-items:center;gap:11px;padding-right:48px;margin-bottom:3px}
.tool-title-icon{width:44px;height:44px;border-radius:15px;display:grid;place-items:center;color:#fff;font-size:19px;font-weight:900;background:linear-gradient(145deg,#4778ff,#7f8dff);box-shadow:0 8px 18px rgba(72,107,255,.20)}
#tool-advisor .tool-title-icon{background:linear-gradient(145deg,#7047ff,#a86cff);box-shadow:0 8px 18px rgba(126,78,255,.20)}
#tool-advice .tool-title-icon{background:linear-gradient(145deg,#10b97d,#51dda9);box-shadow:0 8px 18px rgba(20,184,126,.18)}
#tool-card .tool-title-icon{background:linear-gradient(145deg,#ff626d,#ff9272);box-shadow:0 8px 18px rgba(255,101,106,.18)}
.tool-panel h3{margin:0;font-size:21px;letter-spacing:-.045em;color:#101317;font-weight:900}
.tool-panel .tool-note{margin:2px 48px 13px 55px;color:#9299a4;font-size:10px;line-height:1.35}
.tool-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:12px 0 14px;padding:4px;background:#f0f3f7;border-radius:16px}
.tool-tab{height:34px;border:0;border-radius:12px;background:transparent;color:#697281;font-size:10px;font-weight:800;cursor:pointer}
.tool-tab.active{background:#11151c;color:#fff;box-shadow:0 4px 12px rgba(17,21,28,.14)}

.tool-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;clear:both}
.tool-field{display:flex;flex-direction:column;gap:4px;min-width:0;position:relative;padding:10px 12px 9px 46px;min-height:62px;border:1px solid #dfe4ec;background:rgba(255,255,255,.82);border-radius:18px;box-shadow:inset 0 1px 0 rgba(255,255,255,.96)}
.tool-field.wide{grid-column:span 2}
.tool-field:before{content:attr(data-icon);position:absolute;left:11px;top:50%;transform:translateY(-50%);width:27px;height:27px;border-radius:9px;background:#f0f3f7;display:grid;place-items:center;font-size:13px;color:#4d5a70;font-weight:900}
.tool-field label{font-size:9px;text-transform:none;letter-spacing:0;font-weight:650;color:#7a8391;line-height:1.1}
.tool-field input,.tool-field select{width:100%;height:25px;border:0;background:transparent;border-radius:0;padding:0;font:inherit;font-size:14px;font-weight:800;color:#11151b;outline:none;appearance:none}
.tool-field input:focus,.tool-field select:focus{border:0;background:transparent;box-shadow:none}
.tool-check{min-height:62px;border:1px solid #dfe4ec;background:rgba(255,255,255,.82);border-radius:18px;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 13px;font-size:11px;color:#555e6b}
.tool-check input{width:18px;height:18px;accent-color:#11151b}
.tool-actions{display:flex;gap:8px;align-items:center;margin-top:13px}
.tool-primary,.tool-secondary{height:46px;border-radius:17px;padding:0 18px;font-size:11px;font-weight:850;cursor:pointer}
.tool-primary{border:0;background:linear-gradient(135deg,#11151c,#17283f 72%,#4c77b5);color:#fff;box-shadow:0 10px 24px rgba(17,27,42,.16);flex:1}
.tool-secondary{border:1px solid #d9dfe6;background:#fff;color:#24282e}
.tool-result{margin-top:10px;padding:14px 15px;border:1px solid #dde4ed;border-radius:18px;background:linear-gradient(145deg,#10151d,#223249);color:#fff;font-size:11px;line-height:1.45;display:none;box-shadow:0 10px 24px rgba(20,31,48,.11)}
.tool-result.show{display:block}.tool-result strong{font-size:20px;display:block;margin-top:3px}
.advice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}
.advice-item{border:1px solid #e0e5ec;background:#fff;border-radius:18px;padding:12px;box-shadow:0 6px 15px rgba(20,28,40,.04)}
.advice-item b{display:block;font-size:10px;margin-bottom:4px}.advice-item span{font-size:10px;color:#707882;line-height:1.4}
.share-card-wrap{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:12px;align-items:start}
.share-preview{background:#0f141c;padding:8px;border-radius:20px;box-shadow:0 10px 26px rgba(16,23,34,.15)}.share-preview canvas{width:100%;display:block;aspect-ratio:1.55;border-radius:14px}

@media(max-width:720px){
  .stories{display:grid;grid-auto-flow:column;grid-auto-columns:74px;gap:8px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 0 7px;margin-top:1px}
  .story{width:74px;padding:1px 0 7px;scroll-snap-align:start}
  .story-ring{width:70px;height:70px}
  .story-core{width:58px;height:58px;font-size:12px}
  .story-ring:before{inset:-7px;filter:blur(13px)}
  .tools-section{margin-top:16px}
  .tools-intro{margin-bottom:8px}.tools-intro h2{font-size:18px}.tools-intro p{font-size:9px}
  .tool-grid{gap:6px}
  .tool-card{min-height:69px;padding:8px 3px;border-radius:18px}
  .tool-card b{font-size:8.5px}
  .tool-icon{width:33px;height:33px;border-radius:12px;font-size:14px}
  .tool-panel{padding:12px 12px 22px;max-height:88vh;border-radius:28px 28px 0 0}
  .tool-panel:before{margin-bottom:12px}
  .tool-close{right:13px;top:25px;width:33px;height:33px}
  .tool-title-row{gap:10px;padding-right:45px}
  .tool-title-icon{width:43px;height:43px;border-radius:14px}
  .tool-panel h3{font-size:20px}
  .tool-panel .tool-note{margin-left:53px;margin-right:46px;font-size:9.5px}
  .tool-tabs{margin:11px 0 13px}
  .tool-form{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
  .tool-field{min-height:60px;border-radius:17px;padding:9px 9px 8px 42px}
  .tool-field:before{left:9px;width:26px;height:26px}
  .tool-field.wide{grid-column:span 2}
  .tool-check{min-height:60px;border-radius:17px;padding:0 11px}
  .advice-grid{grid-template-columns:1fr}
  .share-card-wrap{grid-template-columns:1fr}.share-preview{order:-1}
}

/* FINAL VISIBLE TRAVEL TOOLS OVERRIDES */
.tools-section{margin:10px auto 7px!important;padding:0 8px!important;border:0!important;background:transparent!important;box-shadow:none!important}
.tools-intro{margin:0 0 6px!important;padding:0 2px!important;display:flex!important;align-items:center!important}
.tools-intro h2{font-size:12px!important;font-weight:850!important;letter-spacing:-.02em!important;margin:0!important;color:#20242a!important}
.tools-intro p{display:none!important}
.tool-grid{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:5px!important;padding:7px!important;border:1px solid #e5e8ee!important;border-radius:22px!important;background:rgba(248,249,251,.92)!important;backdrop-filter:blur(18px)!important;-webkit-backdrop-filter:blur(18px)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.98),0 8px 24px rgba(28,35,48,.05)!important}
.tool-card{min-height:64px!important;border:0!important;background:transparent!important;padding:4px 1px!important;border-radius:16px!important;box-shadow:none!important;gap:6px!important}
.tool-card.active{background:#fff!important;box-shadow:0 6px 16px rgba(20,29,43,.07)!important}
.tool-icon{width:38px!important;height:38px!important;border-radius:13px!important;font-size:15px!important;margin:0!important}
.tool-card b{font-size:8.5px!important;line-height:1.05!important;max-width:70px!important;font-weight:850!important}
.tool-card span{display:none!important}
.tool-panel{width:min(700px,100%)!important;max-height:86vh!important;border-radius:30px 30px 0 0!important;padding:14px 14px 22px!important;background:rgba(250,251,253,.99)!important}
.tool-title-row{gap:10px!important}
.tool-title-icon{width:44px!important;height:44px!important;border-radius:14px!important}
.tool-panel h3{font-size:20px!important}
.tool-panel .tool-note{margin-left:54px!important;font-size:9.5px!important}
.tool-tabs{background:#eef1f5!important;border-radius:15px!important;padding:4px!important;gap:5px!important}
.tool-tab{height:34px!important;border-radius:11px!important}
.tool-field,.tool-check{border-radius:17px!important;background:#fff!important;border:1px solid #e0e5ec!important;box-shadow:none!important}
.tool-field{min-height:60px!important;padding:9px 10px 8px 43px!important}
.tool-field:before{left:9px!important;width:27px!important;height:27px!important;border-radius:9px!important;background:#f1f4f8!important}
.tool-primary{height:48px!important;border-radius:17px!important;background:linear-gradient(135deg,#11151c,#20334d 72%,#5b7fb9)!important}
@media(max-width:720px){
  .tools-section{margin-top:8px!important;padding:0 8px!important}
  .tool-grid{gap:4px!important;padding:6px!important}
  .tool-card{min-height:62px!important}
  .tool-card b{font-size:8px!important;max-width:66px!important}
  .tool-icon{width:37px!important;height:37px!important}
  .tool-panel{padding:12px 12px 20px!important}
}


/* ===== Premium app-style refresh ===== */
body{background:linear-gradient(180deg,#f6f8fc 0%,#ffffff 240px, #ffffff 100%)}
header{background:rgba(247,249,253,.84);backdrop-filter:blur(24px);border-bottom:1px solid rgba(222,227,236,.75)}
.mainnav a{font-size:16px;color:#6e7581}
.mainnav a.active{color:#111317}
.mainnav a.active:after{height:3px;border-radius:999px}
.search-zone{padding:18px 0 6px}
.app-searchbox{display:flex;align-items:center;gap:12px;padding:0 10px 0 14px;height:70px;border:1px solid rgba(219,224,233,.9);background:rgba(255,255,255,.78);backdrop-filter:blur(16px);border-radius:24px;box-shadow:0 12px 30px rgba(31,44,68,.06), inset 0 1px 0 rgba(255,255,255,.92)}
.search-leading{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;color:#9da5b0;flex:0 0 auto}
.search-leading svg{width:24px;height:24px}
.app-searchbox input{height:68px;font-size:17px;color:#1a1f28}
.app-searchbox input::placeholder{color:#9fa6b2}
.app-search-btn{width:48px;height:48px;border-radius:16px;background:rgba(255,255,255,.7);border:1px solid rgba(224,228,236,.96);color:#20242c;box-shadow:0 4px 12px rgba(32,38,46,.05)}
.app-search-btn svg{width:22px;height:22px}
.provider-carousel{gap:16px;margin-top:14px;padding:0 4px 2px}
.story{width:88px;padding-bottom:6px}
.story-ring{width:82px;height:82px}
.story-ring:before{opacity:.72}
.story.active .story-ring{transform:none}
.story.active .story-ring:after{box-shadow:0 16px 28px rgba(18,18,22,.14),0 0 0 2px rgba(255,255,255,.96)}
.story:after{display:none!important}
.story.all{--orb:conic-gradient(from 210deg,#5f7281,#879dac 28%,#42505a 57%,#93adbc 82%,#5f7281);--halo:radial-gradient(circle,rgba(111,135,151,.45) 0%,rgba(111,135,151,.12) 58%,transparent 74%);--bubble2:rgba(242,248,255,.30);--bubble3:rgba(255,255,255,.16)}
.category-shell{position:relative;top:0;background:transparent;border-bottom:0;backdrop-filter:none}
.categories{gap:12px;padding:8px 0 10px}
.cat{padding:12px 22px;font-size:14px;border-radius:22px;background:linear-gradient(180deg,#ffffff,#f0f3f8);box-shadow:inset 0 1px 0 rgba(255,255,255,.98),0 6px 18px rgba(28,34,42,.05)}
.cat[data-cat="all"].active{--m1:#5b5f68;--m2:#202226;--m3:#090a0b;--ink:#fff}
.cat[data-cat="5g"].active{--m1:#f4f8ff;--m2:#dce6f7;--m3:#c8d6f0;--ink:#1d2b43}
.tools-section{margin:8px 0 6px;padding:0;border:0;background:transparent;box-shadow:none}
.tool-dock{display:flex;gap:10px;overflow:auto;scrollbar-width:none;padding:0 2px 4px}
.tool-dock::-webkit-scrollbar{display:none}
.tool-chip{flex:0 0 auto;display:flex;align-items:center;gap:10px;min-width:132px;padding:11px 14px;border-radius:20px;border:1px solid rgba(218,223,232,.92);background:linear-gradient(180deg,rgba(255,255,255,.9),rgba(247,249,252,.98));box-shadow:0 10px 28px rgba(21,30,46,.06), inset 0 1px 0 rgba(255,255,255,.96);color:#171a21;font-weight:800;font-size:12px;cursor:pointer}
.tool-chip-icon{width:32px;height:32px;border-radius:12px;display:grid;place-items:center;color:#fff;background:linear-gradient(145deg,#4d72ff,#8b9dff);box-shadow:0 8px 18px rgba(82,110,240,.19);font-size:15px;flex:0 0 auto}
.tool-chip[data-tool="advisor"] .tool-chip-icon{background:linear-gradient(145deg,#7f4dff,#b680ff)}
.tool-chip[data-tool="advice"] .tool-chip-icon{background:linear-gradient(145deg,#19ba82,#60e0b0)}
.tool-chip[data-tool="card"] .tool-chip-icon{background:linear-gradient(145deg,#ff6d7f,#ffa16c)}
.tool-chip.active{border-color:#cfd7ff;box-shadow:0 12px 30px rgba(57,80,171,.10),0 0 0 2px rgba(95,123,255,.06)}
.tool-backdrop{background:rgba(19,25,38,.24);backdrop-filter:blur(10px)}
.tool-panel{width:min(760px,100%);max-height:min(84vh,900px);padding:14px 18px 30px;border-radius:32px 32px 0 0;background:linear-gradient(180deg,rgba(255,255,255,.99),rgba(247,249,253,.985));border:1px solid rgba(223,228,236,.96);box-shadow:0 -30px 80px rgba(16,24,40,.16), inset 0 1px 0 rgba(255,255,255,.96)}
.tool-panel:before{width:56px;height:6px;border-radius:999px;background:#d6dbe3;margin:0 auto 16px}
.tool-close{right:16px;top:22px;width:46px;height:46px;border-radius:50%;background:#f0f3fa;box-shadow:0 8px 16px rgba(26,36,50,.06), inset 0 1px 0 rgba(255,255,255,.95);font-size:22px}
.tool-title-row{align-items:center;gap:14px;padding-right:60px;margin-bottom:2px}
.tool-title-icon{width:54px;height:54px;border-radius:18px;font-size:25px}
.tool-panel h3{font-size:25px;line-height:1.02}
.tool-panel .tool-note{margin:4px 0 0;color:#959cab;font-size:15px;line-height:1.32}
.tool-tabs{gap:10px;padding:0;background:transparent;border-radius:0;margin:20px 0 16px}
.tool-tab{height:42px;border-radius:999px;background:#eef1f7;color:#6f7887;font-size:13px;font-weight:800;box-shadow:inset 0 1px 0 rgba(255,255,255,.88)}
.tool-tab.active{background:#0d1016;box-shadow:0 10px 22px rgba(16,18,25,.12)}
.tool-form{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.tool-field,.tool-switch-field{min-height:76px;border:1px solid rgba(223,228,236,.96);background:rgba(255,255,255,.78);border-radius:22px;box-shadow:inset 0 1px 0 rgba(255,255,255,.96)}
.tool-field{padding:14px 14px 14px 60px}
.tool-field:before{left:14px;width:34px;height:34px;border-radius:12px;background:#eef3f7;color:#516172;font-size:17px;box-shadow:inset 0 1px 0 rgba(255,255,255,.95)}
.tool-field label{font-size:12px;font-weight:700;color:#778091;margin-bottom:4px}
.field-inline{display:flex;align-items:center;justify-content:space-between;gap:12px}
.tool-field input,.tool-field select{height:30px;font-size:18px;font-weight:800;color:#141923}
.field-chevron{font-size:18px;color:#8a92a0;line-height:1;flex:0 0 auto}
.field-stepper{display:flex;align-items:center;gap:10px;flex:0 0 auto}
.field-stepper button{width:34px;height:34px;border-radius:50%;border:1px solid #e4e8ef;background:#f4f6fb;color:#4f5665;font-size:19px;line-height:1;display:grid;place-items:center;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.95)}
.tool-switch-field{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 16px}
.switch-copy{display:flex;flex-direction:column;gap:3px;min-width:0}
.switch-label{font-weight:800;font-size:12px;color:#161b23}
.switch-copy small{font-size:12px;color:#9098a7;line-height:1.25}
.switch{position:relative;width:56px;height:32px;flex:0 0 auto}
.switch input{opacity:0;position:absolute;inset:0}
.switch i{position:absolute;inset:0;border-radius:999px;background:#d9dee7;transition:.2s ease;box-shadow:inset 0 1px 0 rgba(255,255,255,.95)}
.switch i:after{content:"";position:absolute;top:3px;left:3px;width:26px;height:26px;border-radius:50%;background:#fff;box-shadow:0 4px 10px rgba(20,28,44,.12);transition:.2s ease}
.switch input:checked + i{background:#10131a}
.switch input:checked + i:after{left:27px}
.tool-actions{margin-top:16px}
.tool-primary,.tool-secondary{height:54px;border-radius:999px;font-weight:850;font-size:17px}
.tool-primary{background:#080b11;color:#fff;box-shadow:0 14px 28px rgba(7,10,17,.18)}
.tool-secondary{background:#fff;border:1px solid #dfe4ec;color:#131720}
.tool-result{margin-top:14px;padding:18px 20px;border-radius:22px;background:linear-gradient(180deg,#f7f9fd,#eef3fa);font-size:15px;color:#4e5767;display:none}
.tool-result.show{display:block}
.tool-result strong{display:block;margin-top:6px;font-size:28px;color:#10151d;letter-spacing:-.03em}
.products-section{padding-top:12px}
.products-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:10px 0 14px}
.products-meta{display:flex;flex-direction:column;gap:3px}
#gridSub{font-size:16px!important;color:#6f7785!important;font-weight:650;transform:none!important}
.products-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}
.products-viewall{display:inline-flex;align-items:center;justify-content:center;height:48px;padding:0 18px;border:1px solid rgba(220,225,233,.96);background:rgba(255,255,255,.9);border-radius:999px;color:#555f70;font-size:14px;font-weight:800;box-shadow:0 8px 22px rgba(31,44,68,.05)}
.sort-pill{display:flex;align-items:center;gap:10px;height:48px;padding:0 14px;border:1px solid rgba(220,225,233,.96);background:rgba(255,255,255,.9);border-radius:999px;box-shadow:0 8px 22px rgba(31,44,68,.05)}
.sort-ico{font-size:18px;color:#4a5568}
.sort-pill select{border:0;background:transparent;font-size:14px;font-weight:800;color:#2b3442;outline:none;appearance:none;padding-right:4px}
.grid{gap:10px}
.card{border-radius:24px;border:1px solid rgba(221,226,235,.95);box-shadow:0 14px 30px rgba(28,36,51,.08);background:#dfe6ef}
.card:after{background:linear-gradient(180deg,rgba(6,11,17,.02) 6%,rgba(7,12,18,.06) 32%,rgba(8,14,21,.86) 100%)}
.top{left:14px;right:14px;top:14px}
.badge{padding:8px 12px;font-size:12px;letter-spacing:.08em;border-radius:999px}
.save-btn{width:34px;height:34px;border:1px solid rgba(255,255,255,.88);background:rgba(255,255,255,.08);color:#fff;border-radius:50%;display:grid;place-items:center;font-size:18px;line-height:1;backdrop-filter:blur(8px);cursor:pointer}
.bottom{left:14px;right:14px;bottom:14px;min-height:128px}
.country-row{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.flag-pill{display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:26px;padding:0 7px;border-radius:10px;background:rgba(255,255,255,.9);font-size:19px;box-shadow:0 8px 20px rgba(17,18,20,.12)}
.country-name{margin:0;font-size:20px;line-height:1.05;letter-spacing:-.04em}
.provider-copy{font-size:15px;color:rgba(255,255,255,.78);margin-bottom:1px}
.price-row{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin-top:1px}
.price{font-size:21px}
.card-view{width:54px;height:54px;min-width:54px;border-radius:50%;border:0;background:#fff;color:#151922;font-size:30px;font-weight:500;display:grid;place-items:center;box-shadow:0 16px 30px rgba(8,12,19,.24)}
.meta{margin-top:12px;gap:8px;padding-right:0}
.meta span{padding:8px 12px;font-size:12px;background:rgba(14,17,24,.28);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(6px)}
.row,.provline,.price-stack{display:none}
@media(max-width:700px){
  .wrap{padding:0 14px}
  .topnav{height:72px;gap:18px}
  .brand{font-size:26px}
  .brand small{font-size:13px}
  .mainnav{gap:18px}
  .mainnav a{font-size:15px;padding:24px 0 16px}
  .lang-mini{font-size:18px}
  .search-zone{padding-top:16px}
  .app-searchbox{height:68px}
  .provider-carousel{gap:14px;padding-bottom:2px}
  .story{width:86px}
  .categories{gap:10px}
  .cat{padding:12px 20px}
  .tool-dock{margin-bottom:4px}
  .products-toolbar{align-items:flex-start;flex-direction:column}
  .products-actions{width:100%;justify-content:space-between}
  .products-viewall,.sort-pill{height:46px}
  .sort-pill{max-width:100%;flex:1}
  .sort-pill select{width:100%}
  .grid{gap:8px}
  .card{aspect-ratio:.92;border-radius:22px}
  .badge{font-size:8px;padding:6px 10px}
  .bottom{min-height:116px}
  .country-name{font-size:18px}
  .provider-copy{font-size:14px}
  .price{font-size:19px}
  .card-view{width:48px;height:48px;min-width:48px;font-size:28px}
  .meta span{font-size:10px;padding:7px 10px}
  .tool-panel{padding:14px 14px 26px;border-radius:28px 28px 0 0}
  .tool-close{width:42px;height:42px;top:20px;right:14px}
  .tool-title-icon{width:50px;height:50px;font-size:23px}
  .tool-panel h3{font-size:24px}
  .tool-panel .tool-note{font-size:14px}
  .tool-tabs{gap:8px;margin:18px 0 14px}
  .tool-tab{height:40px;font-size:12px}
  .tool-form{gap:10px}
  .tool-field,.tool-switch-field{min-height:72px;border-radius:20px}
  .tool-field{padding:12px 12px 12px 54px}
  .tool-field:before{left:12px;width:32px;height:32px;font-size:16px}
  .tool-field label,.switch-label{font-size:11px}
  .tool-field input,.tool-field select{font-size:16px;height:28px}
  .field-stepper{gap:8px}
  .field-stepper button{width:32px;height:32px;font-size:18px}
  .tool-switch-field{padding:12px 14px}
  .switch-copy small{font-size:11px}
  .tool-primary,.tool-secondary{height:52px;font-size:16px}
}


/* ===== FINAL MATCH TO APPROVED MOCK ===== */
body{background:#f7f9fc}
header{background:rgba(247,249,253,.96)}
.search-zone{background:transparent;padding-top:14px}
.app-searchbox{height:62px;border-radius:24px;background:rgba(255,255,255,.9)}
.provider-carousel{margin-top:10px;gap:12px;padding-bottom:4px}
.story{width:76px}
.story-ring{width:72px;height:72px}
.story-core{width:60px;height:60px;font-size:12px}
.category-shell{background:transparent}
.categories{padding:8px 0 10px;gap:8px}
.cat{padding:10px 16px;font-size:13px;border-radius:999px}

/* Hide the temporary travel tools launcher row. Tools remain functional as sheets. */
.tools-section{margin:0!important;padding:0!important;height:0!important;overflow:visible!important}
.tool-dock{display:none!important}

.products-section{padding-top:8px}
.products-toolbar{margin:4px 0 12px;display:flex;align-items:center;justify-content:space-between;gap:10px}
.products-meta{flex:1}
#gridSub{font-size:14px!important;font-weight:600!important;color:#6f7785!important}
.products-actions{display:flex;gap:8px;align-items:center}
.products-viewall{height:38px;padding:0 14px;font-size:11px;border-radius:999px;box-shadow:none}
.sort-pill{height:40px;padding:0 14px;border-radius:999px;min-width:190px;box-shadow:none}
.sort-pill select{font-size:13px;font-weight:800}

.grid{gap:10px}
.card{aspect-ratio:.79;border-radius:22px;box-shadow:0 10px 26px rgba(26,34,49,.08)}
.top{left:12px;right:12px;top:12px}
.badge{font-size:8px;padding:6px 10px}
.save-btn{width:34px;height:34px;font-size:19px}
.bottom{left:14px;right:14px;bottom:14px;min-height:0}
.country-row{margin-bottom:4px;align-items:center}
.flag-pill{min-width:31px;height:24px;font-size:17px;border-radius:8px}
.country-name{font-size:18px;line-height:1.05;margin:0;font-weight:850}
.provider-copy{font-size:13px;color:rgba(255,255,255,.76);margin:0 0 1px}
.price-row{margin-top:0;align-items:end}
.price{font-size:18px;font-weight:900}
.card-view{width:44px;height:44px;min-width:44px;font-size:24px}
.meta{margin-top:8px;gap:6px}
.meta span{font-size:10px;padding:6px 9px}

.tool-panel{width:min(710px,100%);max-height:80vh;border-radius:30px 30px 0 0;padding:14px 16px 24px}
.tool-panel:before{width:52px;height:6px;margin-bottom:14px}
.tool-title-row{gap:13px;padding-right:56px}
.tool-title-icon{width:50px;height:50px;border-radius:16px}
.tool-panel h3{font-size:22px}
.tool-panel .tool-note{font-size:13px;margin-top:2px}
.tool-tabs{margin:16px 0 14px;gap:8px}
.tool-tab{height:40px;font-size:12px}
.tool-form{gap:10px}
.tool-field,.tool-switch-field{min-height:68px;border-radius:20px}
.tool-field{padding:12px 12px 11px 52px}
.tool-field:before{left:11px;width:30px;height:30px}
.tool-field label{font-size:11px}
.tool-field input,.tool-field select{font-size:16px}
.field-stepper button{width:31px;height:31px}
.tool-primary,.tool-secondary{height:50px;font-size:15px}

/* Single small launcher matching the approved UI, tucked beside filters */
.tools-launcher{flex:0 0 auto;width:42px;height:42px;border-radius:50%;border:1px solid #dfe4ec;background:#fff;display:grid;place-items:center;box-shadow:0 5px 14px rgba(24,33,48,.05);cursor:pointer;font-size:18px;color:#222a35}
.tools-picker{display:none;position:fixed;left:50%;bottom:0;transform:translateX(-50%);width:min(520px,100%);z-index:235;background:#fff;border-radius:28px 28px 0 0;padding:14px 14px 24px;box-shadow:0 -26px 70px rgba(16,24,40,.20)}
.tools-picker.open{display:block}
.tools-picker:before{content:"";display:block;width:48px;height:5px;background:#d3d8e0;border-radius:99px;margin:0 auto 14px}
.tools-picker-title{font-size:18px;font-weight:900;margin:0 0 12px}
.tools-picker-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.tools-picker-btn{display:flex;align-items:center;gap:10px;min-height:58px;border:1px solid #e2e6ed;background:#f8f9fb;border-radius:18px;padding:10px 12px;font-weight:800;font-size:12px;cursor:pointer}
.tools-picker-btn i{width:34px;height:34px;border-radius:12px;display:grid;place-items:center;color:#fff;font-style:normal;background:linear-gradient(145deg,#4778ff,#7f8dff)}
.tools-picker-btn:nth-child(2) i{background:linear-gradient(145deg,#7047ff,#a86cff)}
.tools-picker-btn:nth-child(3) i{background:linear-gradient(145deg,#10b97d,#51dda9)}
.tools-picker-btn:nth-child(4) i{background:linear-gradient(145deg,#ff626d,#ff9272)}

@media(max-width:700px){
  .topnav{height:66px}.brand{font-size:24px}.mainnav a{font-size:14px;padding:22px 0 14px}
  .app-searchbox{height:60px}
  .provider-carousel{gap:10px}
  .story{width:74px}.story-ring{width:70px;height:70px}.story-core{width:58px;height:58px}
  .products-toolbar{align-items:center;flex-direction:row}
  .products-actions{width:auto;flex:0 0 auto}
  .products-viewall{display:none}
  .sort-pill{min-width:175px;max-width:190px;flex:0 0 auto}
  .grid{gap:8px}
  .card{aspect-ratio:.78;border-radius:20px}
  .country-name{font-size:17px}.provider-copy{font-size:12px}.price{font-size:17px}
  .card-view{width:42px;height:42px;min-width:42px;font-size:23px}
  .meta span{font-size:9px;padding:6px 8px}
  .tool-panel{max-height:79vh}
}


/* ===== FINAL POLISH OVERRIDES ===== */
#travel-tools{display:none!important}
.products-viewall{display:none!important}
.filter-fab{flex:0 0 auto;width:40px;height:40px;border-radius:50%;border:1px solid #d7dbe3;background:#fff;display:grid;place-items:center;gap:3px;padding:0;box-shadow:0 4px 14px rgba(22,28,40,.06)}
.filter-fab span{display:block;width:15px;height:1.8px;background:#111;border-radius:999px}
.filter-fab span:nth-child(2){width:11px}.filter-fab span:nth-child(3){width:7px}
.app-search-btn{font-size:0}
.app-search-btn svg{width:24px;height:24px}
.products-toolbar{align-items:center!important}
.products-actions{margin-left:auto}
.grid{gap:2px!important}
.card{position:relative;overflow:hidden;border-radius:6px!important;aspect-ratio:.72;background:#ddd;box-shadow:none;border:none}
.card::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,10,15,.04) 0%,rgba(7,10,15,.08) 36%,rgba(7,10,15,.78) 100%)}
.card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.card-top{position:absolute;left:12px;right:12px;top:12px;z-index:2;display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.card-badge{display:inline-flex;align-items:center;height:31px;padding:0 14px;border-radius:999px;background:rgba(255,255,255,.92);font-size:10px;font-weight:900;letter-spacing:.19em;text-transform:uppercase;color:#14181f}
.card-icons{display:flex;align-items:center;gap:10px;color:#fff}
.card-flag{font-size:22px;line-height:1;text-shadow:0 1px 4px rgba(0,0,0,.18)}
.card-save{border:0;background:transparent;box-shadow:none;padding:0;color:#fff;font-size:28px;line-height:1;cursor:pointer;text-shadow:0 2px 10px rgba(0,0,0,.4)}
.card-bottom{position:absolute;left:12px;right:12px;bottom:12px;z-index:2;color:#fff}
.card-title-row{display:flex;align-items:flex-end;justify-content:space-between;gap:10px}
.card-title-wrap h3{margin:0;font-size:16px;line-height:1.05;font-weight:900;color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.28)}
.card-provider{margin:6px 0 0;font-size:13px;color:rgba(255,255,255,.82)}
.card-price{font-size:18px;font-weight:900;color:#fff;white-space:nowrap;text-shadow:0 2px 10px rgba(0,0,0,.22)}
.card-view{margin-top:10px;height:46px;min-width:46px;padding:0 16px;border-radius:999px;border:1px solid rgba(255,255,255,.24);background:rgba(255,255,255,.96);color:#111;font-size:20px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;box-shadow:none}
.card-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.card-meta span{padding:6px 10px;border-radius:999px;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.18);font-size:12px;color:#fff}
.products-footer{display:flex;justify-content:center;padding:16px 0 0}
.view-all-bottom{height:42px;padding:0 22px;border-radius:999px;border:1px solid #d8dde5;background:#fff;font-weight:800;font-size:14px;color:#212733;box-shadow:0 6px 18px rgba(31,44,68,.05)}
.travel-tools-showcase{padding-top:18px}
.travel-showcase-shell{background:linear-gradient(180deg,rgba(248,250,253,.98),rgba(252,253,255,.98));border:1px solid rgba(223,228,236,.92);border-radius:28px;padding:22px;box-shadow:0 18px 45px rgba(25,34,48,.05);overflow:hidden;position:relative}
.travel-showcase-shell::before{content:"";position:absolute;right:-40px;top:-34px;width:250px;height:180px;background:linear-gradient(135deg,rgba(255,255,255,.12),rgba(102,165,255,.10)),url('https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;border-radius:30px;opacity:.9}
.travel-showcase-hero{display:flex;justify-content:space-between;align-items:flex-start;position:relative;z-index:1}
.travel-showcase-hero h2{margin:0;font-size:28px;letter-spacing:-.05em}
.travel-showcase-hero p{margin:4px 0 0;color:#8b93a0;font-size:14px}
.travel-tool-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;position:relative;z-index:1;margin-top:20px}
.travel-tool-tab{min-height:114px;border:1px solid rgba(224,229,237,.95);border-radius:24px;background:#fff;padding:18px 14px;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end;gap:14px;box-shadow:0 12px 26px rgba(18,24,36,.04);font-size:14px;font-weight:800;color:#151a22;text-align:left}
.travel-tool-tab.active{border-color:#7aaef8;box-shadow:0 0 0 2px rgba(107,162,255,.18),0 16px 30px rgba(18,24,36,.05)}
.tab-icon,.inline-tool-icon{width:54px;height:54px;border-radius:18px;display:grid;place-items:center;color:#fff;font-size:23px;font-weight:900;box-shadow:0 10px 22px rgba(49,62,92,.18)}
.tab-icon.cost,.inline-tool-icon.cost{background:linear-gradient(135deg,#6d89ff,#4d72ff)}
.tab-icon.advisor,.inline-tool-icon.advisor{background:linear-gradient(135deg,#a45fff,#8a61ff)}
.tab-icon.advice,.inline-tool-icon.advice{background:linear-gradient(135deg,#31d69b,#4adba8)}
.tab-icon.card,.inline-tool-icon.card{background:linear-gradient(135deg,#ff8e85,#ff9b68)}
.inline-tool-panel{display:none;position:relative;z-index:1;margin-top:18px;background:#fff;border:1px solid rgba(224,229,237,.95);border-radius:28px;padding:22px;box-shadow:0 12px 28px rgba(18,24,36,.04)}
.inline-tool-panel.active{display:block}
.inline-tool-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:18px}
.inline-tool-title{display:flex;align-items:flex-start;gap:16px}
.inline-tool-title h3{margin:0;font-size:24px;line-height:1.04;letter-spacing:-.045em}
.inline-tool-title p{margin:5px 0 0;color:#9aa1ab;font-size:14px}
.inline-currency-select{display:flex;align-items:center;gap:8px;padding:0 14px;height:52px;border-radius:999px;border:1px solid rgba(222,227,236,.96);background:#fff;font-weight:700;color:#394150}
.inline-currency-select select{border:0;background:transparent;font:inherit;outline:none}
.inline-tool-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.inline-tool-grid.single{grid-template-columns:minmax(0,1fr)}
.inline-field,.inline-toggle-card{display:flex;flex-direction:column;justify-content:center;min-height:92px;border:1px solid rgba(223,228,236,.96);border-radius:24px;background:linear-gradient(180deg,#fff,#fbfcfe);padding:14px 16px;box-shadow:inset 0 1px 0 rgba(255,255,255,.96)}
.inline-field.wide{grid-column:1/-1}
.inline-field span{font-size:14px;color:#737c89;margin-bottom:8px;font-weight:600}
.inline-field-row{display:flex;align-items:center;gap:12px}
.inline-field-row i{width:44px;height:44px;border-radius:14px;background:#f2f5fb;display:grid;place-items:center;font-style:normal;font-size:21px;color:#576375}
.inline-field-row b{font-weight:700;color:#96a0ad}
.inline-field input,.inline-field select{border:0;background:transparent;font-size:17px;font-weight:800;color:#151a22;outline:none;width:100%}
.inline-toggle-card{flex-direction:row;align-items:center;justify-content:space-between;gap:16px}
.inline-toggle-card strong{display:block;font-size:16px;color:#171b22}
.inline-toggle-card small{display:block;margin-top:4px;color:#8e96a2;font-size:13px;line-height:1.35}
.switch{position:relative;width:76px;height:42px;display:inline-block;flex:0 0 auto}
.switch input{display:none}.switch i{position:absolute;inset:0;background:#dfe4ed;border-radius:999px;transition:.2s}.switch i::after{content:"";position:absolute;left:4px;top:4px;width:34px;height:34px;border-radius:50%;background:#fff;box-shadow:0 2px 6px rgba(0,0,0,.12);transition:.2s}.switch input:checked + i{background:#0a1020}.switch input:checked + i::after{transform:translateX(34px)}
.inline-primary-btn,.inline-secondary-btn{height:54px;border-radius:999px;padding:0 24px;border:0;font-size:16px;font-weight:900;letter-spacing:-.02em;cursor:pointer}
.inline-primary-btn{margin-top:18px;background:linear-gradient(90deg,#070b14 0%,#102846 46%,#5d87ca 100%);color:#fff;box-shadow:0 16px 30px rgba(17,28,46,.12)}
.inline-primary-btn strong{font-weight:800;margin-left:10px}
.inline-secondary-btn{background:#fff;border:1px solid rgba(219,224,233,.95);color:#1d2430}
.inline-actions-row{display:flex;gap:14px;flex-wrap:wrap;margin-top:18px}.inline-actions-row .inline-primary-btn,.inline-actions-row .inline-secondary-btn{margin-top:0;flex:1}
.inline-result-card{display:none;margin-top:18px;border:1px solid rgba(223,228,236,.96);border-radius:24px;padding:20px;background:linear-gradient(180deg,#fff,#fbfcfe)}
.inline-result-card.active{display:block}
.inline-result-card h4{margin:0 0 8px;font-size:18px}.inline-result-card .big-result{font-size:54px;font-weight:900;line-height:1;color:#0f1520;margin:8px 0 14px}
.inline-result-card .mini-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.inline-result-card .mini-grid div{padding:14px;border-radius:18px;background:#f7f9fc}.inline-result-card .mini-grid small{display:block;color:#7e8795;margin-bottom:3px}
.inline-advice-list{display:grid;gap:14px;margin-top:18px}.inline-advice-item{padding:18px 20px;border-radius:24px;border:1px solid rgba(223,228,236,.96);background:linear-gradient(180deg,#fff,#fbfcfe)}.inline-advice-item h5{margin:0 0 8px;font-size:18px}.inline-advice-item p{margin:0;color:#707988;line-height:1.65;font-size:15px}
.trip-card-preview{min-height:235px;border-radius:28px;padding:28px;background:linear-gradient(120deg,#051225 0%,#243a55 48%,#5e7082 100%);position:relative;overflow:hidden;color:#fff;box-shadow:inset 0 0 0 14px rgba(2,8,18,.55)}
.trip-card-preview::after{content:"";position:absolute;right:-40px;top:-26px;width:220px;height:220px;border-radius:50%;background:rgba(255,255,255,.08)}
.trip-card-brand{font-size:18px;font-weight:700;position:relative;z-index:1}.trip-card-preview h4{position:relative;z-index:1;margin:36px 0 12px;font-size:54px;line-height:.95;letter-spacing:-.04em}.trip-card-preview p{position:absolute;left:28px;bottom:34px;right:28px;margin:0;color:rgba(255,255,255,.82);font-size:20px;z-index:1}
.steps-modern-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:20px}.steps-modern-head h2{margin:0;font-size:34px;letter-spacing:-.05em}.steps-modern-head p{margin:4px 0 0;color:#8f97a4;font-size:16px}.steps-modern-head a{font-weight:700;color:#6a9ce8}
.steps-modern-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.step-modern{min-height:220px;border-radius:26px;padding:22px;background:#fff;border:1px solid rgba(225,230,237,.96);position:relative;overflow:hidden;box-shadow:0 12px 26px rgba(18,24,36,.04)}
.step-modern.one{background:linear-gradient(180deg,#fff7fa,#fff)}.step-modern.two{background:linear-gradient(180deg,#f7fbff,#fff)}.step-modern.three{background:linear-gradient(180deg,#f7fff8,#fff)}
.step-modern-num{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;font-size:20px;font-weight:900;margin-bottom:40px}.step-modern.one .step-modern-num{background:#ffd9e2;color:#d93f6d}.step-modern.two .step-modern-num{background:#dbe8ff;color:#366ae3}.step-modern.three .step-modern-num{background:#d9f7de;color:#149b47}
.step-modern-emoji{position:absolute;right:20px;top:18px;font-size:64px;opacity:.46}.step-modern h4{margin:0 0 10px;font-size:22px;line-height:1.05;letter-spacing:-.04em}.step-modern p{margin:0;color:#727b88;font-size:16px;line-height:1.5;max-width:220px}
.sheet-close{position:absolute;right:16px;top:16px;width:48px;height:48px;border-radius:50%;border:0;background:#f4f6fa;font-size:32px;color:#1b2028;line-height:1;cursor:pointer}
.sheet-handle{width:56px;height:6px;border-radius:999px;background:#ced4de;margin:0 auto 12px}
.filter-backdrop,.scanner-backdrop{position:fixed;inset:0;background:rgba(16,22,33,.32);backdrop-filter:blur(8px);display:none;z-index:220}
.filter-backdrop.open,.scanner-backdrop.open{display:block}
.filter-sheet,.scanner-sheet{position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:min(760px,100%);max-height:84vh;overflow:auto;background:linear-gradient(180deg,rgba(255,255,255,.99),rgba(247,249,253,.995));border:1px solid rgba(223,228,236,.96);border-radius:30px 30px 0 0;padding:18px 18px 26px;box-shadow:0 -30px 80px rgba(16,24,40,.16);display:none;z-index:230}
.filter-sheet.open,.scanner-sheet.open{display:block}
.filter-sheet h3,.scanner-sheet h3{margin:0 0 8px;font-size:26px;letter-spacing:-.04em}.scanner-sheet p{margin:0 0 14px;color:#8f97a4}
.sheet-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}.sheet-field{display:flex;flex-direction:column;gap:8px;font-weight:700;color:#697485}.sheet-field select{height:52px;border:1px solid rgba(223,228,236,.96);border-radius:18px;padding:0 14px;background:#fff;font-size:16px;font-weight:700;color:#1b212b}
.sheet-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}.sheet-actions .inline-primary-btn,.sheet-actions .inline-secondary-btn{margin-top:0;flex:1}
#scannerVideo{display:block;width:100%;max-height:44vh;border-radius:24px;background:#111;object-fit:cover}
.scanner-status{margin-top:14px;padding:13px 15px;border-radius:18px;background:#f6f8fb;color:#5f6774;font-weight:600}
.upload-cta{display:inline-flex;align-items:center;justify-content:center;position:relative}
@media (max-width: 768px){
 .wrap{padding:0 14px}
 .products-actions{width:100%;justify-content:flex-end}
 .sort-pill{min-width:0;max-width:none;width:100%}
 .card{border-radius:0!important}
 .card-top{left:10px;right:10px;top:10px}.card-bottom{left:10px;right:10px;bottom:10px}
 .card-title-wrap h3{font-size:15px}.card-provider{font-size:12px}.card-price{font-size:16px}.card-view{height:44px;min-width:44px;padding:0 15px;font-size:18px}.card-meta span{font-size:11px;padding:6px 9px}.card-save{font-size:26px}.card-flag{font-size:20px}
 .travel-showcase-shell{padding:18px;border-radius:24px}.travel-showcase-shell::before{right:-74px;top:-55px;width:220px;height:155px;opacity:.84}
 .travel-showcase-hero h2{font-size:30px}.travel-tool-tabs{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.travel-tool-tab{min-height:108px;border-radius:22px;padding:15px 14px}.tab-icon,.inline-tool-icon{width:46px;height:46px;border-radius:15px;font-size:20px}
 .inline-tool-panel{padding:18px;border-radius:24px}.inline-tool-header{flex-direction:column;align-items:stretch}.inline-tool-title h3{font-size:19px}.inline-tool-title p{font-size:12px}.inline-currency-select{height:48px;align-self:flex-end}
 .inline-tool-grid,.sheet-grid,.steps-modern-grid{grid-template-columns:minmax(0,1fr)}
 .inline-field,.inline-toggle-card{min-height:84px;border-radius:20px;padding:13px 14px}.inline-field span{font-size:11px;margin-bottom:6px}.inline-field-row i{width:38px;height:38px;border-radius:12px;font-size:18px}.inline-field input,.inline-field select{font-size:15px}
 .inline-primary-btn,.inline-secondary-btn{height:50px;font-size:14px}.trip-card-preview{min-height:180px;padding:22px;border-radius:24px;box-shadow:inset 0 0 0 10px rgba(2,8,18,.55)}.trip-card-brand{font-size:16px}.trip-card-preview h4{margin-top:30px;font-size:34px}.trip-card-preview p{left:22px;right:22px;bottom:26px;font-size:16px}
 .steps-modern-head{align-items:flex-start;flex-direction:column}.steps-modern-head h2{font-size:28px}.steps-modern-head p,.step-modern p{font-size:14px}.step-modern{min-height:180px;border-radius:22px;padding:18px}.step-modern h4{font-size:22px}.step-modern-emoji{font-size:54px;top:14px}
 .filter-sheet,.scanner-sheet{padding:16px 14px 22px;border-radius:28px 28px 0 0}
 .products-footer{padding-top:14px}
}


/* ===== FINAL COMPLETION PASS ===== */
.active-filter-row{display:none;gap:8px;overflow:auto;padding-top:8px;padding-bottom:2px;scrollbar-width:none}.active-filter-row::-webkit-scrollbar{display:none}.active-filter-row.has-items{display:flex}
.active-filter-chip{flex:0 0 auto;height:32px;padding:0 10px;border:1px solid #dce1e9;border-radius:999px;background:#fff;color:#374151;font-size:11px;font-weight:800;display:inline-flex;align-items:center;gap:7px}.active-filter-chip button{border:0;background:transparent;font-size:15px;line-height:1;color:#717b88;padding:0;cursor:pointer}
.provider-multi-block{margin-top:16px}.filter-label{display:block;font-size:13px;font-weight:800;color:#697485;margin-bottom:9px}.provider-multi{display:flex;gap:8px;flex-wrap:wrap}.provider-multi label{position:relative}.provider-multi input{position:absolute;opacity:0;pointer-events:none}.provider-multi span{height:38px;padding:0 13px;border:1px solid #dfe4ec;border-radius:999px;background:#fff;color:#4a5565;font-size:12px;font-weight:800;display:flex;align-items:center}.provider-multi input:checked + span{background:#111722;color:#fff;border-color:#111722}
.sheet-sub{margin:0;color:#8f97a4;font-size:13px;line-height:1.45}.filter-toggle-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}.filter-toggle{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:78px;padding:13px 14px;border:1px solid #e1e6ed;border-radius:20px;background:#fff}.filter-toggle strong{display:block;font-size:13px;color:#171c24}.filter-toggle small{display:block;margin-top:3px;color:#9098a5;font-size:11px;line-height:1.3}
.scanner-stage{position:relative;overflow:hidden;border-radius:24px;background:#0d1117;min-height:260px}.scanner-stage video{width:100%;height:100%;min-height:260px;max-height:46vh;object-fit:cover;display:block}.scanner-frame{position:absolute;inset:24px;border-radius:22px;pointer-events:none}.scanner-frame i{position:absolute;width:44px;height:44px;border-color:#fff;border-style:solid;filter:drop-shadow(0 2px 4px rgba(0,0,0,.24))}.scanner-frame i:nth-child(1){left:0;top:0;border-width:3px 0 0 3px;border-radius:14px 0 0 0}.scanner-frame i:nth-child(2){right:0;top:0;border-width:3px 3px 0 0;border-radius:0 14px 0 0}.scanner-frame i:nth-child(3){left:0;bottom:0;border-width:0 0 3px 3px;border-radius:0 0 0 14px}.scanner-frame i:nth-child(4){right:0;bottom:0;border-width:0 3px 3px 0;border-radius:0 0 14px 0}.scanner-frame span{position:absolute;left:8%;right:8%;top:50%;height:2px;background:linear-gradient(90deg,transparent,#74f1d0,transparent);box-shadow:0 0 18px rgba(77,255,210,.8);animation:scanline 2.1s ease-in-out infinite}@keyframes scanline{0%,100%{transform:translateY(-74px);opacity:.45}50%{transform:translateY(74px);opacity:1}}
.scanner-manual{display:flex;gap:8px;margin-top:12px}.scanner-manual input{flex:1;height:48px;border:1px solid #dfe4ec;border-radius:16px;padding:0 14px;background:#fff;font-size:14px;outline:none}.scanner-manual button{height:48px;padding:0 16px;border:0;border-radius:16px;background:#111722;color:#fff;font-weight:800}
.card{border-radius:0!important}.card-top{left:10px!important;right:10px!important;top:10px!important}.card-icons{gap:8px!important}.card-flag{background:transparent!important;border:0!important;padding:0!important;box-shadow:none!important;font-size:21px!important}.card-save{background:transparent!important;border:0!important;outline:0!important;box-shadow:none!important;font-size:25px!important}.card-bottom{left:10px!important;right:10px!important;bottom:10px!important}.card-title-row{align-items:flex-end!important}.card-title-wrap{min-width:0}.card-title-wrap h3{font-size:15px!important}.card-provider{font-size:11px!important;margin-top:4px!important}.card-price{font-size:17px!important}.card-meta{margin-top:9px!important;padding-right:70px!important;gap:5px!important}.card-meta span{font-size:9px!important;padding:5px 8px!important}.card-view{position:absolute!important;right:0!important;bottom:0!important;margin:0!important;height:26px!important;min-width:54px!important;padding:0 11px!important;border-radius:999px!important;background:transparent!important;color:#fff!important;border:1px solid rgba(255,255,255,.76)!important;font-size:10px!important;box-shadow:none!important}
.products-footer{padding:14px 0 8px}.view-all-bottom{height:38px!important;font-size:12px!important;padding:0 18px!important}
.travel-tool-tabs{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:10px!important}.travel-tool-tab{min-height:104px!important;padding:13px 10px!important;align-items:center!important;text-align:center!important}.travel-tool-tab .tab-icon{width:44px!important;height:44px!important;border-radius:14px!important;font-size:18px!important}.travel-tool-tab>span:last-child{font-size:12px!important;line-height:1.15!important}
.steps-modern-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}.step-modern{border-radius:20px!important}
.sort-pill{position:relative}.sort-pill::after{content:"";position:absolute;inset:-1px;border-radius:999px;pointer-events:none;box-shadow:inset 0 1px 0 rgba(255,255,255,.9)}
@media(max-width:768px){.filter-toggle-grid{grid-template-columns:1fr}.travel-showcase-shell{padding:14px!important}.travel-tool-tabs{gap:6px!important}.travel-tool-tab{min-height:86px!important;padding:10px 6px!important;border-radius:18px!important}.travel-tool-tab .tab-icon{width:38px!important;height:38px!important;border-radius:12px!important;font-size:16px!important}.travel-tool-tab>span:last-child{font-size:9px!important}.steps-modern-grid{display:flex!important;overflow-x:auto;gap:10px!important;scroll-snap-type:x mandatory;padding-bottom:4px}.step-modern{flex:0 0 72%;min-height:176px!important;scroll-snap-align:start}.products-toolbar{gap:8px!important}.products-actions{width:auto!important;margin-left:auto!important}.sort-pill{width:auto!important;min-width:188px!important;max-width:205px!important}.products-meta{min-width:0}.products-meta p{white-space:nowrap}.scanner-stage,.scanner-stage video{min-height:230px}.sheet-grid{grid-template-columns:1fr!important}}


.legacy-how{display:none!important}
.inline-tool-panel.active{animation:inlineToolIn .22s cubic-bezier(.2,.8,.2,1)}
@keyframes inlineToolIn{from{opacity:.2;transform:translateY(7px)}to{opacity:1;transform:none}}

/* ===== V4 COMPACT APP UX + SOCIAL SHARE CARD ===== */
.travel-tools-showcase{padding-top:12px!important}
.travel-showcase-shell{padding:16px!important;border-radius:22px!important;background:linear-gradient(180deg,#f7f9fc,#fff)!important;box-shadow:0 10px 26px rgba(18,24,36,.045)!important}
.travel-showcase-shell::before{width:150px!important;height:92px!important;right:-24px!important;top:-12px!important;border-radius:20px!important;opacity:.72!important}
.travel-showcase-hero h2{font-size:24px!important}.travel-showcase-hero p{font-size:12px!important;margin-top:2px!important}
.travel-tool-tabs{display:flex!important;gap:9px!important;overflow-x:auto!important;scrollbar-width:none!important;margin-top:14px!important;padding-bottom:2px!important}.travel-tool-tabs::-webkit-scrollbar{display:none!important}
.travel-tool-tab{flex:0 0 112px!important;min-height:84px!important;border-radius:18px!important;padding:11px!important;gap:9px!important;font-size:11px!important;justify-content:flex-start!important;align-items:flex-start!important}
.tab-icon,.inline-tool-icon{width:38px!important;height:38px!important;border-radius:12px!important;font-size:17px!important;box-shadow:none!important}
.inline-tool-panel{margin-top:12px!important;padding:14px!important;border-radius:20px!important;box-shadow:none!important}
.inline-tool-header{margin-bottom:12px!important;align-items:center!important;flex-direction:row!important}.inline-tool-title{gap:10px!important;align-items:center!important}.inline-tool-title h3{font-size:18px!important}.inline-tool-title p{font-size:11px!important;margin-top:2px!important}.inline-currency-select{height:40px!important;padding:0 10px!important;font-size:12px!important;margin-left:auto!important;align-self:auto!important}
.inline-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}.inline-tool-grid.single{grid-template-columns:minmax(0,1fr)!important}
.inline-field,.inline-toggle-card{min-height:66px!important;border-radius:16px!important;padding:10px 11px!important}.inline-field span{font-size:9px!important;margin-bottom:3px!important}.inline-field-row{gap:8px!important}.inline-field-row i{width:30px!important;height:30px!important;border-radius:10px!important;font-size:14px!important}.inline-field input,.inline-field select{font-size:13px!important}.inline-toggle-card strong{font-size:12px!important}.inline-toggle-card small{font-size:9px!important;margin-top:2px!important}.switch{width:48px!important;height:28px!important}.switch i::after{width:22px!important;height:22px!important;left:3px!important;top:3px!important}.switch input:checked + i::after{transform:translateX(20px)!important}
.inline-primary-btn,.inline-secondary-btn{height:44px!important;font-size:12px!important;padding:0 17px!important}.inline-primary-btn{margin-top:10px!important;box-shadow:none!important}.inline-result-card{margin-top:10px!important;border-radius:16px!important;padding:13px!important}.inline-result-card h4{font-size:13px!important;margin-bottom:4px!important}.inline-result-card .big-result{font-size:32px!important;margin:4px 0 10px!important}.inline-result-card .mini-grid{gap:7px!important}.inline-result-card .mini-grid div{padding:9px!important;border-radius:12px!important}.inline-result-card .mini-grid small{font-size:8px!important}.inline-result-card .mini-grid strong{font-size:11px!important}

/* advice becomes compact app cards, not a landing page */
.inline-advice-list{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important;margin-top:10px!important}.inline-advice-item{padding:12px!important;border-radius:16px!important;min-height:116px!important}.inline-advice-item h5{font-size:13px!important;margin-bottom:5px!important}.inline-advice-item p{font-size:10px!important;line-height:1.45!important;color:#707988!important}

/* social card should feel like a shareable story/post, not shopping UI */
.trip-card-preview{min-height:330px!important;border-radius:28px!important;padding:20px!important;background:linear-gradient(150deg,#ff6b9c 0%,#ff9466 28%,#7b61ff 62%,#2d9cff 100%)!important;box-shadow:0 18px 38px rgba(92,76,190,.22)!important;position:relative!important;overflow:hidden!important;color:#fff!important;border:0!important}
.trip-card-preview::before{content:""!important;position:absolute!important;inset:0!important;background:radial-gradient(circle at 78% 10%,rgba(255,255,255,.35),transparent 22%),radial-gradient(circle at 15% 82%,rgba(255,230,100,.28),transparent 27%),linear-gradient(180deg,transparent,rgba(20,13,65,.22))!important;pointer-events:none!important}
.trip-card-preview::after{content:""!important;position:absolute!important;right:-50px!important;bottom:-65px!important;width:220px!important;height:220px!important;border-radius:48% 52% 45% 55%!important;background:rgba(255,255,255,.13)!important;transform:rotate(25deg)!important}
.share-sky{position:absolute;left:-20px;top:70px;width:135%;height:90px;opacity:.15;background:repeating-linear-gradient(12deg,transparent 0 18px,rgba(255,255,255,.7) 20px 22px)}
.share-sticker{position:absolute;z-index:2;width:44px;height:44px;border-radius:14px;background:#fff;display:grid;place-items:center;font-size:23px;box-shadow:0 10px 20px rgba(45,30,100,.18);transform:rotate(-8deg)}.sticker-1{right:18px;top:18px}.sticker-2{right:76px;top:72px;transform:rotate(9deg)}.sticker-3{left:18px;bottom:72px;transform:rotate(-4deg)}
.trip-card-brand{position:relative!important;z-index:2!important;font-size:10px!important;font-weight:900!important;letter-spacing:.14em!important;text-transform:uppercase!important;background:rgba(255,255,255,.19)!important;display:inline-flex!important;padding:7px 10px!important;border-radius:999px!important;backdrop-filter:blur(10px)!important}.trip-card-kicker{position:relative;z-index:2;margin-top:23px;font-size:12px;font-weight:700;color:rgba(255,255,255,.86)}
.trip-card-preview h4{position:relative!important;z-index:2!important;margin:3px 0 0!important;font-size:52px!important;line-height:.9!important;letter-spacing:-.06em!important;font-weight:950!important;text-shadow:0 6px 24px rgba(56,23,104,.18)!important}.trip-fun-line{position:relative;z-index:2;font-size:14px;font-weight:800;margin-top:8px;transform:rotate(-1deg)}
.trip-stat-row{position:absolute;z-index:2;left:20px;right:20px;bottom:46px;display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.trip-stat-row span{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.24);border-radius:16px;padding:10px 8px;backdrop-filter:blur(14px)}.trip-stat-row b{display:block;font-size:15px}.trip-stat-row small{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.78);margin-top:2px}.trip-card-preview>p{display:none!important}.share-footer{position:absolute;left:20px;right:20px;bottom:14px;display:flex;justify-content:space-between;z-index:2;font-size:9px;font-weight:700;color:rgba(255,255,255,.8)}
#inline-tool-card .inline-tool-grid{margin-top:10px!important}#inline-tool-card .inline-actions-row{margin-top:10px!important;gap:8px!important}

/* Buy in three steps: compact horizontal app cards */
.steps-modern{padding-top:16px!important}.steps-modern-head{margin-bottom:10px!important;flex-direction:row!important;align-items:flex-end!important}.steps-modern-head h2{font-size:24px!important}.steps-modern-head p{font-size:11px!important}.steps-modern-head a{font-size:11px!important}
.steps-modern-grid{display:flex!important;gap:9px!important;overflow-x:auto!important;scrollbar-width:none!important;padding-bottom:3px!important}.steps-modern-grid::-webkit-scrollbar{display:none!important}.step-modern{flex:0 0 188px!important;min-height:142px!important;border-radius:18px!important;padding:13px!important;box-shadow:none!important}.step-modern-num{width:31px!important;height:31px!important;font-size:13px!important;margin-bottom:34px!important}.step-modern-emoji{right:10px!important;top:9px!important;font-size:42px!important}.step-modern h4{font-size:17px!important;margin-bottom:6px!important}.step-modern p{font-size:11px!important;line-height:1.35!important}

/* make legacy/other sections more consistent instead of huge landing blocks */
#destinations,#regions,#how,#guides{padding-top:18px!important}.section-head h2{font-size:22px!important}.section-head p{font-size:11px!important}.collection-grid{max-height:340px!important}.collection{min-height:70px!important;padding:11px!important}.region-card{min-width:190px!important;aspect-ratio:1.4!important}.steps{gap:10px!important}.step{min-height:160px!important;padding:14px!important}.step b{font-size:17px!important}.step span{font-size:11px!important}

@media(max-width:700px){
 .travel-showcase-shell{margin-left:-6px!important;margin-right:-6px!important;padding:14px!important}.travel-showcase-shell::before{display:none!important}.travel-showcase-hero h2{font-size:22px!important}
 .travel-tool-tab{flex-basis:104px!important;min-height:78px!important;padding:10px!important}.tab-icon{width:34px!important;height:34px!important;font-size:15px!important}
 .inline-tool-panel{padding:12px!important}.inline-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}.inline-field,.inline-toggle-card{min-height:64px!important;padding:9px!important}.inline-field-row i{width:28px!important;height:28px!important}.inline-primary-btn,.inline-secondary-btn{height:42px!important}
 .inline-advice-list{grid-template-columns:repeat(2,minmax(0,1fr))!important}.inline-advice-item{min-height:110px!important;padding:11px!important}.inline-advice-item p{font-size:9.5px!important}
 .trip-card-preview{min-height:310px!important;padding:18px!important;border-radius:24px!important}.trip-card-preview h4{font-size:46px!important}.trip-stat-row{left:18px!important;right:18px!important;bottom:44px!important}.trip-stat-row b{font-size:13px!important}.trip-stat-row small{font-size:7px!important}
 .step-modern{flex-basis:166px!important;min-height:132px!important}.step-modern h4{font-size:15px!important}.step-modern p{font-size:10px!important}
}


/* ==========================================================
   FINAL V5 UI/UX PASS - compact consumer app, mobile first
   ========================================================== */
:root{--v5-bg:#f6f8fb;--v5-card:#fff;--v5-line:#e7eaf0;--v5-text:#11151d;--v5-muted:#858d99;--v5-dark:#0d1119;--v5-blue:#5d85ff}
html{scroll-behavior:smooth}
body{background:linear-gradient(180deg,#f6f8fc 0,#fff 280px,#fff 100%);color:var(--v5-text)}
header{background:rgba(248,250,253,.92)!important;backdrop-filter:blur(24px)!important;-webkit-backdrop-filter:blur(24px)!important;border-bottom:1px solid rgba(224,228,235,.9)!important}
main{overflow:hidden}
.section{margin-top:0!important}
.section-head{margin-bottom:12px!important}
.section-head h2{font-size:22px!important;letter-spacing:-.045em!important}
.section-head p{font-size:11px!important;color:#9299a5!important}

/* top shop controls */
.app-searchbox{height:58px!important;border-radius:20px!important;padding:0 8px 0 14px!important;background:rgba(255,255,255,.96)!important;box-shadow:0 8px 22px rgba(31,44,68,.045)!important}
.app-searchbox input{height:56px!important;font-size:16px!important}
.app-search-btn{width:44px!important;height:44px!important;border-radius:15px!important;background:#fff!important;border:1px solid #e2e6ed!important}
.provider-carousel{gap:12px!important;margin-top:10px!important;padding-bottom:2px!important}
.story{width:76px!important}
.story-ring{width:72px!important;height:72px!important}
.story-core{font-size:12px!important}
.categories{padding:7px 0 10px!important;gap:8px!important}
.cat{height:40px!important;padding:0 17px!important;border-radius:999px!important;font-size:12px!important;white-space:nowrap!important}
.filter-fab{width:40px!important;height:40px!important;position:relative!important}
.filter-fab.filter-active::after{content:attr(data-count);position:absolute;right:-3px;top:-4px;min-width:16px;height:16px;padding:0 4px;border-radius:99px;background:#111;color:#fff;font-size:9px;font-weight:900;display:grid;place-items:center}

/* toolbar */
.products-toolbar{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;align-items:center!important;gap:10px!important;margin:8px 0 10px!important}
.products-meta p{font-size:12px!important;color:#7f8793!important;font-weight:700!important}
.products-actions{width:auto!important;display:flex!important;align-items:center!important;gap:8px!important}
.sort-pill{height:40px!important;min-width:175px!important;max-width:190px!important;padding:0 12px!important;border-radius:999px!important;background:#fff!important;border:1px solid #e0e4eb!important;box-shadow:none!important}
.sort-pill select{font-size:12px!important;font-weight:850!important;color:#2b3340!important}
.products-viewall{display:none!important}

/* eSIM cards - preserve square tile form */
.grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:2px!important}
.card{aspect-ratio:.72!important;border-radius:0!important;border:0!important;box-shadow:none!important;background:#ddd!important;overflow:hidden!important}
.card::after{background:linear-gradient(180deg,rgba(7,10,15,.01) 12%,rgba(7,10,15,.06) 44%,rgba(7,10,15,.88) 100%)!important}
.card-top{left:10px!important;right:10px!important;top:10px!important;align-items:flex-start!important}
.card-badge{height:26px!important;padding:0 10px!important;border-radius:999px!important;font-size:8px!important;letter-spacing:.16em!important}
.card-icons{gap:7px!important;align-items:center!important}
.card-flag{font-size:20px!important;background:transparent!important;padding:0!important;border:0!important;box-shadow:none!important;filter:none!important;text-shadow:0 2px 8px rgba(0,0,0,.22)!important}
.card-save{width:auto!important;height:auto!important;border:0!important;background:transparent!important;padding:0!important;font-size:25px!important;color:#fff!important;text-shadow:0 2px 10px rgba(0,0,0,.34)!important}
.card-bottom{left:10px!important;right:10px!important;bottom:9px!important}
.card-title-row{align-items:flex-end!important;gap:8px!important}
.card-title-wrap{min-width:0!important}
.card-title-wrap h3{font-size:14px!important;line-height:1.05!important;letter-spacing:-.02em!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;max-width:120px!important}
.card-provider{font-size:10px!important;margin-top:4px!important;color:rgba(255,255,255,.78)!important}
.card-price{font-size:14px!important;line-height:1!important}
.card-meta{gap:4px!important;margin-top:7px!important;padding-right:54px!important}
.card-meta span{font-size:8px!important;padding:4px 6px!important;background:rgba(8,10,15,.34)!important;border:1px solid rgba(255,255,255,.18)!important}
.card-view{position:absolute!important;right:0!important;bottom:0!important;margin:0!important;height:24px!important;min-width:48px!important;padding:0 9px!important;border-radius:999px!important;background:transparent!important;color:#fff!important;border:1px solid rgba(255,255,255,.58)!important;font-size:9px!important;box-shadow:none!important}
.products-footer{padding:12px 0 0!important}
.view-all-bottom{height:38px!important;padding:0 18px!important;font-size:12px!important;border-radius:999px!important;background:#fff!important;border:1px solid #dfe3e9!important;box-shadow:none!important}

/* Travel tools container - app module, not landing page */
.travel-tools-showcase{padding:18px 10px 0!important}
.travel-showcase-shell{padding:14px!important;border-radius:22px!important;background:linear-gradient(180deg,#fafbfe,#f6f8fc)!important;border:1px solid #e7eaf0!important;box-shadow:none!important;overflow:hidden!important}
.travel-showcase-shell::before{display:none!important}
.travel-showcase-hero{align-items:center!important;margin-bottom:10px!important}
.travel-showcase-hero h2{font-size:22px!important;line-height:1!important;letter-spacing:-.05em!important}
.travel-showcase-hero p{font-size:10px!important;margin-top:4px!important;color:#8d95a2!important}
.travel-tool-tabs{display:flex!important;gap:8px!important;overflow-x:auto!important;scrollbar-width:none!important;margin-top:10px!important;padding:1px 1px 3px!important;scroll-snap-type:x mandatory!important}
.travel-tool-tabs::-webkit-scrollbar{display:none!important}
.travel-tool-tab{flex:0 0 88px!important;min-height:78px!important;border-radius:18px!important;padding:9px 8px!important;justify-content:center!important;align-items:center!important;gap:7px!important;text-align:center!important;scroll-snap-align:start!important;background:#fff!important;border:1px solid #e4e8ef!important;box-shadow:none!important;font-size:9px!important;line-height:1.05!important}
.travel-tool-tab.active{border-color:#9ebefc!important;box-shadow:0 0 0 2px rgba(93,133,255,.08)!important}
.travel-tool-tab .tab-icon{width:34px!important;height:34px!important;border-radius:11px!important;font-size:15px!important;box-shadow:none!important}
.travel-tool-tab>span:last-child{font-size:9px!important;font-weight:850!important;max-width:72px!important}
.inline-tool-panel{margin-top:10px!important;padding:12px!important;border-radius:20px!important;background:#fff!important;border:1px solid #e4e8ef!important;box-shadow:none!important}
.inline-tool-header{display:flex!important;align-items:center!important;gap:10px!important;margin-bottom:10px!important;flex-direction:row!important}
.inline-tool-title{display:flex!important;align-items:center!important;gap:9px!important;min-width:0!important}
.inline-tool-icon{width:36px!important;height:36px!important;border-radius:12px!important;font-size:16px!important;box-shadow:none!important;flex:0 0 auto!important}
.inline-tool-title h3{font-size:16px!important;letter-spacing:-.035em!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
.inline-tool-title p{font-size:9px!important;line-height:1.2!important;margin-top:2px!important;color:#929aa6!important}
.inline-currency-select{height:36px!important;margin-left:auto!important;padding:0 9px!important;font-size:10px!important;border-radius:999px!important;flex:0 0 auto!important}
.inline-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important}
.inline-tool-grid.single{grid-template-columns:minmax(0,1fr)!important}
.inline-field,.inline-toggle-card{min-height:62px!important;border-radius:16px!important;padding:8px 9px!important;background:#fbfcfe!important;border:1px solid #e7eaf0!important}
.inline-field span{font-size:9px!important;margin-bottom:4px!important;color:#7f8793!important}
.inline-field-row{gap:7px!important}
.inline-field-row i{width:28px!important;height:28px!important;border-radius:9px!important;font-size:14px!important;background:#f1f4f9!important}
.inline-field input,.inline-field select{font-size:13px!important;font-weight:850!important}
.inline-toggle-card strong{font-size:11px!important}.inline-toggle-card small{font-size:8px!important;margin-top:2px!important}
.inline-toggle-card .switch{width:44px!important;height:26px!important}.inline-toggle-card .switch i::after{width:20px!important;height:20px!important;left:3px!important;top:3px!important}.inline-toggle-card .switch input:checked + i::after{transform:translateX(18px)!important}
.inline-primary-btn,.inline-secondary-btn{height:42px!important;border-radius:999px!important;padding:0 18px!important;font-size:12px!important;font-weight:900!important}
.inline-primary-btn{margin-top:10px!important;background:linear-gradient(90deg,#0b101b,#203c62 62%,#5f86c4)!important;box-shadow:none!important}
.inline-actions-row{margin-top:9px!important;gap:7px!important}
.inline-result-card{margin-top:9px!important;border-radius:16px!important;padding:10px!important;background:#f8fafe!important;border:1px solid #e7eaf0!important}
.inline-result-card h4{font-size:11px!important;margin-bottom:3px!important;color:#596271!important}.inline-result-card .big-result{font-size:26px!important;margin:2px 0 8px!important}
.inline-result-card .mini-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:5px!important}.inline-result-card .mini-grid div{padding:7px!important;border-radius:10px!important;background:#fff!important}.inline-result-card .mini-grid small{font-size:7px!important}.inline-result-card .mini-grid strong{font-size:9px!important}

/* Advice - visual compact tiles */
.inline-advice-list{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important;margin-top:9px!important}
.inline-advice-item{min-height:100px!important;padding:10px!important;border-radius:16px!important;background:#fbfcfe!important;border:1px solid #e7eaf0!important;position:relative!important;overflow:hidden!important}
.inline-advice-item::before{content:"✦";position:absolute;right:9px;top:8px;font-size:13px;color:#72d8b2!important}
.inline-advice-item h5{font-size:11px!important;margin:0 0 5px!important;padding-right:18px!important}.inline-advice-item p{font-size:9px!important;line-height:1.38!important;color:#737c89!important}

/* social card: playful, share-first */
#inline-tool-card .inline-tool-header{margin-bottom:8px!important}
.social-card-controls{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;margin:0 0 8px}.social-card-controls::-webkit-scrollbar{display:none}.social-vibe{height:28px;padding:0 10px;border-radius:999px;border:1px solid #e1e5ec;background:#fff;font-size:9px;font-weight:850;white-space:nowrap}.social-vibe.active{background:#121722;color:#fff;border-color:#121722}
.trip-card-preview{aspect-ratio:4/5!important;min-height:0!important;max-height:370px!important;border-radius:24px!important;padding:18px!important;background:linear-gradient(145deg,#ff7b9f 0%,#ff9f61 28%,#8064ff 62%,#3ca5ff 100%)!important;box-shadow:none!important;border:0!important;position:relative!important;overflow:hidden!important;color:#fff!important}
.trip-card-preview.theme-tokyo{background:linear-gradient(145deg,#ff4e91 0%,#ff8661 24%,#6a5cff 60%,#31a7ff 100%)!important}
.trip-card-preview.theme-sunset{background:linear-gradient(145deg,#ff5f6d 0%,#ffc371 48%,#7b61ff 100%)!important}
.trip-card-preview.theme-night{background:linear-gradient(145deg,#0a1022 0%,#24285b 48%,#7b61ff 100%)!important}
.trip-card-preview::before{content:""!important;position:absolute!important;inset:0!important;background:radial-gradient(circle at 78% 9%,rgba(255,255,255,.34),transparent 20%),radial-gradient(circle at 14% 82%,rgba(255,235,135,.34),transparent 25%)!important}
.trip-card-preview::after{content:"✈️"!important;right:18px!important;bottom:18px!important;width:auto!important;height:auto!important;background:none!important;font-size:34px!important;transform:rotate(8deg)!important;opacity:.95!important}
.trip-card-brand{font-size:8px!important;padding:6px 8px!important;border-radius:999px!important;background:rgba(255,255,255,.18)!important}
.trip-card-kicker{font-size:10px!important;margin-top:18px!important}.trip-card-preview h4{font-size:42px!important;margin:3px 0 0!important;line-height:.9!important}.trip-fun-line{font-size:11px!important;margin-top:6px!important}
.trip-stickers{position:absolute;right:14px;top:64px;display:flex;flex-direction:column;gap:5px;z-index:3}.trip-sticker{display:inline-flex;align-items:center;justify-content:center;padding:5px 8px;border-radius:999px;background:rgba(255,255,255,.22);backdrop-filter:blur(12px);font-size:11px;transform:rotate(3deg)}.trip-sticker:nth-child(2){transform:rotate(-5deg)}
.trip-stat-row{left:16px!important;right:16px!important;bottom:42px!important;gap:5px!important}.trip-stat-row span{padding:7px 6px!important;border-radius:12px!important}.trip-stat-row b{font-size:11px!important}.trip-stat-row small{font-size:6px!important}.share-footer{left:16px!important;right:16px!important;bottom:13px!important;font-size:7px!important}

/* Buy in three steps - single compact horizontal strip */
.steps-modern{padding:16px 14px 0!important}
.steps-modern-head{margin-bottom:9px!important;display:flex!important;align-items:flex-end!important;justify-content:space-between!important;flex-direction:row!important}
.steps-modern-head h2{font-size:21px!important;letter-spacing:-.045em!important}.steps-modern-head p{font-size:9px!important}.steps-modern-head a{font-size:9px!important}
.steps-modern-grid{display:flex!important;gap:8px!important;overflow-x:auto!important;scrollbar-width:none!important;padding:0 0 2px!important;scroll-snap-type:x mandatory!important}.steps-modern-grid::-webkit-scrollbar{display:none!important}
.step-modern{flex:0 0 160px!important;min-height:126px!important;border-radius:18px!important;padding:11px!important;scroll-snap-align:start!important;box-shadow:none!important}
.step-modern-num{width:28px!important;height:28px!important;font-size:12px!important;margin-bottom:28px!important}.step-modern-emoji{font-size:34px!important;right:8px!important;top:9px!important}.step-modern h4{font-size:15px!important;margin:0 0 5px!important}.step-modern p{font-size:9px!important;line-height:1.3!important}

/* destinations / regions */
#destinations,#regions,#guides{padding:16px 14px 0!important}
.collection-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px!important;max-height:320px!important;padding-right:2px!important}
.collection{min-height:62px!important;padding:8px 9px!important;gap:8px!important;background:#fff!important;border:1px solid #e7eaf0!important;box-shadow:none!important;border-radius:0!important}.collection .flag-chip{font-size:24px!important}.collection .dest-name{font-size:11px!important}.collection .dest-sub{font-size:7px!important;letter-spacing:.06em!important}
.regional-track{gap:6px!important}.region-card{flex:0 0 68%!important;min-width:210px!important;aspect-ratio:1.65!important;border-radius:0!important;border:0!important;box-shadow:none!important}.region-copy strong{font-size:17px!important}.region-copy small{font-size:9px!important}

/* sheets */
.filter-sheet,.scanner-sheet{border-radius:28px 28px 0 0!important;padding:14px!important;background:rgba(250,251,253,.99)!important;max-height:86vh!important}
.filter-sheet h3,.scanner-sheet h3{font-size:21px!important}.scanner-sheet p{font-size:10px!important}
.sheet-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important;margin-top:12px!important}.sheet-field{gap:5px!important;font-size:9px!important}.sheet-field select{height:44px!important;border-radius:14px!important;font-size:11px!important;padding:0 10px!important}
.filter-toggle-grid{gap:7px!important}.filter-toggle{min-height:48px!important;border-radius:14px!important;padding:9px!important}.filter-toggle strong{font-size:10px!important}.filter-toggle small{font-size:8px!important}
.scanner-stage{border-radius:20px!important;min-height:230px!important;background:#0c1119!important;position:relative!important;overflow:hidden!important}.scanner-stage::before,.scanner-stage::after{content:"";position:absolute;inset:18px;border:2px solid rgba(255,255,255,.85);border-left-color:transparent;border-right-color:transparent;border-radius:18px;pointer-events:none}.scanner-stage::after{inset:18px;border-top-color:transparent;border-bottom-color:transparent;border-left-color:rgba(255,255,255,.85);border-right-color:rgba(255,255,255,.85)}
.scanner-status{font-size:10px!important;border-radius:14px!important;padding:10px!important}.manual-scan{display:flex;gap:7px;margin-top:8px}.manual-scan input{flex:1;height:42px;border-radius:14px;border:1px solid #e1e5ec;padding:0 12px;font-size:11px}.manual-scan button{height:42px;border-radius:14px;border:0;background:#111722;color:#fff;font-size:10px;font-weight:850;padding:0 14px}

@media(max-width:430px){
  .wrap{padding-left:14px!important;padding-right:14px!important}
  .brand{font-size:23px!important}.mainnav{gap:16px!important}.mainnav a{font-size:13px!important}
  .story{width:72px!important}.story-ring{width:68px!important;height:68px!important}
  .products-toolbar{grid-template-columns:minmax(0,1fr) 176px!important}
  .sort-pill{min-width:176px!important;max-width:176px!important}
  .card-title-wrap h3{max-width:112px!important}
  .travel-tools-showcase{padding-left:8px!important;padding-right:8px!important}
  .travel-tool-tab{flex-basis:82px!important}
  .inline-tool-title h3{font-size:15px!important}
  .inline-result-card .mini-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .trip-card-preview{max-height:340px!important}
  .sheet-grid{grid-template-columns:1fr!important}
}


/* ===== V6 FINAL COMPACT MOBILE UX ===== */
.travel-tools-showcase{padding:14px 12px 0!important}
.travel-showcase-shell{padding:0!important;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important}
.travel-showcase-shell::before{display:none!important}
.travel-showcase-hero{padding:0 2px 8px!important}
.travel-showcase-hero h2{font-size:25px!important;line-height:1!important;letter-spacing:-.05em!important;margin:0!important}
.travel-showcase-hero p{font-size:11px!important;margin:5px 0 0!important;color:#8f97a4!important}
.travel-tool-tabs{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:7px!important;overflow:visible!important;margin:8px 0 10px!important;padding:0!important}
.travel-tool-tab{min-width:0!important;min-height:82px!important;padding:9px 5px!important;border-radius:18px!important;border:1px solid #e2e6ec!important;background:#fff!important;box-shadow:none!important;align-items:center!important;justify-content:center!important;gap:8px!important;text-align:center!important}
.travel-tool-tab.active{border-color:#8ab7fb!important;box-shadow:0 0 0 2px rgba(80,143,240,.10)!important;background:#fbfdff!important}
.travel-tool-tab .tab-icon{width:36px!important;height:36px!important;border-radius:12px!important;font-size:16px!important;margin:0!important}
.travel-tool-tab>span:last-child{font-size:9px!important;line-height:1.02!important;font-weight:800!important;max-width:70px!important}
.inline-tool-panel{margin:0!important;padding:12px!important;border-radius:20px!important;border:1px solid #e4e8ef!important;background:#fff!important;box-shadow:none!important}
.inline-tool-header{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;margin:0 0 10px!important;flex-direction:row!important}
.inline-tool-title{display:flex!important;align-items:center!important;gap:10px!important;min-width:0!important}
.inline-tool-title .inline-tool-icon{width:40px!important;height:40px!important;border-radius:13px!important;flex:0 0 auto!important;font-size:18px!important}
.inline-tool-title h3{font-size:17px!important;line-height:1.05!important;margin:0!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
.inline-tool-title p{font-size:9.5px!important;margin:3px 0 0!important;color:#9299a5!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;max-width:180px!important}
.inline-currency-select{height:38px!important;padding:0 10px!important;border-radius:999px!important;font-size:11px!important;flex:0 0 auto!important}
.inline-currency-select select{font-size:11px!important}
.inline-tool-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
.inline-tool-grid.single{grid-template-columns:1fr!important}
.inline-field,.inline-toggle-card{min-height:62px!important;border-radius:16px!important;padding:8px 9px!important;background:#fbfcfe!important;border:1px solid #e3e7ed!important;box-shadow:none!important}
.inline-field.wide{grid-column:auto!important}
.inline-field>span{font-size:9px!important;margin-bottom:5px!important;color:#7c8592!important;font-weight:700!important}
.inline-field-row{gap:7px!important;min-width:0!important}
.inline-field-row i{width:27px!important;height:27px!important;border-radius:9px!important;font-size:14px!important;flex:0 0 auto!important}
.inline-field-row input,.inline-field-row select{font-size:14px!important;line-height:1!important;font-weight:850!important;min-width:0!important}
.inline-field-row b{font-size:12px!important}
.inline-toggle-card{min-height:62px!important;padding:8px 10px!important}
.inline-toggle-card strong{font-size:11px!important;line-height:1.05!important}
.inline-toggle-card small{font-size:8.5px!important;line-height:1.18!important;margin-top:3px!important;max-width:105px!important}
.switch{width:45px!important;height:26px!important}.switch i::after{width:20px!important;height:20px!important;top:3px!important;left:3px!important}.switch input:checked + i::after{transform:translateX(19px)!important}
.inline-primary-btn,.inline-secondary-btn{height:42px!important;border-radius:999px!important;font-size:12px!important;padding:0 16px!important}
.inline-tool-panel>.inline-primary-btn{width:auto!important;min-width:170px!important;margin-top:10px!important}
.inline-result-card{margin-top:9px!important;padding:11px!important;border-radius:16px!important;background:#f7f9fc!important;border:1px solid #e2e6ed!important}
.inline-result-card h4{font-size:10px!important;margin:0 0 4px!important;color:#68717d!important;font-weight:700!important}
.inline-result-card .big-result{font-size:29px!important;line-height:1!important;margin:0 0 9px!important}
.inline-result-card .mini-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:5px!important}
.inline-result-card .mini-grid div{padding:7px!important;border-radius:11px!important;background:#fff!important;min-width:0!important}
.inline-result-card .mini-grid small{font-size:7px!important;margin-bottom:2px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
.inline-result-card .mini-grid strong{font-size:9px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;display:block!important}
#inline-tool-advisor .inline-result-card .big-result{font-size:27px!important}
.inline-advice-list{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important;margin-top:9px!important}
.inline-advice-item{min-height:86px!important;padding:10px!important;border-radius:15px!important;background:#fbfcfe!important;border:1px solid #e3e7ed!important;position:relative!important;overflow:hidden!important}
.inline-advice-item::after{content:'✦';position:absolute;right:9px;top:8px;color:#4bd7a3;font-size:12px}
.inline-advice-item h5{font-size:11px!important;margin:0 0 5px!important}
.inline-advice-item p{font-size:8.6px!important;line-height:1.38!important;color:#757e8a!important;margin:0!important;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
#inline-tool-advice>.inline-primary-btn{min-width:120px!important}
/* Social share card: story-like, compact, playful */
#inline-tool-card .inline-tool-header{margin-bottom:9px!important}
.trip-card-preview{aspect-ratio:4/5!important;min-height:0!important;max-height:300px!important;border-radius:22px!important;padding:16px!important;margin:0 auto 9px!important;background:linear-gradient(145deg,#ff477e 0%,#ff9167 25%,#775cff 60%,#2bb7ff 100%)!important;box-shadow:none!important;border:0!important;position:relative!important;overflow:hidden!important;color:#fff!important}
.trip-card-preview::before{content:''!important;position:absolute!important;inset:0!important;background:radial-gradient(circle at 78% 10%,rgba(255,255,255,.34),transparent 20%),radial-gradient(circle at 13% 83%,rgba(255,237,126,.30),transparent 25%),linear-gradient(180deg,transparent,rgba(34,18,93,.18))!important}
.trip-card-preview::after{content:'✈️'!important;position:absolute!important;right:17px!important;top:18px!important;width:auto!important;height:auto!important;background:none!important;font-size:31px!important;transform:rotate(10deg)!important;opacity:1!important}
.share-sticker{font-size:26px!important;filter:drop-shadow(0 7px 13px rgba(80,30,100,.15))!important}.sticker-1{display:none!important}.sticker-2{right:16px!important;top:84px!important}.sticker-3{left:16px!important;bottom:80px!important}
.trip-card-brand{position:relative!important;z-index:2!important;font-size:8px!important;letter-spacing:.17em!important;background:rgba(255,255,255,.15)!important;display:inline-flex!important;padding:7px 9px!important;border-radius:999px!important}
.trip-card-kicker{font-size:9px!important;margin-top:27px!important}.trip-card-preview h4{font-size:39px!important;margin:2px 0 0!important;line-height:.88!important}.trip-fun-line{font-size:10px!important;margin-top:6px!important}
.trip-stat-row{left:16px!important;right:16px!important;bottom:42px!important;gap:6px!important}.trip-stat-row span{padding:7px 6px!important;border-radius:12px!important}.trip-stat-row b{font-size:11px!important}.trip-stat-row small{font-size:6px!important}.share-footer{left:16px!important;right:16px!important;bottom:12px!important;font-size:7px!important}
#inline-tool-card .inline-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
#inline-tool-card .inline-field.wide{grid-column:auto!important}
.inline-actions-row{display:grid!important;grid-template-columns:1.2fr 1fr 1fr!important;gap:7px!important;margin-top:9px!important}
.inline-actions-row .inline-primary-btn,.inline-actions-row .inline-secondary-btn{margin:0!important;padding:0 8px!important;font-size:10px!important;height:40px!important;min-width:0!important}
/* 3 steps should fit, no chopped cards */
.steps-modern{padding:14px 12px 0!important}
.steps-modern-head{margin-bottom:8px!important;display:flex!important;flex-direction:row!important;align-items:flex-end!important;justify-content:space-between!important;gap:8px!important}
.steps-modern-head h2{font-size:20px!important;margin:0!important}.steps-modern-head p{font-size:9px!important;margin:3px 0 0!important}.steps-modern-head a{font-size:9px!important;white-space:nowrap!important}
.steps-modern-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:7px!important;overflow:visible!important;padding:0!important}
.step-modern{min-height:126px!important;border-radius:17px!important;padding:10px!important;box-shadow:none!important;overflow:hidden!important}
.step-modern-num{width:28px!important;height:28px!important;font-size:11px!important;margin-bottom:27px!important}.step-modern-emoji{right:7px!important;top:7px!important;font-size:31px!important}.step-modern h4{font-size:12px!important;line-height:1.08!important;margin:0 0 5px!important}.step-modern p{font-size:8.3px!important;line-height:1.28!important;margin:0!important}
/* compact following sections too */
#destinations,#regions{padding-top:14px!important}
#destinations .section-head h2,#regions .section-head h2{font-size:21px!important}.section-head p{font-size:10px!important}.section-head a{font-size:10px!important}
.collection-grid{gap:6px!important}.collection{min-height:72px!important;padding:9px 10px!important}.collection .flag-chip{font-size:24px!important}.collection strong{font-size:12px!important}.collection small{font-size:7px!important}
.regional-track{gap:8px!important}.region-card{min-width:150px!important;height:155px!important;border-radius:16px!important}.region-copy strong{font-size:14px!important}.region-copy small{font-size:9px!important}
/* prevent sticky header from hiding section anchors */
section[id]{scroll-margin-top:78px!important}
@media(max-width:420px){
 .travel-tools-showcase{padding-left:10px!important;padding-right:10px!important}
 .travel-tool-tab>span:last-child{font-size:8.4px!important}
 .inline-tool-title p{max-width:145px!important}
 .inline-result-card .mini-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
 .trip-card-preview{max-height:285px!important}
 .steps-modern{padding-left:10px!important;padding-right:10px!important}
 .step-modern{min-height:122px!important;padding:9px!important}.step-modern h4{font-size:11.5px!important}.step-modern p{font-size:7.8px!important}
}


/* === FINAL V7 coherent UI layer === */
.travel-tools-showcase{padding-top:18px!important;padding-bottom:8px!important}
.travel-showcase-shell{padding:16px!important;border-radius:24px!important;background:#f7f9fc!important;border:1px solid #e4e8ef!important;box-shadow:none!important;overflow:hidden!important}
.travel-showcase-shell::before{content:""!important;position:absolute!important;right:0!important;top:0!important;width:150px!important;height:84px!important;border-radius:0 24px 0 28px!important;opacity:.82!important;background:linear-gradient(90deg,rgba(247,249,252,.15),rgba(247,249,252,0)),url('https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=650&q=78') center/cover no-repeat!important}

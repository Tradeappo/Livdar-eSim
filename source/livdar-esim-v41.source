#travelToolsShowcase{max-width:1060px!important;margin:0 auto!important;padding:18px 16px 10px!important}
#travelToolsShowcase .travel-showcase-shell{position:relative!important;overflow:hidden!important;padding:24px 24px 26px!important;border-radius:30px!important;background:linear-gradient(180deg,#f8fbff 0%,#f6f9fd 100%)!important;border:1px solid #dfe7f0!important;box-shadow:0 18px 46px rgba(33,50,74,.08)!important}

<script id="v35-filter-icon-fix">
(function(){
  function fixFilterIcon(){
    var f=document.getElementById('filterFab');
    if(!f) return;
    var count=document.getElementById('filterCount');
    var countValue=count?count.textContent:'0';
    f.innerHTML=''
      +'<svg class="filter-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'
      +'<path d="M4 6h5"/><circle cx="12" cy="6" r="2"/><path d="M15 6h5"/>'
      +'<path d="M4 12h9"/><circle cx="16" cy="12" r="2"/><path d="M19 12h1"/>'
      +'<path d="M4 18h2"/><circle cx="9" cy="18" r="2"/><path d="M12 18h8"/>'
      +'</svg><b class="filter-count" id="filterCount">'+countValue+'</b>';
    f.setAttribute('aria-label','Filters');
    f.title='Filters';
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',fixFilterIcon);
  else fixFilterIcon();
  setTimeout(fixFilterIcon,100);
})();
</script>



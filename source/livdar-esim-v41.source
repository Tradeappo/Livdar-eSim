<script id="v33-final-hardfix-script">
(function(){
  function forceTopViewAllHidden(){
    var top=document.getElementById('viewAll');
    if(top) top.style.display='none';
    var bottom=document.getElementById('viewAllBottom');
    if(bottom) bottom.style.display='inline-flex';
  }

  function applyDistinctImages(){
    if(!Array.isArray(window.plans)) return;
    var scenicMap={
      'Japan':'https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=1000&q=86',
      'Thailand':'https://images.unsplash.com/photo-1508009603885-50cf7c579365?auto=format&fit=crop&w=1000&q=86',
      'Greece':'https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=1000&q=86',
      'Spain':'https://images.unsplash.com/photo-1543783207-ec64e4d95325?auto=format&fit=crop&w=1000&q=86',
      'United States':'https://images.unsplash.com/photo-1501594907352-04cda38ebc29?auto=format&fit=crop&w=1000&q=86',
      'United Arab Emirates':'https://images.unsplash.com/photo-1512453979798-5ea266f8880c?auto=format&fit=crop&w=1000&q=86',
      'France':'https://images.unsplash.com/photo-1522083165195-3424ed129620?auto=format&fit=crop&w=1000&q=86',
      'Turkey':'https://images.unsplash.com/photo-1524231757912-21f4fe3a7200?auto=format&fit=crop&w=1000&q=86',
      'Qatar':'https://images.unsplash.com/photo-1578895101408-1a36b834405b?auto=format&fit=crop&w=1000&q=86',
      'Croatia':'https://images.unsplash.com/photo-1555990538-17392d1ff6d0?auto=format&fit=crop&w=1000&q=86',
      'Latvia':'https://images.unsplash.com/photo-1506973035872-a4ec16b8e8d9?auto=format&fit=crop&w=1000&q=86'
    };
    window.plans.forEach(function(p){ if(scenicMap[p.name]) p.img = scenicMap[p.name]; });
  }

  var originalRender = window.render;
  if(typeof originalRender === 'function' && !window.__v33Patched){
    window.render = function(){
      applyDistinctImages();
      forceTopViewAllHidden();
      return originalRender.apply(this, arguments);
    };
    window.__v33Patched = true;
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', function(){
      applyDistinctImages();
      forceTopViewAllHidden();
      if(typeof window.render === 'function') window.render();
    });
  } else {
    applyDistinctImages();
    forceTopViewAllHidden();
    if(typeof window.render === 'function') window.render();
  }
})();
</script>


<style id="v34-card-lower-travel-bg">

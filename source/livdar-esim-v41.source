  height:178px !important;
  background-image:
    linear-gradient(90deg,rgba(248,251,255,.97) 0%,rgba(248,251,255,.86) 35%,rgba(248,251,255,.22) 68%,rgba(248,251,255,.02) 100%),
    url('livdar_travel_tools_banner.jpg') !important;
  background-size:cover !important;

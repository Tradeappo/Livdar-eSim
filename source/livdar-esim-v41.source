%22.55%22/%3E%0A%3C%21--%20pagoda%20--%3E%0A%3Cg%20transform%3D%22translate%28995%2026%29%22%20fill%3D%22%23d15f58%22%20stroke%3D%22%23b44944%22%20stroke-width%3D%223%22%3E%0A%20%3Cpath%20d%3D%22M0%2030h128l-18%2016H18Z%22/%3E%3Crect%20x%3D%2230%22%20y%3D%2246%22%20width%3D%2268%22%20height%3D%2234%22%20rx%3D%222%22%20fill%3D%22%23f5e9df%22/%3E%0A%20%3Cpath%20d%3D%22M5%2076h118l-16%2015H22Z%22/%3E%3Crect%20x%3D%2235%22%20y%3D%2291%22%20width%3D%2258%22%20height%3D%2230%22%20rx%3D%222%22%20fill%3D%22%23f5e9df%22/%3E%0A%20%3Cpath%20d%3D%22M13%20118h101l-14%2014H27Z%22/%3E%3Crect%20x%3D%2240%22%20y%3D%22132%22%20width%3D%2248%22%20height%3D%2226%22%20rx%3D%222%22%20fill%3D%22%23f5e9df%22/%3E%0A%20%3Cpath%20d%3D%22M22%20155h82l-12%2012H34Z%22/%3E%3Crect%20x%3D%2245%22%20y%3D%22167%22%20width%3D%2238%22%20height%3D%2230%22%20rx%3D%222%22%20fill%3D%22%23f5e9df%22/%3E%0A%3C/g%3E%0A%3C%21--%20cherry%20blossom%20--%3E%0A%3Cg%20fill%3D%22%23f5b7c9%22%20opacity%3D%22.75%22%3E%3Ccircle%20cx%3D%22890%22%20cy%3D%2260%22%20r%3D%227%22/%3E%3Ccircle%20cx%3D%22925%22%20cy%3D%2240%22%20r%3D%226%22/%3E%3Ccircle%20cx%3D%22960%22%20cy%3D%2278%22%20r%3D%227%22/%3E%3Ccircle%20cx%3D%22840%22%20cy%3D%2292%22%20r%3D%226%22/%3E%3Ccircle%20cx%3D%22790%22%20cy%3D%2255%22%20r%3D%225%22/%3E%3Ccircle%20cx%3D%221000%22%20cy%3D%22105%22%20r%3D%225%22/%3E%3C/g%3E%0A%3Cpath%20d%3D%22M740%200c50%2040%2084%2077%20115%20122%22%20fill%3D%22none%22%20stroke%3D%22%23c39a9f%22%20stroke-width%3D%224%22%20opacity%3D%22.5%22/%3E%0A%3C/svg%3E")!important;background-position:center!important;background-size:cover!important;background-repeat:no-repeat!important;opacity:1!important;pointer-events:none!important}
#travelToolsShowcase .travel-showcase-shell::after{content:""!important;position:absolute!important;left:0!important;right:0!important;top:132px!important;height:70px!important;background:linear-gradient(180deg,rgba(247,250,254,0),rgba(247,250,254,.98))!important;pointer-events:none!important}
#travelToolsShowcase .travel-showcase-hero{position:relative!important;z-index:2!important;min-height:104px!important;padding:0!important}
#travelToolsShowcase .travel-showcase-hero h2{font-size:34px!important;line-height:1!important;font-weight:950!important;letter-spacing:-.055em!important;margin:0!important;color:#11161e!important}
#travelToolsShowcase .travel-showcase-hero p{font-size:15px!important;margin:7px 0 0!important;color:#87919f!important}
#travelToolsShowcase .travel-tool-tabs{position:relative!important;z-index:3!important;display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:12px!important;margin:0 0 16px!important}
#travelToolsShowcase .travel-tool-tab{min-height:116px!important;padding:14px 9px!important;border-radius:24px!important;background:rgba(255,255,255,.96)!important;border:1px solid #e1e7ef!important;box-shadow:0 12px 30px rgba(37,51,72,.08),inset 0 1px 0 #fff!important;display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:11px!important;text-align:center!important;transition:.18s ease!important}
#travelToolsShowcase .travel-tool-tab.active{border-color:#68a8fa!important;box-shadow:0 0 0 2px rgba(93,160,248,.15),0 14px 34px rgba(35,83,145,.10)!important}
#travelToolsShowcase .travel-tool-tab>span:last-child{font-size:12px!important;line-height:1.05!important;font-weight:900!important;max-width:104px!important;color:#121820!important}
#travelToolsShowcase .tab-icon,#travelToolsShowcase .inline-tool-icon{position:relative!important;width:56px!important;height:56px!important;border-radius:18px!important;color:#fff!important;box-shadow:0 12px 24px rgba(43,65,100,.20),inset 0 1px 0 rgba(255,255,255,.35)!important;display:grid!important;place-items:center!important;overflow:hidden!important}
#travelToolsShowcase .tab-icon::before,#travelToolsShowcase .inline-tool-icon::before{content:""!important;position:absolute!important;inset:1px 1px auto 1px!important;height:48%!important;border-radius:17px 17px 40% 40%!important;background:linear-gradient(180deg,rgba(255,255,255,.28),rgba(255,255,255,0))!important;pointer-events:none!important}
#travelToolsShowcase .tab-icon svg,#travelToolsShowcase .inline-tool-icon svg{position:relative!important;z-index:1!important;width:31px!important;height:31px!important;color:#fff!important}
#travelToolsShowcase .tab-icon.cost,#travelToolsShowcase .inline-tool-icon.cost{background:linear-gradient(145deg,#79b2ff,#4f72ff)!important}
#travelToolsShowcase .tab-icon.advisor,#travelToolsShowcase .inline-tool-icon.advisor{background:linear-gradient(145deg,#c06cff,#8b52f4)!important}
#travelToolsShowcase .tab-icon.advice,#travelToolsShowcase .inline-tool-icon.advice{background:linear-gradient(145deg,#52e2b5,#27c68e)!important}
#travelToolsShowcase .tab-icon.card,#travelToolsShowcase .inline-tool-icon.card{background:linear-gradient(145deg,#ff9d89,#ff6f61)!important}

#travelToolsShowcase .inline-tool-panel{position:relative!important;z-index:3!important;margin:0!important;padding:18px!important;border-radius:25px!important;border:1px solid #e0e6ee!important;background:rgba(255,255,255,.97)!important;box-shadow:0 14px 34px rgba(32,48,70,.06)!important}
#travelToolsShowcase .inline-tool-header{margin-bottom:14px!important}
#travelToolsShowcase .inline-tool-title h3{font-size:20px!important;font-weight:950!important;letter-spacing:-.035em!important}
#travelToolsShowcase .inline-tool-title p{font-size:12px!important;color:#929ba7!important}
#travelToolsShowcase .inline-tool-grid{gap:11px!important}
#travelToolsShowcase .inline-field,#travelToolsShowcase .inline-toggle-card{min-height:76px!important;border-radius:20px!important;background:linear-gradient(180deg,#fff,#fbfcfe)!important;border:1px solid #dfe5ed!important}
#travelToolsShowcase #inlineCostBtn{width:100%!important;max-width:none!important;height:64px!important;margin:14px 0 0!important;border-radius:18px!important;background-image:url("data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%20900%20150%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%22%20x2%3D%221%22%3E%3Cstop%20stop-color%3D%22%23071425%22/%3E%3Cstop%20offset%3D%22.58%22%20stop-color%3D%22%2319385d%22/%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23669be0%22/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width%3D%22900%22%20height%3D%22150%22%20fill%3D%22url%28%23g%29%22/%3E%3Cpath%20d%3D%22M560%20150%20705%2055%20842%20150Z%22%20fill%3D%22%23263f5c%22%20opacity%3D%22.65%22/%3E%3Cpath%20d%3D%22m705%2055%2045%2031-19-3%208%2016-18-8-15%2018-13-18-22%207%2010-15-19%205Z%22%20fill%3D%22%23dbe9f7%22%20opacity%3D%22.82%22/%3E%3Cpath%20d%3D%22M742%2048c44%204%2086%2018%20120%2040%22%20fill%3D%22none%22%20stroke%3D%22%23aec9e8%22%20stroke-width%3D%223%22%20opacity%3D%22.6%22/%3E%3Ctext%20x%3D%22815%22%20y%3D%2244%22%20font-size%3D%2228%22%3E%E2%9C%88%3C/text%3E%3C/svg%3E")!important;background-size:cover!important;background-position:center!important;background-repeat:no-repeat!important;box-shadow:0 15px 28px rgba(20,49,84,.18)!important;font-size:15px!important;font-weight:950!important;letter-spacing:-.015em!important}
#travelToolsShowcase #inlineCostBtn::after{content:""!important}

/* Buy in three steps - match reference */
#how.steps-modern{max-width:1060px!important;margin:0 auto!important;padding:24px 16px 12px!important}
#how .steps-modern-head{display:flex!important;align-items:flex-end!important;justify-content:space-between!important;gap:16px!important;margin:0 0 16px!important}
#how .steps-modern-head h2{font-size:36px!important;line-height:1!important;font-weight:950!important;letter-spacing:-.055em!important;color:#11161e!important}
#how .steps-modern-head p{font-size:16px!important;margin:8px 0 0!important;color:#8c96a4!important}
#how .steps-modern-head a{font-size:15px!important;color:#5f9cec!important;font-weight:800!important}
#how .steps-modern-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:16px!important}
#how .step-modern{min-height:290px!important;padding:28px 28px 24px!important;border-radius:28px!important;border:1px solid #dfe5ed!important;box-shadow:0 12px 30px rgba(30,43,62,.05)!important;position:relative!important;overflow:hidden!important}
#how .step-modern.one{background:linear-gradient(145deg,#fff7f9 0%,#fff 72%)!important}
#how .step-modern.two{background:linear-gradient(145deg,#f4f9ff 0%,#fff 72%)!important}
#how .step-modern.three{background:linear-gradient(145deg,#f3fff7 0%,#fff 72%)!important}
#how .step-modern-num{width:56px!important;height:56px!important;border-radius:50%!important;font-size:22px!important;font-weight:950!important;margin:0!important;position:relative!important;z-index:2!important}
#how .step-modern-visual{width:96px!important;height:96px!important;right:28px!important;top:28px!important;opacity:.96!important}
#how .step-modern-visual svg{stroke-width:3.2!important}
#how .step-modern h4{position:absolute!important;left:28px!important;right:28px!important;bottom:66px!important;margin:0!important;font-size:27px!important;line-height:.98!important;font-weight:950!important;letter-spacing:-.045em!important;color:#11161e!important;max-width:220px!important}
#how .step-modern p{position:absolute!important;left:28px!important;right:22px!important;bottom:24px!important;margin:0!important;font-size:16px!important;line-height:1.22!important;color:#808a98!important;max-width:260px!important}

@media(max-width:600px){
 #travelToolsShowcase{padding:12px 8px 8px!important}
 #travelToolsShowcase .travel-showcase-shell{padding:18px 12px 16px!important;border-radius:24px!important}
 #travelToolsShowcase .travel-showcase-shell::before{height:132px!important;background-position:58% center!important}
 #travelToolsShowcase .travel-showcase-shell::after{top:98px!important;height:56px!important}
 #travelToolsShowcase .travel-showcase-hero{min-height:84px!important}
 #travelToolsShowcase .travel-showcase-hero h2{font-size:26px!important}
 #travelToolsShowcase .travel-showcase-hero p{font-size:11px!important}
 #travelToolsShowcase .travel-tool-tabs{gap:7px!important;margin-bottom:10px!important}
 #travelToolsShowcase .travel-tool-tab{min-height:92px!important;padding:10px 4px!important;border-radius:19px!important}
 #travelToolsShowcase .travel-tool-tab>span:last-child{font-size:9.2px!important;max-width:76px!important}
 #travelToolsShowcase .tab-icon{width:44px!important;height:44px!important;border-radius:14px!important}
 #travelToolsShowcase .tab-icon svg{width:24px!important;height:24px!important}
 #travelToolsShowcase .inline-tool-panel{padding:11px!important;border-radius:20px!important}
 #travelToolsShowcase .inline-tool-title h3{font-size:16px!important}
 #travelToolsShowcase .inline-tool-title p{font-size:9.4px!important;max-width:150px!important}
 #travelToolsShowcase .inline-tool-icon{width:44px!important;height:44px!important;border-radius:14px!important}
 #travelToolsShowcase .inline-tool-icon svg{width:24px!important;height:24px!important}
 #travelToolsShowcase .inline-field,#travelToolsShowcase .inline-toggle-card{min-height:66px!important;border-radius:17px!important;padding:9px 10px!important}
 #travelToolsShowcase #inlineCostBtn{height:56px!important;font-size:12px!important;border-radius:16px!important}
 #how.steps-modern{padding:18px 8px 8px!important}
 #how .steps-modern-head{margin-bottom:10px!important;gap:8px!important}
 #how .steps-modern-head h2{font-size:25px!important}
 #how .steps-modern-head p{font-size:10px!important;margin-top:5px!important}
 #how .steps-modern-head a{font-size:10px!important}
 #how .steps-modern-grid{gap:7px!important}
 #how .step-modern{min-height:184px!important;padding:14px 12px 12px!important;border-radius:20px!important}
 #how .step-modern-num{width:34px!important;height:34px!important;font-size:14px!important}
 #how .step-modern-visual{width:56px!important;height:56px!important;right:8px!important;top:10px!important}
 #how .step-modern h4{left:12px!important;right:8px!important;bottom:51px!important;font-size:14px!important;max-width:105px!important}
 #how .step-modern p{left:12px!important;right:8px!important;bottom:14px!important;font-size:9px!important;line-height:1.25!important;max-width:110px!important}
}


/* ===== V11 STRICT REFERENCE MATCH - FINAL OVERRIDES ===== */
#travelToolsShowcase{
  max-width:1040px!important;
  margin:28px auto 0!important;
  padding:0 14px 8px!important;
}
#travelToolsShowcase .travel-showcase-shell{
  position:relative!important;
  overflow:hidden!important;
  padding:26px 26px 28px!important;
  border:1px solid #e1e7ef!important;
  border-radius:30px!important;
  background:#f7f9fd!important;
  box-shadow:0 18px 48px rgba(26,39,58,.055)!important;
}
/* real photo band behind the Travel tools heading */
#travelToolsShowcase .travel-showcase-shell::before{
  display:block!important;
  content:""!important;
  position:absolute!important;
  inset:0 0 auto 0!important;
  width:100%!important;
  height:205px!important;
  border-radius:30px 30px 0 0!important;
  opacity:.88!important;
  background:
    linear-gradient(90deg,rgba(247,249,253,.99) 0%,rgba(247,249,253,.90) 28%,rgba(247,249,253,.40) 58%,rgba(247,249,253,.08) 100%),
    linear-gradient(180deg,rgba(247,249,253,0) 0%,rgba(247,249,253,.10) 52%,#f7f9fd 100%),
    url('https://upload.wikimedia.org/wikipedia/commons/9/9e/Chureito_Pagoda_and_Mount_Fuji.jpg') center 47%/cover no-repeat!important;
  z-index:0!important;
  pointer-events:none!important;
}
#travelToolsShowcase .travel-showcase-shell::after{
  display:block!important;
  content:""!important;
  position:absolute!important;
  left:0!important;right:0!important;top:145px!important;height:90px!important;
  background:linear-gradient(180deg,rgba(247,249,253,0),#f7f9fd 88%)!important;
  z-index:0!important;
  pointer-events:none!important;
}
#travelToolsShowcase .travel-showcase-hero{
  position:relative!important;
  z-index:2!important;
  min-height:118px!important;
  display:block!important;
  margin:0!important;
}
#travelToolsShowcase .travel-showcase-hero h2{
  margin:0!important;
  font-size:38px!important;
  line-height:.98!important;
  letter-spacing:-.06em!important;
  font-weight:950!important;
  color:#0b1018!important;
}
#travelToolsShowcase .travel-showcase-hero p{
  margin:8px 0 0!important;
  font-size:17px!important;
  line-height:1.15!important;
  color:#858f9e!important;
  font-weight:500!important;
}
#travelToolsShowcase .travel-tool-tabs{
  position:relative!important;
  z-index:3!important;
  display:grid!important;
  grid-template-columns:repeat(4,minmax(0,1fr))!important;
  gap:14px!important;
  overflow:visible!important;
  margin:0 0 16px!important;
  padding:0!important;
}
#travelToolsShowcase .travel-tool-tab{
  min-width:0!important;
  min-height:122px!important;
  padding:17px 12px 14px!important;
  border-radius:24px!important;
  border:1px solid #e0e6ee!important;
  background:rgba(255,255,255,.94)!important;
  box-shadow:0 12px 28px rgba(24,36,53,.055)!important;
  display:flex!important;
  flex-direction:column!important;
  align-items:center!important;
  justify-content:center!important;
  gap:13px!important;
  text-align:center!important;
  color:#11161d!important;
}
#travelToolsShowcase .travel-tool-tab.active{
  border-color:#6ea9ff!important;
  box-shadow:0 0 0 2px rgba(92,158,255,.16),0 15px 30px rgba(39,88,154,.10)!important;
}
#travelToolsShowcase .travel-tool-tab>span:last-child{
  max-width:125px!important;
  font-size:14px!important;
  line-height:1.05!important;
  letter-spacing:-.025em!important;
  font-weight:900!important;
}
#travelToolsShowcase .tab-icon,
#travelToolsShowcase .inline-tool-icon{
  position:relative!important;
  width:58px!important;
  height:58px!important;
  min-width:58px!important;
  border-radius:18px!important;
  display:grid!important;
  place-items:center!important;
  color:#fff!important;
  border:1px solid rgba(255,255,255,.38)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.42),0 12px 22px rgba(31,45,78,.15)!important;
  overflow:hidden!important;
}
#travelToolsShowcase .tab-icon::before,
#travelToolsShowcase .inline-tool-icon::before{
  content:""!important;
  position:absolute!important;
  width:40px!important;height:24px!important;
  top:-4px!important;left:8px!important;
  border-radius:50%!important;
  background:rgba(255,255,255,.18)!important;
  filter:blur(3px)!important;
}
#travelToolsShowcase .tab-icon svg,
#travelToolsShowcase .inline-tool-icon svg{
  position:relative!important;
  z-index:2!important;
  width:31px!important;
  height:31px!important;
  stroke:#fff!important;
  stroke-width:2.35!important;
}
#travelToolsShowcase .tab-icon.cost,#travelToolsShowcase .inline-tool-icon.cost{background:linear-gradient(145deg,#68a7ff 0%,#4f6eff 100%)!important}
#travelToolsShowcase .tab-icon.advisor,#travelToolsShowcase .inline-tool-icon.advisor{background:linear-gradient(145deg,#be65ff 0%,#8551f8 100%)!important}
#travelToolsShowcase .tab-icon.advice,#travelToolsShowcase .inline-tool-icon.advice{background:linear-gradient(145deg,#40dfa8 0%,#27c98f 100%)!important}
#travelToolsShowcase .tab-icon.card,#travelToolsShowcase .inline-tool-icon.card{background:linear-gradient(145deg,#ff9977 0%,#ff665c 72%,#78403f 100%)!important}

#travelToolsShowcase .inline-tool-panel{
  position:relative!important;
  z-index:3!important;
  margin:0!important;
  padding:22px!important;
  border:1px solid #e1e6ee!important;
  border-radius:28px!important;
  background:rgba(255,255,255,.985)!important;
  box-shadow:0 16px 36px rgba(24,38,58,.06)!important;
}
#travelToolsShowcase .inline-tool-header{
  margin:0 0 16px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:14px!important;
}
#travelToolsShowcase .inline-tool-title{display:flex!important;align-items:center!important;gap:14px!important}
#travelToolsShowcase .inline-tool-title h3{
  margin:0!important;
  font-size:24px!important;
  line-height:1.02!important;
  letter-spacing:-.045em!important;
  font-weight:950!important;
}
#travelToolsShowcase .inline-tool-title p{
  margin:5px 0 0!important;
  font-size:14px!important;
  color:#8f98a5!important;
}
#travelToolsShowcase .inline-currency-select{
  height:48px!important;
  min-width:126px!important;
  padding:0 14px!important;
  border-radius:999px!important;
  border:1px solid #dde3eb!important;
  background:#fff!important;
  box-shadow:none!important;
}
#travelToolsShowcase .inline-currency-select select{font-size:13px!important;font-weight:900!important}
#travelToolsShowcase .inline-tool-grid{
  display:grid!important;
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:12px!important;
}
#travelToolsShowcase .inline-field,
#travelToolsShowcase .inline-toggle-card{
  min-height:78px!important;
  padding:11px 13px!important;
  border-radius:19px!important;
  border:1px solid #dfe5ed!important;
  background:linear-gradient(180deg,#fff,#fbfcfe)!important;
  box-shadow:inset 0 1px 0 #fff!important;
}
#travelToolsShowcase .inline-field>span{margin:0 0 7px!important;font-size:11px!important;color:#7d8795!important;font-weight:650!important}
#travelToolsShowcase .inline-field-row{gap:10px!important}
#travelToolsShowcase .inline-field-row i{
  width:36px!important;height:36px!important;border-radius:12px!important;
  display:grid!important;place-items:center!important;
  background:#f1f4f9!important;font-size:17px!important;
}
#travelToolsShowcase .inline-field input,
#travelToolsShowcase .inline-field select{height:28px!important;font-size:16px!important;font-weight:900!important;color:#171d26!important}

/* reference-style full-width CTA */
#travelToolsShowcase #inlineCostBtn{
  position:relative!important;
  overflow:hidden!important;
  width:100%!important;
  max-width:none!important;
  height:60px!important;
  margin:14px 0 0!important;
  border:0!important;
  border-radius:18px!important;
  color:#fff!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  gap:12px!important;
  padding:0 72px 0 24px!important;
  font-size:16px!important;
  font-weight:950!important;
  letter-spacing:-.02em!important;
  background:
    linear-gradient(90deg,rgba(4,13,28,.98) 0%,rgba(10,29,53,.95) 48%,rgba(71,125,193,.70) 100%),
    url('https://upload.wikimedia.org/wikipedia/commons/9/9e/Chureito_Pagoda_and_Mount_Fuji.jpg') center 45%/cover no-repeat!important;
  box-shadow:0 14px 28px rgba(21,47,80,.15)!important;
}
#travelToolsShowcase #inlineCostBtn::after{
  content:"✈"!important;
  position:absolute!important;
  right:22px!important;
  top:50%!important;
  transform:translateY(-50%) rotate(-10deg)!important;
  font-size:25px!important;
  color:rgba(255,255,255,.48)!important;
}
#travelToolsShowcase #inlineCostBtn strong{font-size:19px!important}

/* Trip card: no redundant title/header */
#travelToolsShowcase #inline-tool-card .inline-tool-header{display:none!important}
#travelToolsShowcase #inline-tool-card{padding:16px!important}
#travelToolsShowcase #inline-tool-card .trip-card-preview{margin:0!important;width:100%!important;min-height:430px!important;border-radius:28px!important}

/* BUY IN THREE STEPS */
#how.steps-modern{
  max-width:1040px!important;
  margin:0 auto!important;
  padding:24px 14px 10px!important;
}
#how .steps-modern-head{
  display:flex!important;
  flex-direction:row!important;
  align-items:flex-end!important;
  justify-content:space-between!important;
  gap:14px!important;
  margin:0 0 14px!important;
}
#how .steps-modern-head h2{
  margin:0!important;
  font-size:36px!important;
  line-height:1!important;
  letter-spacing:-.058em!important;
  font-weight:950!important;
  color:#0c1119!important;
}
#how .steps-modern-head p{margin:7px 0 0!important;font-size:16px!important;color:#929aa7!important}
#how .steps-modern-head a{font-size:14px!important;color:#5b98e6!important;font-weight:850!important;white-space:nowrap!important}
#how .steps-modern-grid{
  display:grid!important;
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:14px!important;
  overflow:visible!important;
  padding:0!important;
}
#how .step-modern{
  position:relative!important;
  overflow:hidden!important;
  min-height:224px!important;
  padding:20px 20px 18px!important;
  border-radius:26px!important;
  border:1px solid #e0e6ee!important;
  box-shadow:0 12px 28px rgba(24,38,58,.05)!important;
}
#how .step-modern.one{background:linear-gradient(145deg,#fff6f9 0%,#fff 76%)!important}
#how .step-modern.two{background:linear-gradient(145deg,#f4f9ff 0%,#fff 76%)!important}
#how .step-modern.three{background:linear-gradient(145deg,#f3fff7 0%,#fff 76%)!important}
#how .step-modern-num{
  width:42px!important;height:42px!important;margin:0!important;
  display:grid!important;place-items:center!important;border-radius:50%!important;
  font-size:17px!important;font-weight:950!important;position:relative!important;z-index:2!important;
}
#how .step-modern-visual{
  position:absolute!important;
  right:18px!important;top:18px!important;
  width:82px!important;height:82px!important;
  opacity:.96!important;
}
#how .step-modern h4{
  margin:84px 0 8px!important;
  max-width:175px!important;
  font-size:23px!important;
  line-height:.98!important;
  letter-spacing:-.048em!important;
  font-weight:950!important;
  color:#10151d!important;
}
#how .step-modern p{
  margin:0!important;
  max-width:200px!important;
  font-size:15px!important;
  line-height:1.38!important;
  color:#7f8997!important;
}
#how .step-modern.one .step-modern-visual svg{stroke:#ff8494!important}
#how .step-modern.two .step-modern-visual svg{stroke:#68a8ff!important}
#how .step-modern.three .step-modern-visual svg{stroke:#36c98e!important}

@media(max-width:700px){
  #travelToolsShowcase{margin-top:16px!important;padding:0 8px 6px!important}
  #travelToolsShowcase .travel-showcase-shell{padding:16px 12px 18px!important;border-radius:24px!important}
  #travelToolsShowcase .travel-showcase-shell::before{height:145px!important;border-radius:24px 24px 0 0!important;background-position:64% 47%!important}
  #travelToolsShowcase .travel-showcase-shell::after{top:104px!important;height:74px!important}
  #travelToolsShowcase .travel-showcase-hero{min-height:90px!important}
  #travelToolsShowcase .travel-showcase-hero h2{font-size:31px!important}
  #travelToolsShowcase .travel-showcase-hero p{font-size:12px!important;margin-top:5px!important}
  #travelToolsShowcase .travel-tool-tabs{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:7px!important;margin-bottom:10px!important}
  #travelToolsShowcase .travel-tool-tab{min-height:90px!important;padding:10px 4px 9px!important;border-radius:18px!important;gap:8px!important}
  #travelToolsShowcase .travel-tool-tab>span:last-child{max-width:70px!important;font-size:9px!important;line-height:1.05!important}
  #travelToolsShowcase .tab-icon,#travelToolsShowcase .inline-tool-icon{width:40px!important;height:40px!important;min-width:40px!important;border-radius:12px!important}
  #travelToolsShowcase .tab-icon svg,#travelToolsShowcase .inline-tool-icon svg{width:22px!important;height:22px!important}
  #travelToolsShowcase .inline-tool-panel{padding:12px!important;border-radius:22px!important}
  #travelToolsShowcase .inline-tool-header{margin-bottom:10px!important;gap:8px!important}
  #travelToolsShowcase .inline-tool-title{gap:9px!important}
  #travelToolsShowcase .inline-tool-title h3{font-size:16px!important}
  #travelToolsShowcase .inline-tool-title p{font-size:9px!important;margin-top:3px!important;max-width:150px!important}
  #travelToolsShowcase .inline-currency-select{height:38px!important;min-width:92px!important;padding:0 10px!important}
  #travelToolsShowcase .inline-currency-select select{font-size:10px!important}
  #travelToolsShowcase .inline-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
  #travelToolsShowcase .inline-field,#travelToolsShowcase .inline-toggle-card{min-height:65px!important;padding:9px 10px!important;border-radius:16px!important}
  #travelToolsShowcase .inline-field>span{font-size:8px!important;margin-bottom:5px!important}
  #travelToolsShowcase .inline-field-row{gap:7px!important}
  #travelToolsShowcase .inline-field-row i{width:28px!important;height:28px!important;border-radius:9px!important;font-size:13px!important}
  #travelToolsShowcase .inline-field input,#travelToolsShowcase .inline-field select{height:24px!important;font-size:12px!important}
  #travelToolsShowcase #inlineCostBtn{height:50px!important;margin-top:10px!important;border-radius:15px!important;padding:0 48px 0 14px!important;font-size:11px!important}
  #travelToolsShowcase #inlineCostBtn::after{right:15px!important;font-size:20px!important}
  #travelToolsShowcase #inline-tool-card .trip-card-preview{min-height:300px!important;border-radius:22px!important}

  #how.steps-modern{padding:17px 10px 8px!important}
  #how .steps-modern-head{margin-bottom:10px!important;align-items:flex-end!important}
  #how .steps-modern-head h2{font-size:24px!important}
  #how .steps-modern-head p{font-size:10px!important;margin-top:4px!important}
  #how .steps-modern-head a{font-size:10px!important}
  #how .steps-modern-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:7px!important}
  #how .step-modern{min-height:150px!important;padding:10px!important;border-radius:18px!important}
  #how .step-modern-num{width:28px!important;height:28px!important;font-size:12px!important}
  #how .step-modern-visual{right:7px!important;top:8px!important;width:43px!important;height:43px!important}
  #how .step-modern h4{margin:54px 0 6px!important;font-size:12px!important;line-height:1.02!important;max-width:92px!important}
  #how .step-modern p{font-size:8px!important;line-height:1.3!important;max-width:98px!important}
}


/* ===== V12 FINAL DESIGN PASS ===== */
:root{--livdar-ink:#0d1118;--livdar-muted:#8b94a3;--livdar-line:#dfe5ec;--livdar-soft:#f7f9fc;}

/* tidy the orphan View all button */
.products-footer{padding:14px 0 2px!important;display:flex!important;justify-content:flex-end!important;max-width:1040px!important;margin:0 auto!important}
.view-all-bottom{height:38px!important;padding:0 18px!important;border-radius:999px!important;border:1px solid #d7dde6!important;background:#fff!important;color:#242b36!important;font-size:12px!important;font-weight:800!important;box-shadow:0 8px 18px rgba(31,44,68,.05)!important}

/* Travel Tools shell */
#travelToolsShowcase{max-width:1040px!important;margin:22px auto 0!important;padding:0 14px 8px!important}
#travelToolsShowcase .travel-showcase-shell{position:relative!important;overflow:hidden!important;padding:26px 26px 24px!important;border-radius:28px!important;border:1px solid #dde5ee!important;background:#f8faff!important;box-shadow:0 18px 42px rgba(31,45,66,.07)!important}
#travelToolsShowcase .travel-showcase-shell::before{content:""!important;position:absolute!important;inset:0 0 auto 0!important;height:178px!important;background-image:linear-gradient(90deg,rgba(248,250,255,.99) 0%,rgba(248,250,255,.86) 33%,rgba(248,250,255,.28) 66%,rgba(248,250,255,.02) 100%),url("data:image/jpeg;base64,")!important;background-size:cover!important;background-position:center!important;background-repeat:no-repeat!important;opacity:1!important;z-index:0!important;pointer-events:none!important}
#travelToolsShowcase .travel-showcase-shell::after{content:""!important;position:absolute!important;left:0!important;right:0!important;top:126px!important;height:92px!important;background:linear-gradient(180deg,rgba(248,250,255,0),#f8faff 78%)!important;z-index:0!important;pointer-events:none!important}
#travelToolsShowcase .travel-showcase-hero{position:relative!important;z-index:2!important;min-height:108px!important;margin:0!important;padding:0!important}
#travelToolsShowcase .travel-showcase-hero h2{margin:0!important;font-size:34px!important;line-height:.98!important;letter-spacing:-.055em!important;font-weight:900!important;color:var(--livdar-ink)!important}
#travelToolsShowcase .travel-showcase-hero p{margin:7px 0 0!important;font-size:15px!important;line-height:1.25!important;color:#87919f!important}

/* Tool selector cards - reference proportions */
#travelToolsShowcase .travel-tool-tabs{position:relative!important;z-index:3!important;display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:12px!important;margin:0 0 16px!important;padding:0!important;overflow:visible!important}
#travelToolsShowcase .travel-tool-tab{min-width:0!important;min-height:128px!important;padding:15px 10px 14px!important;border-radius:22px!important;border:1px solid #e0e6ee!important;background:rgba(255,255,255,.96)!important;box-shadow:0 12px 28px rgba(35,50,71,.06),inset 0 1px 0 #fff!important;display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:12px!important;text-align:center!important;transition:.18s ease!important}
#travelToolsShowcase .travel-tool-tab:hover{transform:translateY(-1px)!important;box-shadow:0 16px 34px rgba(35,50,71,.09)!important}
#travelToolsShowcase .travel-tool-tab:active{transform:scale(.985)!important}
#travelToolsShowcase .travel-tool-tab.active{border-color:#69a8ff!important;box-shadow:0 0 0 2px rgba(91,157,247,.14),0 14px 34px rgba(48,90,145,.09)!important;background:#fff!important}
#travelToolsShowcase .travel-tool-tab>span:last-child{font-size:13px!important;line-height:1.08!important;font-weight:800!important;letter-spacing:-.02em!important;color:#171c24!important;max-width:118px!important}
#travelToolsShowcase .tab-icon,#travelToolsShowcase .inline-tool-icon{width:56px!important;height:56px!important;border-radius:18px!important;display:grid!important;place-items:center!important;color:#fff!important;position:relative!important;overflow:hidden!important;box-shadow:0 12px 24px rgba(45,62,90,.18),inset 0 1px 0 rgba(255,255,255,.38)!important}
#travelToolsShowcase .tab-icon::before,#travelToolsShowcase .inline-tool-icon::before{content:""!important;position:absolute!important;inset:0!important;background:radial-gradient(circle at 30% 15%,rgba(255,255,255,.42),transparent 38%),linear-gradient(180deg,rgba(255,255,255,.10),rgba(255,255,255,0))!important;pointer-events:none!important}
#travelToolsShowcase .tab-icon svg,#travelToolsShowcase .inline-tool-icon svg{width:30px!important;height:30px!important;position:relative!important;z-index:1!important;stroke-width:2.8!important}
#travelToolsShowcase .tab-icon.cost,#travelToolsShowcase .inline-tool-icon.cost{background:linear-gradient(145deg,#72a9ff 0%,#5679ff 100%)!important}
#travelToolsShowcase .tab-icon.advisor,#travelToolsShowcase .inline-tool-icon.advisor{background:linear-gradient(145deg,#b469ff 0%,#914ef3 100%)!important}
#travelToolsShowcase .tab-icon.advice,#travelToolsShowcase .inline-tool-icon.advice{background:linear-gradient(145deg,#52dfb4 0%,#27c98f 100%)!important}
#travelToolsShowcase .tab-icon.card,#travelToolsShowcase .inline-tool-icon.card{background:linear-gradient(145deg,#ff927d 0%,#ff6e5e 100%)!important}

/* active tool panel */
#travelToolsShowcase .inline-tool-panel{position:relative!important;z-index:3!important;margin:0!important;padding:18px!important;border-radius:24px!important;border:1px solid #dfe6ee!important;background:rgba(255,255,255,.97)!important;box-shadow:0 14px 30px rgba(30,44,66,.05)!important}
#travelToolsShowcase .inline-tool-header{margin-bottom:14px!important;display:flex!important;align-items:flex-start!important;justify-content:space-between!important;gap:14px!important}
#travelToolsShowcase .inline-tool-title{gap:12px!important;align-items:center!important}
#travelToolsShowcase .inline-tool-title h3{font-size:20px!important;line-height:1!important;font-weight:850!important;letter-spacing:-.035em!important}
#travelToolsShowcase .inline-tool-title p{font-size:12px!important;line-height:1.25!important;color:#919aa7!important;margin-top:5px!important}
#travelToolsShowcase .inline-currency-select{height:46px!important;padding:0 15px!important;border-radius:999px!important;border:1px solid #dfe5ed!important;background:#fff!important;font-size:13px!important;box-shadow:none!important}
#travelToolsShowcase .inline-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important}
#travelToolsShowcase .inline-field,#travelToolsShowcase .inline-toggle-card{min-height:74px!important;border-radius:18px!important;padding:11px 13px!important;border:1px solid #dfe5ed!important;background:linear-gradient(180deg,#fff,#fbfcfe)!important;box-shadow:none!important}
#travelToolsShowcase .inline-field span{font-size:11px!important;margin-bottom:5px!important;color:#747e8c!important}
#travelToolsShowcase .inline-field-row i{width:36px!important;height:36px!important;border-radius:11px!important;font-size:17px!important;background:#f1f4f9!important}
#travelToolsShowcase .inline-field input,#travelToolsShowcase .inline-field select{font-size:15px!important;font-weight:800!important}

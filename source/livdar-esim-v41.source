#how .step-modern-num{
  position:absolute!important;left:16px!important;top:15px!important;width:38px!important;height:38px!important;margin:0!important;
  border-radius:50%!important;display:grid!important;place-items:center!important;font-size:17px!important;font-weight:950!important;z-index:3!important;
}
#how .step-modern.one .step-modern-num{background:#ffd6e0!important;color:#e64b73!important}
#how .step-modern.two .step-modern-num{background:#dbe9ff!important;color:#3974e8!important}
#how .step-modern.three .step-modern-num{background:#d7f6df!important;color:#149a4b!important}
#how .step-modern-visual{
  position:absolute!important;right:18px!important;top:17px!important;width:88px!important;height:88px!important;
  z-index:2!important;opacity:1!important;filter:drop-shadow(0 9px 16px rgba(34,50,73,.10))!important;
  background:none!important;
}
#how .step-modern-visual svg{display:block!important;width:100%!important;height:100%!important;overflow:visible!important}
#how .step-modern h4{
  position:absolute!important;left:16px!important;right:14px!important;bottom:53px!important;margin:0!important;
  font-size:19px!important;line-height:1.02!important;font-weight:950!important;letter-spacing:-.04em!important;color:#141922!important;max-width:195px!important;
}
#how .step-modern p{
  position:absolute!important;left:16px!important;right:14px!important;bottom:17px!important;margin:0!important;
  font-size:12.5px!important;line-height:1.28!important;color:#7d8795!important;max-width:205px!important;
}

@media(max-width:768px){
  .products-toolbar{margin:7px 9px 9px!important;gap:8px!important}
  .products-meta p{font-size:12px!important}
  #filterFab.filter-fab{width:36px!important;min-width:36px!important;height:36px!important;border-radius:11px!important}
  .sort-pill{height:36px!important;width:136px!important;max-width:136px!important;padding:0 9px!important;border-radius:11px!important;gap:5px!important}

  #travelToolsShowcase .inline-tool-icon svg{width:19px!important;height:19px!important}
  #travelToolsShowcase .inline-tool-title h3{font-size:14px!important}
  #travelToolsShowcase .inline-tool-title p{font-size:8.5px!important;max-width:150px!important}

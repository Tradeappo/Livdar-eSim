  #travelToolsShowcase .tab-icon{width:42px!important;height:42px!important;border-radius:14px!important}
  #travelToolsShowcase .tab-icon svg{width:23px!important;height:23px!important}
  #travelToolsShowcase .travel-tool-tab>span:last-child{font-size:9.6px!important;max-width:76px!important}

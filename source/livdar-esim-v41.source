#how .step-modern{
  position:relative!important;min-height:158px!important;padding:15px 14px 13px!important;border-radius:20px!important;
  border:1px solid #e2e7ee!important;box-shadow:0 7px 18px rgba(31,44,64,.035)!important;overflow:hidden!important;
  display:flex!important;flex-direction:column!important;justify-content:flex-end!important;
}
#how .step-modern.one{background:linear-gradient(180deg,#fff8fa 0%,#fff 100%)!important}
#how .step-modern.two{background:linear-gradient(180deg,#f7fbff 0%,#fff 100%)!important}
#how .step-modern.three{background:linear-gradient(180deg,#f5fff8 0%,#fff 100%)!important}
#how .step-modern-num{position:absolute!important;left:14px!important;top:13px!important;width:30px!important;height:30px!important;margin:0!important;font-size:13px!important;font-weight:900!important}
#how .step-modern-visual{position:absolute!important;right:14px!important;top:12px!important;width:60px!important;height:60px!important;opacity:1!important}
#how .step-modern-visual svg{width:100%!important;height:100%!important;stroke-width:3!important}
#how .step-modern.one .step-modern-visual svg{stroke:#ff8091!important;fill:rgba(255,128,145,.10)!important}
#how .step-modern.two .step-modern-visual svg{stroke:#67a7ff!important;fill:rgba(103,167,255,.09)!important}
#how .step-modern.three .step-modern-visual svg{stroke:#2fc98b!important;fill:rgba(47,201,139,.08)!important}
#how .step-modern h4{margin:0 0 6px!important;font-size:16px!important;line-height:1.05!important;letter-spacing:-.025em!important;font-weight:850!important;max-width:78%!important}
#how .step-modern p{margin:0!important;font-size:11px!important;line-height:1.35!important;color:#818a98!important;max-width:92%!important}

/* smaller integrated View all */
.products-footer{padding:10px 0 4px!important}
.view-all-bottom{height:34px!important;padding:0 16px!important;border-radius:999px!important;font-size:11px!important;font-weight:750!important;box-shadow:none!important}


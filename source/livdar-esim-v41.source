<article class="region-card"><img src="https://images.unsplash.com/photo-1508009603885-50cf7c579365?auto=format&amp;fit=crop&amp;w=700&amp;q=82"/><div class="region-copy"><strong data-i18n="regionSEA">Southeast Asia</strong><small data-i18n="popularRoutes">Popular routes</small></div></article>
<article class="region-card"><img src="https://images.unsplash.com/photo-1501594907352-04cda38ebc29?auto=format&amp;fit=crop&amp;w=700&amp;q=82"/><div class="region-copy"><strong data-i18n="regionNorthAmerica">North America</strong><small data-i18n="usaCanadaMore">USA + Canada + more</small></div></article>

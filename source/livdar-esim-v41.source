#travelToolsShowcase .travel-showcase-hero p{margin:7px 0 0!important;font-size:13px!important;color:#7f8998!important;font-weight:500!important}

/* 4 launcher cards */
#travelToolsShowcase .travel-tool-tabs{position:relative!important;z-index:3!important;display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:10px!important;margin:4px 0 14px!important;padding:0!important;overflow:visible!important}
#travelToolsShowcase .travel-tool-tab{
  min-width:0!important;min-height:108px!important;padding:12px 8px!important;border-radius:22px!important;
  display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:10px!important;
  border:1px solid rgba(221,227,235,.98)!important;background:rgba(255,255,255,.94)!important;
  box-shadow:0 8px 22px rgba(24,40,63,.05),inset 0 1px 0 rgba(255,255,255,.98)!important;
  text-align:center!important;transition:.18s ease!important;
}
#travelToolsShowcase .travel-tool-tab:hover{transform:translateY(-1px)!important;box-shadow:0 12px 26px rgba(24,40,63,.075)!important}
#travelToolsShowcase .travel-tool-tab.active{border-color:#8db9ff!important;box-shadow:0 0 0 2px rgba(101,157,255,.10),0 10px 24px rgba(36,87,154,.08)!important;background:#fff!important}
#travelToolsShowcase .travel-tool-tab .tab-icon{
  width:48px!important;height:48px!important;border-radius:16px!important;display:grid!important;place-items:center!important;margin:0!important;
  color:#fff!important;box-shadow:0 10px 18px rgba(35,54,91,.15),inset 0 1px 0 rgba(255,255,255,.42)!important;position:relative!important;overflow:hidden!important;
}
#travelToolsShowcase .travel-tool-tab .tab-icon::after{content:"";position:absolute;inset:1px 1px auto 1px;height:46%;border-radius:15px 15px 50% 50%;background:linear-gradient(180deg,rgba(255,255,255,.35),rgba(255,255,255,0));pointer-events:none}
#travelToolsShowcase .travel-tool-tab .tab-icon svg{width:25px!important;height:25px!important;position:relative!important;z-index:1!important}
#travelToolsShowcase .tab-icon.cost{background:linear-gradient(145deg,#70a0ff 0%,#4f75ff 72%)!important}
#travelToolsShowcase .tab-icon.advisor{background:linear-gradient(145deg,#bf70ff 0%,#8d4df8 72%)!important}
#travelToolsShowcase .tab-icon.advice{background:linear-gradient(145deg,#5de0b0 0%,#20c995 72%)!important}
#travelToolsShowcase .tab-icon.card{background:linear-gradient(145deg,#ff9f8d 0%,#ff725f 58%,#7f2421 100%)!important}
#travelToolsShowcase .tool-label-short{font-size:12px!important;line-height:1.08!important;font-weight:850!important;letter-spacing:-.02em!important;color:#171d26!important;max-width:92px!important}

/* Main active tool panel */
#travelToolsShowcase .inline-tool-panel{position:relative!important;z-index:2!important;margin:0!important;padding:16px!important;border:1px solid #e2e7ee!important;border-radius:24px!important;background:rgba(255,255,255,.965)!important;box-shadow:0 10px 24px rgba(24,40,63,.045)!important}
#travelToolsShowcase .inline-tool-header{margin:0 0 13px!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important}
#travelToolsShowcase .inline-tool-title{display:flex!important;align-items:center!important;gap:11px!important}
#travelToolsShowcase .inline-tool-icon{width:42px!important;height:42px!important;border-radius:13px!important;display:grid!important;place-items:center!important;color:#fff!important;box-shadow:0 8px 16px rgba(32,52,85,.12)!important;flex:0 0 auto!important}
#travelToolsShowcase .inline-tool-icon svg{width:23px!important;height:23px!important}
#travelToolsShowcase .inline-tool-title h3{font-size:17px!important;line-height:1.02!important;letter-spacing:-.035em!important;margin:0!important;font-weight:900!important;color:#151b24!important}
#travelToolsShowcase .inline-tool-title p{font-size:10.5px!important;line-height:1.3!important;margin:4px 0 0!important;color:#8b94a1!important}
#travelToolsShowcase .inline-currency-select{height:40px!important;min-width:112px!important;padding:0 12px!important;border-radius:999px!important;border:1px solid #e1e6ed!important;background:#fff!important;font-size:11px!important;gap:6px!important;box-shadow:none!important}
#travelToolsShowcase .inline-currency-select select{font-size:11px!important;font-weight:800!important}
#travelToolsShowcase .inline-tool-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:9px!important}
#travelToolsShowcase .inline-field,#travelToolsShowcase .inline-toggle-card{min-height:66px!important;padding:10px 11px!important;border-radius:17px!important;border:1px solid #e3e7ed!important;background:#fbfcfe!important;box-shadow:none!important}
#travelToolsShowcase .inline-field>span{font-size:9.5px!important;margin:0 0 4px!important;color:#7f8895!important;font-weight:650!important}
#travelToolsShowcase .inline-field-row{gap:9px!important}
#travelToolsShowcase .inline-field-row i{width:30px!important;height:30px!important;border-radius:10px!important;font-size:14px!important;background:#f0f4f9!important}
#travelToolsShowcase .inline-field input,#travelToolsShowcase .inline-field select{height:25px!important;font-size:14px!important;font-weight:850!important}
#travelToolsShowcase #inlineCostBtn{
  width:100%!important;max-width:none!important;height:48px!important;margin:11px 0 0!important;border-radius:14px!important;border:0!important;
  display:flex!important;align-items:center!important;justify-content:center!important;gap:12px!important;padding:0 56px 0 20px!important;
  color:#fff!important;font-size:13px!important;font-weight:900!important;letter-spacing:-.02em!important;overflow:hidden!important;position:relative!important;
  background:linear-gradient(90deg,rgba(5,14,29,.98) 0%,rgba(14,39,70,.96) 52%,rgba(73,133,204,.76) 100%),url("data:image/jpeg;base64,") center 57%/cover no-repeat!important;
  box-shadow:0 10px 22px rgba(17,43,77,.12)!important;
}
#travelToolsShowcase #inlineCostBtn::after{content:"✈"!important;position:absolute!important;right:16px!important;top:50%!important;transform:translateY(-50%) rotate(-11deg)!important;color:rgba(255,255,255,.58)!important;font-size:19px!important}

/* BUY IN THREE STEPS - compact polished cards */
#how.steps-modern{max-width:1040px!important;margin:0 auto!important;padding:24px 14px 12px!important}
#how .steps-modern-head{display:flex!important;flex-direction:row!important;align-items:flex-end!important;justify-content:space-between!important;gap:12px!important;margin:0 0 12px!important}
#how .steps-modern-head h2{margin:0!important;font-size:28px!important;line-height:1!important;letter-spacing:-.05em!important;font-weight:950!important;color:#111722!important}
#how .steps-modern-head p{margin:5px 0 0!important;font-size:12px!important;color:#8d96a4!important}
#how .steps-modern-head a{font-size:11px!important;color:#5b96e5!important;font-weight:800!important;white-space:nowrap!important}
#how .steps-modern-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:10px!important;padding:0!important;overflow:visible!important}
#how .step-modern{position:relative!important;overflow:hidden!important;min-height:158px!important;padding:14px!important;border-radius:22px!important;border:1px solid #e2e7ee!important;box-shadow:0 8px 20px rgba(24,40,63,.035)!important}
#how .step-modern.one{background:linear-gradient(145deg,#fff7fa 0%,#fff 74%)!important}
#how .step-modern.two{background:linear-gradient(145deg,#f6faff 0%,#fff 74%)!important}
#how .step-modern.three{background:linear-gradient(145deg,#f4fff7 0%,#fff 74%)!important}
#how .step-modern-num{width:32px!important;height:32px!important;margin:0!important;border-radius:50%!important;display:grid!important;place-items:center!important;font-size:13px!important;font-weight:900!important;position:relative!important;z-index:2!important}
#how .step-modern-visual{position:absolute!important;right:12px!important;top:12px!important;width:52px!important;height:52px!important;opacity:.90!important}
#how .step-modern h4{margin:54px 0 5px!important;font-size:16px!important;line-height:1.02!important;letter-spacing:-.035em!important;font-weight:900!important;color:#141a23!important;max-width:135px!important}
#how .step-modern p{margin:0!important;font-size:10px!important;line-height:1.35!important;color:#7f8997!important;max-width:145px!important}

@media(max-width:700px){

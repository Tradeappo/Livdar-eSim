  display:grid !important;
  place-items:center !important;
  box-shadow:0 8px 18px rgba(38,57,92,.14), inset 0 1px 0 rgba(255,255,255,.38) !important;
  overflow:hidden !important;
}
#travelToolsShowcase .tab-icon::before{
  width:20px !important;
  height:10px !important;
  left:7px !important;

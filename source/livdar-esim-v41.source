.travel-tool-tabs{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:7px!important;margin:10px 0!important;position:relative!important;z-index:2!important}
.travel-tool-tab{min-width:0!important;min-height:88px!important;padding:10px 5px!important;border-radius:18px!important;display:flex!important;align-items:center!important;justify-content:center!important;text-align:center!important;gap:7px!important;background:#fff!important;border:1px solid #e3e7ee!important;box-shadow:none!important;font-size:9px!important;line-height:1.05!important;font-weight:850!important}
.travel-tool-tab.active{border-color:#9fc4ff!important;box-shadow:0 0 0 2px rgba(88,142,232,.10)!important}
.tab-icon{width:38px!important;height:38px!important;border-radius:12px!important;font-size:16px!important;box-shadow:none!important}
.inline-tool-panel{padding:12px!important;border-radius:20px!important;margin:8px 0 0!important;border:1px solid #e4e8ef!important;background:#fff!important;box-shadow:none!important}
.inline-tool-header{margin-bottom:9px!important;gap:8px!important;align-items:center!important}.inline-tool-title{gap:9px!important;min-width:0!important}.inline-tool-title .inline-tool-icon{width:38px!important;height:38px!important;border-radius:12px!important}.inline-tool-title h3{font-size:16px!important;white-space:normal!important}.inline-tool-title p{font-size:9.5px!important;line-height:1.2!important;white-space:normal!important;max-width:175px!important}.inline-currency-select{height:38px!important;padding:0 9px!important;font-size:11px!important;min-width:92px!important}
.inline-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important}.inline-tool-grid.single{grid-template-columns:1fr!important}.inline-field,.inline-toggle-card{min-height:64px!important;border-radius:17px!important;padding:9px 10px!important}.inline-field span{font-size:9.5px!important;margin-bottom:4px!important}.inline-field-row{gap:7px!important}.inline-field-row i{width:28px!important;height:28px!important;border-radius:9px!important;font-size:14px!important}.inline-field input,.inline-field select{font-size:13px!important}.inline-toggle-card strong{font-size:11px!important}.inline-toggle-card small{font-size:8.5px!important}.switch{width:48px!important;height:28px!important}.switch i::after{width:22px!important;height:22px!important;left:3px!important;top:3px!important}.switch input:checked + i::after{transform:translateX(20px)!important}
.inline-primary-btn,.inline-secondary-btn{height:42px!important;border-radius:15px!important;padding:0 14px!important;font-size:11px!important;margin-top:9px!important}.inline-actions-row{gap:7px!important;margin-top:9px!important}.inline-actions-row .inline-primary-btn,.inline-actions-row .inline-secondary-btn{min-width:0!important;margin:0!important}
.inline-result-card{margin-top:9px!important;padding:11px!important;border-radius:17px!important}.inline-result-card h4{font-size:12px!important;margin:0 0 5px!important}.inline-result-card .big-result{font-size:27px!important;margin:3px 0 8px!important}.inline-result-card .mini-grid{gap:6px!important}.inline-result-card .mini-grid div{padding:8px!important;border-radius:12px!important}.inline-result-card .mini-grid small{font-size:8px!important}.inline-result-card .mini-grid strong{font-size:10px!important}
.inline-advice-list{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important;margin-top:9px!important}.inline-advice-item{min-height:108px!important;padding:11px!important;border-radius:17px!important;cursor:pointer!important}.inline-advice-item h5{font-size:12px!important;margin:0 0 5px!important}.inline-advice-item p{font-size:9.5px!important;line-height:1.4!important;display:-webkit-box!important;-webkit-line-clamp:4!important;-webkit-box-orient:vertical!important;overflow:hidden!important}.inline-advice-item.expanded p{-webkit-line-clamp:unset!important}
.social-card-controls{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;margin:2px 0 9px!important}.social-theme-pills,.social-format-pills{display:flex!important;gap:6px!important}.social-theme,.social-format{height:32px!important;border-radius:999px!important;border:1px solid #e1e6ed!important;background:#fff!important;padding:0 10px!important;font-size:12px!important;font-weight:800!important;color:#323a48!important}.social-theme{width:32px!important;padding:0!important}.social-theme.active,.social-format.active{border-color:#111827!important;background:#111827!important;color:#fff!important}
.trip-card-preview{aspect-ratio:1/1!important;min-height:0!important;height:auto!important;border-radius:22px!important;padding:20px!important;box-shadow:none!important;background:linear-gradient(145deg,#ff5d78 0%,#8a4cff 48%,#2ab8ff 100%)!important;isolation:isolate!important}.trip-card-preview.theme-sunset{background:linear-gradient(145deg,#ff7b54,#ff4d8d 50%,#7b61ff)!important}.trip-card-preview.theme-night{background:linear-gradient(145deg,#07101f,#162e53 55%,#59397c)!important}.trip-card-preview.story-format{aspect-ratio:9/16!important;max-height:520px!important}.trip-card-brand{font-size:10px!important;letter-spacing:.18em!important;text-transform:uppercase!important}.trip-card-kicker{font-size:12px!important;margin-top:18px!important}.trip-card-preview h4{font-size:42px!important;margin:5px 0 2px!important}.trip-fun-line{font-size:12px!important}.trip-stat-row{position:absolute!important;left:18px!important;right:18px!important;bottom:38px!important;gap:6px!important}.trip-stat-row span{padding:9px!important;border-radius:14px!important;backdrop-filter:blur(10px)!important}.trip-stat-row b{font-size:14px!important}.trip-stat-row small{font-size:0!important}.trip-stat-row span:nth-child(1) small::after{content:"📅"!important;font-size:10px!important}.trip-stat-row span:nth-child(2) small::after{content:"💸"!important;font-size:10px!important}.trip-stat-row span:nth-child(3) small::after{content:"📶"!important;font-size:10px!important}.trip-card-preview>p{display:none!important}.share-footer{font-size:8px!important;bottom:13px!important;left:18px!important;right:18px!important}.share-sticker{font-size:18px!important;border-radius:14px!important;padding:7px!important}.sticker-1{right:18px!important;top:18px!important}.sticker-2{right:72px!important;top:78px!important}.sticker-3{left:18px!important;bottom:88px!important}
.steps-modern{padding-top:16px!important}.steps-modern-head{margin-bottom:9px!important;align-items:end!important}.steps-modern-head h2{font-size:25px!important}.steps-modern-head p{font-size:10px!important}.steps-modern-head a{font-size:10px!important}.steps-modern-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:7px!important}.step-modern{min-height:136px!important;padding:11px!important;border-radius:18px!important}.step-modern-num{width:30px!important;height:30px!important;font-size:13px!important;margin-bottom:26px!important}.step-modern-emoji{font-size:30px!important;right:9px!important;top:9px!important}.step-modern h4{font-size:13px!important;line-height:1.08!important;margin-bottom:6px!important}.step-modern p{font-size:9px!important;line-height:1.3!important}
.collection-grid{max-height:330px!important}.collection{min-height:70px!important;padding:11px!important}.regional-track{gap:8px!important}.region-card{min-width:150px!important;height:170px!important;border-radius:18px!important}
@media(max-width:420px){.travel-showcase-shell{padding:12px!important}.travel-showcase-hero h2{font-size:24px!important}.travel-showcase-shell::before{width:125px!important;height:76px!important}.travel-tool-tab{min-height:82px!important;padding:8px 3px!important;font-size:8.5px!important}.inline-tool-panel{padding:10px!important}.inline-tool-title h3{font-size:15px!important}.inline-tool-title p{max-width:140px!important}.inline-currency-select{min-width:84px!important;font-size:10px!important}.trip-card-preview h4{font-size:36px!important}.steps-modern-grid{gap:6px!important}.step-modern{min-height:128px!important;padding:9px!important}.step-modern h4{font-size:12px!important}.step-modern p{font-size:8.3px!important}}


/* ================= V8 FINAL TRAVEL TOOLS UI ================= */
#travelToolsShowcase{padding:18px 10px 4px!important}
#travelToolsShowcase .travel-showcase-shell{
  position:relative!important;
  overflow:hidden!important;
  padding:18px!important;
  border-radius:28px!important;
  border:1px solid #e5e9f0!important;
  background:linear-gradient(180deg,#f8fbff 0%,#f6f8fc 100%)!important;
  box-shadow:0 18px 46px rgba(31,49,75,.08)!important;
}
#travelToolsShowcase .travel-showcase-shell::before{
  content:""!important;
  position:absolute!important;
  inset:0 0 auto 0!important;
  height:170px!important;
  border-radius:28px 28px 0 0!important;
  background:
    linear-gradient(90deg,rgba(248,251,255,.98) 0%,rgba(248,251,255,.88) 34%,rgba(248,251,255,.22) 72%,rgba(248,251,255,.08) 100%),
    url('https://images.unsplash.com/photo-1490806843957-31f4c9a91c65?auto=format&fit=crop&w=1600&q=88') center 42%/cover no-repeat!important;
  opacity:1!important;
  pointer-events:none!important;
}
#travelToolsShowcase .travel-showcase-shell::after{
  content:""!important;
  position:absolute!important;
  inset:0!important;
  pointer-events:none!important;
  background:linear-gradient(180deg,transparent 0 130px,rgba(247,249,253,.92) 178px,transparent 230px)!important;
}
#travelToolsShowcase .travel-showcase-hero{position:relative!important;z-index:2!important;min-height:104px!important;display:flex!important;align-items:flex-start!important;padding:0!important}
#travelToolsShowcase .travel-showcase-hero h2{margin:0!important;font-size:31px!important;line-height:1!important;letter-spacing:-.055em!important;color:#10141b!important;font-weight:900!important}
#travelToolsShowcase .travel-showcase-hero p{margin:7px 0 0!important;font-size:14px!important;color:#8992a0!important;font-weight:500!important}
#travelToolsShowcase .travel-tool-tabs{position:relative!important;z-index:3!important;display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:10px!important;margin:-2px 0 14px!important;padding:0!important;overflow:visible!important}
#travelToolsShowcase .travel-tool-tab{
  min-height:104px!important;
  padding:13px 8px 12px!important;
  border-radius:22px!important;
  background:rgba(255,255,255,.94)!important;
  border:1px solid rgba(223,228,236,.96)!important;
  box-shadow:0 12px 28px rgba(26,37,55,.07),inset 0 1px 0 rgba(255,255,255,.98)!important;
  display:flex!important;
  flex-direction:column!important;
  align-items:center!important;
  justify-content:flex-start!important;
  gap:10px!important;
  text-align:center!important;
  color:#161a22!important;
  transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease!important;
}
#travelToolsShowcase .travel-tool-tab:active{transform:scale(.98)!important}
#travelToolsShowcase .travel-tool-tab.active{border-color:#77aef8!important;box-shadow:0 0 0 2px rgba(92,155,242,.15),0 14px 32px rgba(41,89,149,.10)!important;background:#fff!important}
#travelToolsShowcase .travel-tool-tab>span:last-child{display:block!important;max-width:96px!important;font-size:11px!important;line-height:1.08!important;font-weight:850!important;letter-spacing:-.02em!important}
#travelToolsShowcase .tab-icon,#travelToolsShowcase .inline-tool-icon{
  width:48px!important;height:48px!important;border-radius:16px!important;display:grid!important;place-items:center!important;color:#fff!important;box-shadow:0 12px 24px rgba(44,70,115,.20)!important;flex:0 0 auto!important;
}
#travelToolsShowcase .tab-icon svg,#travelToolsShowcase .inline-tool-icon svg{width:25px!important;height:25px!important;fill:none!important;stroke:currentColor!important;stroke-width:1.9!important;stroke-linecap:round!important;stroke-linejoin:round!important}
#travelToolsShowcase .tab-icon.cost,#travelToolsShowcase .inline-tool-icon.cost{background:linear-gradient(145deg,#68a3ff,#4771fa)!important}
#travelToolsShowcase .tab-icon.advisor,#travelToolsShowcase .inline-tool-icon.advisor{background:linear-gradient(145deg,#b05cff,#8754f8)!important}
#travelToolsShowcase .tab-icon.advice,#travelToolsShowcase .inline-tool-icon.advice{background:linear-gradient(145deg,#35dba8,#25c68f)!important}
#travelToolsShowcase .tab-icon.card,#travelToolsShowcase .inline-tool-icon.card{background:linear-gradient(145deg,#ff9a76,#ff695f)!important}

/* tool panels */
#travelToolsShowcase .inline-tool-panel{position:relative!important;z-index:3!important;margin:0!important;padding:16px!important;border:1px solid #e3e8ef!important;border-radius:24px!important;background:rgba(255,255,255,.97)!important;box-shadow:0 14px 36px rgba(26,37,55,.06)!important}
#travelToolsShowcase .inline-tool-header{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;margin:0 0 14px!important}
#travelToolsShowcase .inline-tool-title{display:flex!important;align-items:center!important;gap:12px!important;min-width:0!important}
#travelToolsShowcase .inline-tool-title h3{margin:0!important;font-size:19px!important;line-height:1.05!important;letter-spacing:-.035em!important;font-weight:900!important;color:#151a22!important}
#travelToolsShowcase .inline-tool-title p{margin:4px 0 0!important;font-size:11px!important;line-height:1.25!important;color:#8e97a4!important;max-width:220px!important}
#travelToolsShowcase .inline-currency-select{height:44px!important;min-width:116px!important;padding:0 12px!important;border-radius:999px!important;border:1px solid #dfe4eb!important;background:#fff!important;box-shadow:none!important;font-size:12px!important}
#travelToolsShowcase .inline-currency-select select{font-size:12px!important;font-weight:800!important}
#travelToolsShowcase .inline-tool-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important}
#travelToolsShowcase .inline-field,#travelToolsShowcase .inline-toggle-card{min-height:72px!important;padding:10px 12px!important;border-radius:19px!important;border:1px solid #e0e5ec!important;background:linear-gradient(180deg,#fff,#fbfcfe)!important;box-shadow:inset 0 1px 0 #fff!important}
#travelToolsShowcase .inline-field>span{font-size:10px!important;line-height:1!important;color:#7e8794!important;margin:0 0 7px!important;font-weight:650!important}
#travelToolsShowcase .inline-field-row{gap:9px!important}
#travelToolsShowcase .inline-field-row i{width:32px!important;height:32px!important;border-radius:11px!important;background:#f1f4f9!important;font-size:15px!important}
#travelToolsShowcase .inline-field input,#travelToolsShowcase .inline-field select{font-size:15px!important;font-weight:850!important;color:#171c25!important;height:28px!important}

/* full-width premium CTA */
#travelToolsShowcase #inlineCostBtn{
  position:relative!important;
  overflow:hidden!important;
  width:100%!important;
  max-width:none!important;
  height:58px!important;
  margin:13px 0 0!important;
  border-radius:18px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  gap:10px!important;
  color:#fff!important;
  background:
    linear-gradient(90deg,rgba(5,14,28,.98) 0%,rgba(9,29,58,.98) 46%,rgba(75,132,205,.88) 100%),
    url('https://images.unsplash.com/photo-1483347756197-71ef80e95f73?auto=format&fit=crop&w=1200&q=80') center/cover!important;
  box-shadow:0 12px 28px rgba(21,48,84,.18)!important;
  font-size:14px!important;
  font-weight:900!important;
  letter-spacing:-.015em!important;
}
#travelToolsShowcase #inlineCostBtn::after{content:"✈";position:absolute;right:22px;top:9px;font-size:24px;color:rgba(255,255,255,.42);transform:rotate(-11deg)}
#travelToolsShowcase #inlineCostBtn strong{position:relative;z-index:2;font-size:18px!important;font-weight:600!important}
#travelToolsShowcase .inline-primary-btn:not(#inlineCostBtn){min-width:160px!important;height:48px!important;border-radius:16px!important;margin-top:12px!important;background:linear-gradient(90deg,#08111f,#386eb8)!important;font-size:12px!important;box-shadow:0 10px 22px rgba(15,44,83,.14)!important}

/* advisor toggles */
#travelToolsShowcase .inline-toggle-card{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:8px!important}
#travelToolsShowcase .inline-toggle-card strong{font-size:12px!important}.inline-toggle-card small{font-size:9px!important;line-height:1.22!important}
#travelToolsShowcase .switch{width:52px!important;height:30px!important}.switch i::after{width:24px!important;height:24px!important}.switch input:checked + i::after{transform:translateX(22px)!important}

/* advice cards */
#travelToolsShowcase .inline-advice-list{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:9px!important;margin-top:12px!important}
#travelToolsShowcase .inline-advice-item{min-height:105px!important;padding:13px!important;border-radius:19px!important;background:linear-gradient(180deg,#fff,#fbfcfe)!important;box-shadow:none!important}
#travelToolsShowcase .inline-advice-item h5{font-size:13px!important;margin:0 0 6px!important}.inline-advice-item p{font-size:10px!important;line-height:1.38!important;color:#818a96!important}

/* Travel card - card is the hero, remove redundant panel heading */
#travelToolsShowcase #inline-tool-card .inline-tool-header{display:none!important}
#travelToolsShowcase #inline-tool-card{padding:13px!important}
#travelToolsShowcase #inline-tool-card .trip-card-preview{
  width:100%!important;
  min-height:390px!important;
  margin:0!important;
  border-radius:28px!important;
  box-shadow:0 20px 40px rgba(55,58,145,.18)!important;
}
#travelToolsShowcase #inline-tool-card .inline-tool-grid{margin-top:12px!important}
#travelToolsShowcase #inline-tool-card .inline-actions-row{display:grid!important;grid-template-columns:1.2fr 1fr .72fr!important;gap:8px!important;margin-top:10px!important}
#travelToolsShowcase #inline-tool-card .inline-actions-row button{height:46px!important;margin:0!important;padding:0 10px!important;font-size:11px!important;border-radius:16px!important}
#travelToolsShowcase #inline-tool-card .inline-actions-row::after{content:"↗";display:grid;place-items:center;border:1px solid #dde3eb;border-radius:16px;background:#fff;color:#19212c;font-size:15px;font-weight:900}

/* Buy in three steps - premium mini cards */
#how.steps-modern{padding:18px 12px 2px!important}
#how .steps-modern-head{display:flex!important;align-items:flex-end!important;justify-content:space-between!important;gap:12px!important;margin:0 0 12px!important}
#how .steps-modern-head h2{margin:0!important;font-size:25px!important;line-height:1!important;letter-spacing:-.05em!important;color:#11151c!important}
#how .steps-modern-head p{margin:5px 0 0!important;font-size:11px!important;color:#969eaa!important}
#how .steps-modern-head a{font-size:11px!important;color:#5993df!important;font-weight:750!important;white-space:nowrap!important}
#how .steps-modern-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:9px!important;overflow:visible!important;padding:0!important}
#how .step-modern{position:relative!important;overflow:hidden!important;min-height:155px!important;padding:14px 12px!important;border-radius:22px!important;border:1px solid #e3e7ed!important;box-shadow:0 10px 26px rgba(27,40,59,.055)!important;background:#fff!important}
#how .step-modern.one{background:linear-gradient(145deg,#fff8fa 0%,#fff 70%)!important}
#how .step-modern.two{background:linear-gradient(145deg,#f7fbff 0%,#fff 70%)!important}
#how .step-modern.three{background:linear-gradient(145deg,#f5fff8 0%,#fff 70%)!important}
#how .step-modern-num{width:32px!important;height:32px!important;margin:0!important;border-radius:50%!important;display:grid!important;place-items:center!important;font-size:13px!important;font-weight:900!important;position:relative!important;z-index:2!important}
#how .step-modern.one .step-modern-num{background:#ffd9e2!important;color:#dc416c!important}
#how .step-modern.two .step-modern-num{background:#dce9ff!important;color:#3470df!important}
#how .step-modern.three .step-modern-num{background:#d8f6df!important;color:#149b4d!important}
#how .step-modern-visual{position:absolute!important;right:8px!important;top:8px!important;width:62px!important;height:62px!important;opacity:.92!important}
#how .step-modern-visual svg{width:100%!important;height:100%!important;fill:none!important;stroke-width:3!important;stroke-linecap:round!important;stroke-linejoin:round!important}
#how .step-modern-visual.pin svg{stroke:#ff7d8a!important}.step-modern-visual.pin .fold{stroke:#f2aab3!important;opacity:.8!important}
#how .step-modern-visual.plans svg{stroke:#66a6f7!important;fill:rgba(106,168,247,.07)!important}
#how .step-modern-visual.checkout svg{stroke:#31c887!important;fill:rgba(49,200,135,.06)!important}.step-modern-visual.checkout .check{stroke:#fff!important;stroke-width:4!important}.step-modern-visual.checkout circle{fill:#31c887!important;stroke:#31c887!important}
#how .step-modern h4{margin:54px 0 5px!important;font-size:14px!important;line-height:1.06!important;letter-spacing:-.035em!important;color:#141922!important;font-weight:900!important}
#how .step-modern p{margin:0!important;font-size:10px!important;line-height:1.34!important;color:#7f8895!important}

/* hide stale duplicate old section */
#howLegacy{display:none!important}

@media(max-width:420px){
 #travelToolsShowcase{padding-left:8px!important;padding-right:8px!important}
 #travelToolsShowcase .travel-showcase-shell{padding:15px 12px!important;border-radius:24px!important}
 #travelToolsShowcase .travel-showcase-shell::before{height:152px!important}
 #travelToolsShowcase .travel-showcase-hero{min-height:94px!important}
 #travelToolsShowcase .travel-showcase-hero h2{font-size:28px!important}
 #travelToolsShowcase .travel-showcase-hero p{font-size:12px!important}
 #travelToolsShowcase .travel-tool-tabs{gap:7px!important;margin-bottom:11px!important}
 #travelToolsShowcase .travel-tool-tab{min-height:92px!important;padding:10px 4px!important;border-radius:18px!important}
 #travelToolsShowcase .tab-icon{width:42px!important;height:42px!important;border-radius:14px!important}
 #travelToolsShowcase .travel-tool-tab>span:last-child{font-size:9.3px!important;max-width:78px!important}
 #travelToolsShowcase .inline-tool-panel{padding:11px!important;border-radius:19px!important}
 #travelToolsShowcase .inline-tool-title h3{font-size:17px!important}
 #travelToolsShowcase .inline-tool-title p{font-size:9px!important;max-width:150px!important}
 #travelToolsShowcase .inline-tool-icon{width:44px!important;height:44px!important;border-radius:14px!important}
 #travelToolsShowcase .inline-currency-select{height:40px!important;min-width:100px!important;padding:0 10px!important}
 #travelToolsShowcase .inline-tool-grid{gap:8px!important}
 #travelToolsShowcase .inline-field,#travelToolsShowcase .inline-toggle-card{min-height:66px!important;padding:9px 10px!important;border-radius:17px!important}
 #travelToolsShowcase .inline-field input,#travelToolsShowcase .inline-field select{font-size:14px!important}
 #travelToolsShowcase #inlineCostBtn{height:54px!important;border-radius:17px!important;font-size:12px!important}
 #travelToolsShowcase #inlineCostBtn::after{right:16px!important;font-size:20px!important}
 #travelToolsShowcase #inline-tool-card .trip-card-preview{min-height:365px!important;border-radius:24px!important}
 #how.steps-modern{padding-left:8px!important;padding-right:8px!important}
 #how .steps-modern-grid{gap:7px!important}
 #how .step-modern{min-height:145px!important;padding:12px 9px!important;border-radius:19px!important}
 #how .step-modern-visual{width:54px!important;height:54px!important;right:4px!important;top:7px!important}
 #how .step-modern h4{font-size:12.5px!important;margin-top:50px!important}
 #how .step-modern p{font-size:8.6px!important}
}


/* =========================================================
   V9 - REFERENCE-MATCH TRAVEL TOOLS / BUY STEPS UI
   Final overrides only. Existing functionality is untouched.
   ========================================================= */
#travelToolsShowcase{
  max-width:1060px!important;
  margin:0 auto!important;
  padding:18px 16px 8px!important;
}
#travelToolsShowcase .travel-showcase-shell{
  position:relative!important;
  overflow:hidden!important;
  padding:24px 24px 26px!important;
  border-radius:30px!important;
  border:1px solid #e2e7ef!important;
  background:linear-gradient(180deg,#f8fbff 0%,#f7f9fd 100%)!important;
  box-shadow:0 18px 42px rgba(24,38,60,.07)!important;
}
#travelToolsShowcase .travel-showcase-shell::before{
  content:""!important;
  position:absolute!important;
  inset:0 0 auto 0!important;
  height:210px!important;
  border-radius:30px 30px 0 0!important;
  background:
    linear-gradient(90deg,rgba(249,252,255,.98) 0%,rgba(249,252,255,.84) 30%,rgba(249,252,255,.24) 63%,rgba(249,252,255,.04) 100%),
    url('https://images.unsplash.com/photo-1490806843957-31f4c9a91c65?auto=format&fit=crop&w=1800&q=90') 72% 42%/cover no-repeat!important;
  opacity:1!important;
  pointer-events:none!important;
}
#travelToolsShowcase .travel-showcase-shell::after{
  content:""!important;
  position:absolute!important;
  inset:0!important;
  pointer-events:none!important;
  background:linear-gradient(180deg,transparent 0 155px,rgba(247,249,253,.80) 210px,transparent 290px)!important;
}
#travelToolsShowcase .travel-showcase-hero{
  position:relative!important;
  z-index:3!important;
  min-height:118px!important;
  display:flex!important;
  align-items:flex-start!important;
  padding:0!important;
}
#travelToolsShowcase .travel-showcase-hero h2{
  margin:0!important;
  font-size:38px!important;
  line-height:.98!important;
  letter-spacing:-.06em!important;
  font-weight:950!important;
  color:#0d1219!important;
}
#travelToolsShowcase .travel-showcase-hero p{
  margin:8px 0 0!important;
  font-size:17px!important;
  font-weight:500!important;
  color:#8992a0!important;
}

/* 4 premium tools - larger, cleaner, closer to reference */
#travelToolsShowcase .travel-tool-tabs{
  position:relative!important;
  z-index:4!important;
  display:grid!important;
  grid-template-columns:repeat(4,minmax(0,1fr))!important;
  gap:14px!important;
  margin:-6px 0 18px!important;
  padding:0!important;
}
#travelToolsShowcase .travel-tool-tab{
  min-height:126px!important;
  padding:18px 12px 15px!important;
  border-radius:24px!important;
  border:1px solid rgba(221,227,236,.98)!important;
  background:rgba(255,255,255,.96)!important;
  box-shadow:0 14px 32px rgba(24,38,60,.08),inset 0 1px 0 rgba(255,255,255,.98)!important;
  display:flex!important;
  flex-direction:column!important;
  align-items:center!important;
  justify-content:center!important;
  gap:13px!important;
  text-align:center!important;
  transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease!important;
}
#travelToolsShowcase .travel-tool-tab:hover{transform:translateY(-1px)!important}
#travelToolsShowcase .travel-tool-tab:active{transform:scale(.985)!important}
#travelToolsShowcase .travel-tool-tab.active{
  border-color:#68a8fb!important;
  box-shadow:0 0 0 2px rgba(79,153,244,.14),0 18px 36px rgba(33,87,151,.11)!important;
}
#travelToolsShowcase .travel-tool-tab>span:last-child{
  display:block!important;
  max-width:120px!important;
  font-size:14px!important;
  line-height:1.04!important;
  font-weight:900!important;
  letter-spacing:-.03em!important;
  color:#10151c!important;
}
#travelToolsShowcase .tab-icon,
#travelToolsShowcase .inline-tool-icon{
  position:relative!important;
  width:60px!important;
  height:60px!important;
  border-radius:20px!important;
  display:grid!important;
  place-items:center!important;
  color:#fff!important;
  flex:0 0 auto!important;
  border:1px solid rgba(255,255,255,.46)!important;
  box-shadow:0 13px 28px rgba(38,57,92,.23),inset 0 1px 0 rgba(255,255,255,.45)!important;
  overflow:hidden!important;
}
#travelToolsShowcase .tab-icon::before,
#travelToolsShowcase .inline-tool-icon::before{
  content:""!important;
  position:absolute!important;
  width:28px!important;
  height:18px!important;
  left:8px!important;
  top:5px!important;
  border-radius:50%!important;
  background:rgba(255,255,255,.20)!important;
  filter:blur(4px)!important;
  pointer-events:none!important;
}
#travelToolsShowcase .tab-icon svg,
#travelToolsShowcase .inline-tool-icon svg{
  position:relative!important;
  z-index:2!important;
  width:30px!important;
  height:30px!important;
  fill:none!important;
  stroke:#fff!important;
  stroke-width:2.2!important;
  stroke-linecap:round!important;
  stroke-linejoin:round!important;
}
#travelToolsShowcase .tab-icon.cost,#travelToolsShowcase .inline-tool-icon.cost{background:linear-gradient(145deg,#70a8ff 0%,#4d68ff 100%)!important}
#travelToolsShowcase .tab-icon.advisor,#travelToolsShowcase .inline-tool-icon.advisor{background:linear-gradient(145deg,#bc68ff 0%,#8751fa 100%)!important}
#travelToolsShowcase .tab-icon.advice,#travelToolsShowcase .inline-tool-icon.advice{background:linear-gradient(145deg,#44dda9 0%,#1fc98d 100%)!important}
#travelToolsShowcase .tab-icon.card,#travelToolsShowcase .inline-tool-icon.card{background:linear-gradient(145deg,#ff9a79 0%,#ff6c5f 100%)!important}

/* Main tool card */
#travelToolsShowcase .inline-tool-panel{
  position:relative!important;
  z-index:4!important;
  margin:0!important;
  padding:20px!important;
  border-radius:28px!important;
  border:1px solid #e1e6ee!important;
  background:rgba(255,255,255,.985)!important;
  box-shadow:0 16px 36px rgba(25,39,59,.07)!important;
}
#travelToolsShowcase .inline-tool-header{
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:16px!important;
  margin:0 0 16px!important;
}
#travelToolsShowcase .inline-tool-title{display:flex!important;align-items:center!important;gap:14px!important;min-width:0!important}
#travelToolsShowcase .inline-tool-title h3{
  margin:0!important;
  font-size:24px!important;
  line-height:1.02!important;
  letter-spacing:-.045em!important;
  font-weight:950!important;
  color:#11161d!important;
}
#travelToolsShowcase .inline-tool-title p{margin:5px 0 0!important;font-size:14px!important;line-height:1.25!important;color:#959daa!important;max-width:300px!important}
#travelToolsShowcase .inline-currency-select{
  height:50px!important;
  min-width:132px!important;
  padding:0 16px!important;
  border-radius:999px!important;
  border:1px solid #dce2ea!important;
  background:#fff!important;
  box-shadow:0 5px 15px rgba(22,31,44,.035)!important;
  font-size:14px!important;
}
#travelToolsShowcase .inline-currency-select select{font-size:14px!important;font-weight:850!important}

#travelToolsShowcase .inline-tool-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important}
#travelToolsShowcase .inline-field,#travelToolsShowcase .inline-toggle-card{
  min-height:82px!important;
  padding:12px 14px!important;
  border-radius:20px!important;
  border:1px solid #dfe5ed!important;
  background:linear-gradient(180deg,#fff 0%,#fbfcfe 100%)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.98)!important;
}
#travelToolsShowcase .inline-field>span{font-size:12px!important;line-height:1!important;color:#7f8895!important;margin:0 0 8px!important;font-weight:650!important}
#travelToolsShowcase .inline-field-row{gap:11px!important}
#travelToolsShowcase .inline-field-row i{width:38px!important;height:38px!important;border-radius:13px!important;background:#f1f4f9!important;font-size:18px!important}
#travelToolsShowcase .inline-field input,#travelToolsShowcase .inline-field select{font-size:17px!important;font-weight:900!important;color:#161c25!important;height:30px!important}

/* Long reference-style CTA */
#travelToolsShowcase #inlineCostBtn{

{
  "name": "livdar-esim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-media.mjs && node scripts/quality-gate.mjs && next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "qa": "node scripts/quality-gate.mjs",
    "dashcheck": "node scripts/dash-check.mjs",
    "similarity": "node scripts/similarity-check.mjs",
    "media": "node scripts/fetch-media.mjs",
    "baseline": "node scripts/seo-baseline.mjs > reports/seo-baseline.json",
    "regression": "node scripts/seo-regression.mjs",
    "media:adopt": "node scripts/adopt-media.mjs",
    "media:brief": "node scripts/image-brief.mjs",
    "taxonomy:report": "node scripts/taxonomy-report.mjs",
    "audit:scale": "node scripts/seo-scale-audit.mjs",
    "audit:discovery": "node scripts/discovery-audit.mjs",
    "gsc:report": "node scripts/gsc-report.mjs",
    "indexnow:dry-run": "node scripts/indexnow-submit.mjs",
    "indexnow:submit": "node scripts/indexnow-submit.mjs --submit",
    "publication": "node scripts/publication.mjs",
    "publication:check": "node scripts/publication.mjs check",

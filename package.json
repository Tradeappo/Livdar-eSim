  "dependencies": {
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
